.contact-us-banner {
	display: none;
}
ul {
	list-style: disc;
}

@media screen and (min-width: 1024px) {
.gsma-footer .inner-footer .column .social-buttons {
	display: flex;
}
}
.gsma-footer .inner-footer .column li.logo_list {
	display: flex;
}
.single_event .event_content .eventreglink {
	
	margin-bottom: 30px;
}
.resource-carousel_block .resource-carousel_rihgt-container .tns-nav button {
	background: #fff;
}

.event-carousel_block gsma-load-hidden .tns-nav button {
	background: #fff;
}
.posts_newslist .post .post_info .post_cats {
	padding-left: 0;
	left: 30%;
	
}
#algolia_discover_app label {
font-size: 100%;
}
@media screen and (max-width: 768px) {
  .posts_newslist .post .post_info .post_cats {
    left: unset;
  }
}
#mistt_content path {
	stroke: #ffffff;
}
.load-hidden{
	visibility: visible !important;
}
.app_download_links img {
	height: 45px;
}

.author_image{
	flex-shrink: 0;
}


