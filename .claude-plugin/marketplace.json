{
  "name": "ariya-skills",
  "owner": {
    "name": "Ariya Sarrafzadeh"
  },
  "metadata": {
    "description": "Third-party skill packs grouped one plugin per family, so each family nests under one name in the command list."
  },
  "plugins": [
    {
      "name": "charles-design",
      "description": "Make UI look designed and feel finished: unslop, polish, award-level craft, colour critique and App Store screenshots (Charles Liu, MIT)",
      "source": {
        "source": "github",
        "repo": "LemonFace0309/charles-skills"
      },
      "strict": false,
      "skills": [
        "./skills/design/charles-unslop",
        "./skills/design/charles-polish",
        "./skills/design/charles-unreasonable-craft",
        "./skills/design/charles-store-screenshots",
        "./skills/design/charles-color-analysis"
      ]
    },
    {
      "name": "charles-editing",
      "description": "Charles' reel pipeline: plan, script and edit talking-head reels, with explainer, pixel-art and 3D visuals timed to the words (Charles Liu, MIT)",
