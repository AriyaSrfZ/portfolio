---
import AuroraBackground from './react/AuroraBackground';

const skills = ['Data Pipelines', 'Network Design', 'System Architecture', 'API Platforms', 'Fintech Infra'];
---

<AuroraBackground client:load>
  <div class="max-w-3xl mx-auto text-center px-6 pt-24">
    <div class="relative w-32 h-32 mx-auto mb-8">
      <div class="absolute inset-0 rounded-full bg-linear-to-br from-(--color-aurora-1) to-(--color-aurora-2) blur-md opacity-60"></div>
      <img
        src={`${import.meta.env.BASE_URL}photos/ariya.jpg`}
        alt="Ariya Sarrafzadeh"
        class="relative w-32 h-32 rounded-full object-cover border-2 border-white/20"
      />
    </div>

    <div class="inline-flex items-center gap-2 glass rounded-full px-4 py-1.5 text-xs text-(--color-text-muted) mb-8 float">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      Open to consulting &amp; mentoring
    </div>

    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight leading-tight">
      Ariya Sarrafzadeh
    </h1>
    <p class="mt-4 text-xl sm:text-2xl text-gradient font-semibold">
      Data Engineering · Network Infrastructure · System Architecture
    </p>
    <p class="mt-6 text-(--color-text-muted) text-lg max-w-xl mx-auto">
      15+ years architecting high-availability fintech platforms in payments,
      fraud, and national-level compliance — now sharing it forward through
      diagrams, case studies, and direct conversations.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="#book" class="px-6 py-3 rounded-xl bg-linear-to-r from-(--color-aurora-1) to-(--color-aurora-2) font-medium shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transition-shadow">
        Book a call
      </a>
      <a href="#work" class="px-6 py-3 rounded-xl glass font-medium hover:bg-white/10 transition-colors">
        View case studies
      </a>
    </div>

    <div class="mt-14 flex flex-wrap justify-center gap-2">
      {skills.map((skill, i) => (
        <span class={`glass rounded-full px-3 py-1 text-xs text-(--color-text-muted) float ${i % 3 === 1 ? 'float-delay-1' : i % 3 === 2 ? 'float-delay-2' : ''}`}>
          {skill}
        </span>
      ))}
    </div>
  </div>
</AuroraBackground>
