---
const { locale = 'en' } = Astro.props;
const isFa = locale === 'fa';

const proofMatrix = isFa
  ? [
      { val: "۱۵+ سال", label: "سابقه مهندسی" },
      { val: "۱B+", label: "تراکنش پیامک سالانه" },
      { val: "۵۰K TPS", label: "اوج پردازش سیستم" },
      { val: "زیر ۱۵ms", label: "مهلت ارزیابی ریسک" },
      { val: "مغایرت صفر", label: "در تسویه روزانه" },
    ]
  : [
      { val: "15+ YEARS", label: "Engineering Experience" },
      { val: "1B+", label: "Messages Routed / Year" },
      { val: "50K TPS", label: "Peak Concurrent Throughput" },
      { val: "<15ms SLA", label: "Real-Time Fraud Risk Loop" },
      { val: "0.00% DRIFT", label: "Zero Financial Drift" },
    ];
---

<section class="relative pt-32 pb-16 lg:pt-48 lg:pb-24 overflow-hidden" dir={isFa ? "rtl" : "ltr"}>
  <div class="absolute inset-0 bg-[#05060a] z-0"></div>
  <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-[#06b6d4]/10 blur-[120px] rounded-full mix-blend-screen pointer-events-none"></div>
  
  <div class="max-w-[1400px] mx-auto px-6 sm:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Profile Image Card - Cleaned of all overlays -->
      <div class="lg:col-span-4 flex justify-center lg:justify-start">
        <div class="relative w-64 h-80 rounded-2xl p-1 bg-gradient-to-b from-white/10 to-white/5 border border-white/10 shadow-2xl overflow-hidden group">
          <div class="absolute -inset-8 bg-[radial-gradient(ellipse_at_top,rgba(6,182,212,0.15),transparent_50%)] blur-2xl z-0 transition-all duration-500 group-hover:opacity-70"></div>
          <img
            src={`${import.meta.env.BASE_URL}photos/ariya.jpg`}
            alt="Ariya Sarrafzadeh"
            class="relative z-10 w-full h-full object-cover rounded-xl filter grayscale contrast-125 transition-all duration-500 group-hover:grayscale-0"
          />
          <div class="absolute bottom-4 left-4 z-20 bg-[#0b1120]/80 backdrop-blur-md border border-white/10 px-3 py-1.5 rounded-lg">
            <div class="text-[10px] font-mono text-[#06b6d4] uppercase tracking-wider">{isFa ? 'تهران، ایران' : 'Tehran, IR'}</div>
          </div>
        </div>
      </div>

      <!-- Hero Typography -->
      <div class="lg:col-span-8 space-y-6 text-center lg:text-start">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.03] border border-white/10">
          <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974] animate-pulse"></span>
          <span class="text-[10px] font-mono text-[#e2c974] uppercase tracking-widest">{isFa ? 'مدیر ارشد محصول و معمار فنی' : 'Principal Systems Architect & Product Leader'}</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#f8fafc] tracking-tight leading-tight">
          {isFa ? 'معماری سیستمهای پرترافیک مالی، دفاتر کل دوطرفه و سوییچهای مخابراتی' : 'High-Throughput Financial Switches, Double-Entry Ledgers & Telecom Routing'}
        </h1>
        
        <p class="text-[#94a3b8] text-sm leading-relaxed max-w-2xl mx-auto lg:mx-0">
          {isFa 
            ? 'بیش از ۱۵ سال تجربه در مهندسی سوییچهای بانکی با دسترسی بالا، روتینگ چندگانه PSP، ماشینهای تخصیص دومرحلهای موجودی با مغایرت مالی صفر، و گیتویهای مخابراتی ملی با ظرفیت پردازش ۵۰,۰۰۰ تراکنش همزمان.' 
            : '15+ years engineering high-availability banking switches, sub-30ms ISO 8583 multi-PSP routing, two-phase balance reservation machines with zero financial drift, and national SMPP 3.4 telecom gateways handling 50,000 TPS burst capacity.'}
        </p>

        <!-- Tactical Technology Tags -->
        <div class="flex flex-wrap gap-2 justify-center lg:justify-start pt-2" dir="ltr">
          {['ISO 8583', 'IDEMPOTENCY', 'ACID LEDGERS', 'SMPP 3.4', 'SCYLLADB', 'RABBITMQ'].map(tag => (
            <span class="px-2.5 py-1 bg-[#0b1120] border border-white/10 rounded text-[9px] font-mono text-[#38bdf8]">{`[${tag}]`}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Restored 5-Column Grid for Stat Cards -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mt-12">
      {proofMatrix.map((item) => (
        <div class="bg-[#111827]/80 backdrop-blur-xl border border-white/10 rounded-xl p-4 flex flex-col justify-between transition-all duration-300 hover:border-[#06b6d4]/40 hover:-translate-y-1 hover:shadow-xl group">
          <div>
            <div class="w-8 h-8 rounded-lg bg-[#06b6d4]/10 border border-[#06b6d4]/20 flex items-center justify-center text-[#06b6d4] mb-3">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" dir="ltr">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="text-lg sm:text-xl font-bold font-mono text-[#f8fafc] tracking-tight">{item.val}</div>
          </div>
          <div class="text-[10px] text-[#94a3b8] mt-2 leading-snug group-hover:text-[#38bdf8] transition-colors">
            {item.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
