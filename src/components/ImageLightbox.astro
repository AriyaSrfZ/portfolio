---
// ImageLightbox.astro: Universal Zero-Dependency Dark Lightbox and Zoom Viewer
---

<div id="lightbox-modal" class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-200 bg-[#121614]/95 backdrop-blur-xl flex flex-col items-center justify-between p-4 sm:p-6" role="dialog" aria-modal="true" aria-label="Image Zoom Viewer">
  <!-- Top Bar -->
  <div class="w-full max-w-6xl flex items-center justify-between py-2 border-b border-[var(--border,#46504B)] text-xs font-mono text-[var(--text-secondary,#B5BDB6)] z-20">
    <div class="flex items-center gap-2 overflow-hidden">
      <span class="w-2 h-2 rounded-full bg-[var(--accent-primary,#8FB4AA)]"></span>
      <span id="lightbox-caption" class="truncate font-semibold text-[var(--text-primary,#F0EEE7)]">Architecture Schematic</span>
    </div>

    <div class="flex items-center gap-2">
      <button id="lightbox-zoom-btn" type="button" class="px-2.5 py-1 rounded bg-[var(--surface-elevated,#303936)] border border-[var(--border,#46504B)] text-[var(--text-primary,#F0EEE7)] hover:border-[var(--accent-primary,#8FB4AA)] transition-colors flex items-center gap-1.5 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
        <span id="lightbox-zoom-text">Zoom 1.5x</span>
      </button>

      <a id="lightbox-download-btn" href="#" target="_blank" download class="px-2.5 py-1 rounded bg-[var(--surface-elevated,#303936)] border border-[var(--border,#46504B)] text-[var(--text-primary,#F0EEE7)] hover:border-[var(--accent-primary,#8FB4AA)] transition-colors flex items-center gap-1.5 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        <span>Open Raw</span>
      </a>

      <button id="lightbox-close-btn" type="button" aria-label="Close Viewer" class="p-1 rounded bg-[var(--surface-elevated,#303936)] border border-[var(--border,#46504B)] text-[var(--text-primary,#F0EEE7)] hover:text-red-400 hover:border-red-400 transition-colors cursor-pointer flex items-center justify-center w-7 h-7">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <!-- Image Stage Area -->
  <div id="lightbox-stage" class="flex-1 w-full flex items-center justify-center overflow-auto p-2 sm:p-4 cursor-zoom-out select-none">
    <img 
      id="lightbox-img" 
      src="" 
      alt="" 
      class="max-w-[95vw] max-h-[84vh] w-auto h-auto object-contain rounded-xl shadow-2xl transition-transform duration-200 cursor-zoom-in"
    />
  </div>

  <!-- Bottom Hint -->
  <div class="text-[11px] font-mono text-[var(--text-muted,#7E8882)] py-1 flex items-center gap-4">
    <span>Click image to toggle 1.5x zoom</span>
    <span>•</span>
    <span>Press ESC or click backdrop to close</span>
  </div>
</div>

<style>
  /* Enable zoom cursor on all eligible article/dossier images */
  article img,
  main img,
  .diagram-frame img {
    cursor: zoom-in;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  article img:hover,
  .diagram-frame img:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.6);
  }
</style>

<script>
  function initLightbox() {
    const modal = document.getElementById('lightbox-modal');
    const stage = document.getElementById('lightbox-stage');
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const zoomBtn = document.getElementById('lightbox-zoom-btn');
    const zoomText = document.getElementById('lightbox-zoom-text');
    const downloadBtn = document.getElementById('lightbox-download-btn') as HTMLAnchorElement;

    if (!modal || !stage || !img || !caption || !closeBtn || !zoomBtn) return;

    let isZoomed = false;

    function openLightbox(src: string, altText: string) {
      img.src = src;
      img.alt = altText || 'Architecture Schematic';
      caption.textContent = altText || 'Architecture Schematic Inspection';
      downloadBtn.href = src;
      isZoomed = false;
      updateZoom();

      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        img.src = '';
        document.body.style.overflow = '';
      }, 200);
    }

    function updateZoom() {
      if (isZoomed) {
        img.classList.remove('max-w-[95vw]', 'max-h-[84vh]', 'cursor-zoom-in');
        img.classList.add('w-[160%]', 'max-w-none', 'cursor-zoom-out');
        zoomText.textContent = 'Reset (1x)';
      } else {
        img.classList.remove('w-[160%]', 'max-w-none', 'cursor-zoom-out');
        img.classList.add('max-w-[95vw]', 'max-h-[84vh]', 'cursor-zoom-in');
        zoomText.textContent = 'Zoom 1.5x';
      }
    }

    function toggleZoom(e?: Event) {
      if (e) e.stopPropagation();
      isZoomed = !isZoomed;
      updateZoom();
    }

    // Attach click listeners to all eligible content images
    const targetImages = document.querySelectorAll<HTMLImageElement>(
      'article img, main img, .diagram-frame img'
    );

    targetImages.forEach((targetImg) => {
      // Skip very small icons/avatars
      if (targetImg.width > 0 && targetImg.width < 60) return;
      if (targetImg.height > 0 && targetImg.height < 60) return;
      if (targetImg.classList.contains('no-zoom')) return;

      targetImg.addEventListener('click', (e) => {
        e.preventDefault();
        openLightbox(targetImg.currentSrc || targetImg.src, targetImg.alt);
      });
    });

    closeBtn.addEventListener('click', closeLightbox);
    zoomBtn.addEventListener('click', toggleZoom);
    img.addEventListener('click', toggleZoom);

    // Click on backdrop outside image closes
    stage.addEventListener('click', (e) => {
      if (e.target === stage) {
        closeLightbox();
      }
    });

    // Keyboard handlers
    window.addEventListener('keydown', (e) => {
      if (modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === '+' || e.key === '=') {
        if (!isZoomed) toggleZoom();
      } else if (e.key === '-' || e.key === '_') {
        if (isZoomed) toggleZoom();
      }
    });
  }

  // Initialize on initial page load and on Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightbox);
  } else {
    initLightbox();
  }
  document.addEventListener('astro:page-load', initLightbox);
</script>
