---
interface Props {
  locale?: 'en' | 'fa';
}

const { locale = 'en' } = Astro.props;
const isFa = locale === 'fa';
const CAL_LINK = 'ariya-sarrafzadeh/15min';
---

<div class="bg-[#1c1916]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 font-['IBM_Plex_Mono',monospace]">
  <div class="flex items-center gap-3 mb-2">
    <span class="text-xs text-[#c4562e] tracking-wider font-semibold">
      {isFa ? '۰۸ // تماس و جلسه فنی' : '08 // ARCHITECTURE REVIEW & CONTACT'}
    </span>
    <div class="h-px flex-1 bg-white/10"></div>
  </div>

  <h2 class="text-2xl font-bold text-[#e8e2d5] uppercase tracking-tight">
    {isFa ? 'بررسی معماری و جلسه فنی' : 'Architecture Review & Contact'}
  </h2>
  
  <p class="text-[#a8a196] text-xs sm:text-sm mt-2 mb-6 leading-relaxed">
    {isFa 
      ? 'انتخاب بازه زمانی برای ارزیابی معماری فنی، ممیزی پلتفرم یا بازبینی حالت‌های خرابی در سامانه‌های پرداخت، پیامک و خطوط داده.'
      : 'Select an operating window for technical architecture assessments, platform audits, or failure-mode reviews of payment, SMS, and data platforms.'}
  </p>

  <div class="bg-[#141210]/80 border border-white/10 rounded-xl p-3 sm:p-5 overflow-hidden">
    <div id="cal-inline" class="w-full min-h-[600px]"></div>
  </div>
</div>

<script define:vars={{ CAL_LINK }}>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "inline", { origin: "https://app.cal.com" });

  Cal("inline", {
    elementOrSelector: "#cal-inline",
    calLink: CAL_LINK,
    layout: "month_view",
    config: {
      theme: "dark"
    }
  });

  Cal("ui", {
    theme: "dark",
    styles: { 
      branding: { 
        brandColor: "#c4562e" 
      } 
    },
    hideEventTypeDetails: false,
    layout: "month_view"
  });
</script>