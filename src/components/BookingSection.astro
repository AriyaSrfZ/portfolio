---
interface Props {
  locale?: 'en' | 'fa';
}

const { locale = 'en' } = Astro.props;
const isFa = locale === 'fa';
const CAL_LINK = 'ariya-sarrafzadeh/15min';
---

<div class="bg-[#111827]/75 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 font-sans">
  <div class="flex items-center gap-3 mb-2">
    <span class="text-xs text-[#06b6d4] tracking-wider font-semibold">
      {isFa ? '۰۸ · جلسه بررسی معماری و تماس' : '08 · Architecture Review & Intake'}
    </span>
    <div class="h-px flex-1 bg-white/10"></div>
  </div>

  <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">
    {isFa ? 'بررسی معماری و جلسه فنی' : 'Architecture Review & Consultation'}
  </h2>
  
  <p class="text-[#94a3b8] text-xs sm:text-sm mt-2 mb-6 leading-relaxed">
    {isFa 
      ? 'انتخاب بازه زمانی برای ارزیابی معماری فنی، ممیزی پلتفرم یا بازبینی حالت‌های خرابی در سامانه‌های پرداخت، پیامک و خطوط داده.'
      : 'Select an operating window for technical architecture assessments, platform audits, or failure-mode reviews of payment, SMS, and data platforms.'}
  </p>

  <div class="bg-[#0b1120]/80 border border-white/10 rounded-xl p-3 sm:p-5 overflow-hidden">
    <div id="cal-inline" class="w-full min-h-[560px]"></div>
  </div>

  <div class="mt-6 pt-5 border-t border-white/10 flex flex-wrap gap-4 items-center justify-between text-xs">
    <div class="text-[#94a3b8]">
      {isFa ? 'ارتباط مستقیم با معمار سیستم:' : 'Direct communication channels:'}
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <a 
        href="mailto:ariasg2002@gmail.com" 
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-[#d4af37] to-[#e2c974] text-[#0b1120] font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-lg shadow-[#d4af37]/20 transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-[#e2c974]"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        <span>{isFa ? 'ارسال ایمیل مستقیم' : 'Email Directly'}</span>
      </a>
      <a 
        href="https://linkedin.com/in/ariya-sarrafzadeh" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white/[0.03] border border-white/10 text-[#f8fafc] font-bold text-xs uppercase tracking-wider hover:border-[#06b6d4] hover:text-[#06b6d4] hover:bg-white/[0.06] transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-[#06b6d4]"
      >
        <span>LinkedIn ↗</span>
      </a>
    </div>
  </div>
</div>

<script define:vars={{ CAL_LINK }}>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "inline", { origin: "https://app.cal.com" });

  Cal("inline", {
    elementOrSelector: "#cal-inline",
    calLink: CAL_LINK,
    layout: "month_view",
    config: {
      theme: "dark"
    }
  });

  Cal("ui", {
    theme: "dark",
    styles: { 
      branding: { 
        brandColor: "#06b6d4" 
      } 
    },
    hideEventTypeDetails: false,
    layout: "month_view"
  });
</script>