---
const CAL_LINK = 'ariya-sarrafzadeh/15min';
---

<div class="relative bg-[var(--rugged-bg-panel)] border border-[var(--rugged-olive-border)] p-6 sm:p-8 font-['IBM_Plex_Mono',monospace]">
  <!-- Corner Rivets -->
  <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[var(--rugged-bg-nav)] border border-[var(--rugged-olive-border)] pointer-events-none"></span>
  <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[var(--rugged-bg-nav)] border border-[var(--rugged-olive-border)] pointer-events-none"></span>
  <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[var(--rugged-bg-nav)] border border-[var(--rugged-olive-border)] pointer-events-none"></span>
  <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[var(--rugged-bg-nav)] border border-[var(--rugged-olive-border)] pointer-events-none"></span>

  <div class="flex items-center gap-3 mb-2">
    <span class="text-xs text-[var(--rugged-rust)] tracking-wider font-semibold">05 // ENGAGEMENT CHANNEL</span>
    <div class="h-px flex-1 bg-[var(--rugged-olive-border)]"></div>
  </div>

  <h2 class="text-2xl font-bold text-[var(--rugged-paper)] uppercase">
    Direct Engagement &amp; Consultation
  </h2>
  
  <p class="text-[var(--rugged-muted)] text-sm mt-2 mb-6 leading-relaxed">
    Select an operating window for technical architecture assessments, platform audits, or product strategy reviews.
  </p>

  <div class="relative bg-[var(--rugged-bg-nav)] border border-[var(--rugged-olive-border)] p-2 sm:p-4 shadow-inner">
    <div id="cal-inline" class="w-full min-h-[600px]"></div>
  </div>
</div>

<script define:vars={{ CAL_LINK }}>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "inline", { origin: "https://app.cal.com" });

  Cal("inline", {
    elementOrSelector: "#cal-inline",
    calLink: CAL_LINK,
    layout: "month_view",
    config: {
      theme: "dark"
    }
  });

  Cal("ui", {
    theme: "dark",
    styles: { 
      branding: { 
        brandColor: "#c4562e" 
      } 
    },
    hideEventTypeDetails: false,
    layout: "month_view"
  });
</script>