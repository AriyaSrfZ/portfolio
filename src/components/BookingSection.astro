---
const CAL_LINK = 'ariya-sarrafzadeh/15min';
---

<section id="book" class="relative z-10 max-w-4xl mx-auto px-6 py-24">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold mb-2">Book a Session</h2>
    <p class="text-(--color-text-muted)">
      Pick a time that works for you. 15-minute intro / product & architecture discussion.
    </p>
  </div>

  <div class="glass rounded-3xl p-4 sm:p-6 border border-white/10 overflow-hidden shadow-2xl">
    <div id="cal-inline" class="w-full min-h-[600px]"></div>
  </div>
</section>

<script define:vars={{ CAL_LINK }}>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "inline", { origin: "https://app.cal.com" });

  Cal("inline", {
    elementOrSelector: "#cal-inline",
    calLink: CAL_LINK,
    layout: "month_view",
    config: {
      theme: "dark"
    }
  });

  Cal("ui", {
    theme: "dark",
    styles: { branding: { brandColor: "#06b6d4" } },
    hideEventTypeDetails: false,
    layout: "month_view"
  });
</script>
