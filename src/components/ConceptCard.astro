---
interface Props {
  title: string;
  subtitle: string;
  leftColumnTitle: string;
  leftColumnItems: string[];
  rightColumnTitle: string;
  rightColumnItems: string[];
  oneLiner: string;
}

const { title, subtitle, leftColumnTitle, leftColumnItems, rightColumnTitle, rightColumnItems, oneLiner } = Astro.props;
---

<div class="concept-card rounded-2xl bg-white text-slate-900 p-8 max-w-xl mx-auto shadow-2xl shadow-black/40">
  <h3 class="text-2xl font-extrabold tracking-tight">{title}</h3>
  <p class="text-slate-500 mt-1 mb-6">{subtitle}</p>
  <div class="h-px bg-slate-200 mb-6"></div>

  <div class="grid sm:grid-cols-2 gap-6 mb-6">
    <div>
      <p class="text-xs font-bold tracking-wide text-slate-500 mb-2">{leftColumnTitle}</p>
      <ul class="space-y-1.5 text-sm text-slate-700">
        {leftColumnItems.map((item) => <li class="flex gap-2"><span class="text-slate-400">•</span>{item}</li>)}
      </ul>
    </div>
    <div>
      <p class="text-xs font-bold tracking-wide text-slate-500 mb-2">{rightColumnTitle}</p>
      <ul class="space-y-1.5 text-sm text-slate-700">
        {rightColumnItems.map((item) => <li class="flex gap-2"><span class="text-slate-400">•</span>{item}</li>)}
      </ul>
    </div>
  </div>

  <div class="rounded-xl bg-slate-900 text-white text-center font-bold py-3 px-4 text-sm tracking-wide">
    {oneLiner}
  </div>
</div>

<style>
  .concept-card {
    transition: transform 0.2s ease;
  }
  .concept-card:hover {
    transform: translateY(-4px);
  }
</style>
