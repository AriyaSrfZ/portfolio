---
interface Props {
  title: string;
  subtitle: string;
  leftColumnTitle: string;
  leftColumnItems: string[];
  rightColumnTitle: string;
  rightColumnItems: string[];
  oneLiner: string;
}

const { title, subtitle, leftColumnTitle, leftColumnItems, rightColumnTitle, rightColumnItems, oneLiner } = Astro.props;
---

<div class="concept-card rounded-2xl bg-[var(--surface-card)] backdrop-blur-xl border border-[var(--border)] text-[var(--text-primary)] p-8 max-w-xl mx-auto shadow-2xl transition-all duration-300 hover:-translate-y-1 hover:border-[var(--accent-primary)]">
  <h3 class="text-2xl font-extrabold tracking-tight text-[var(--text-primary)]">{title}</h3>
  <p class="text-[var(--text-secondary)] mt-1 mb-6 text-sm">{subtitle}</p>
  <div class="h-px bg-[var(--border)] mb-6"></div>

  <div class="grid sm:grid-cols-2 gap-6 mb-6">
    <div>
      <p class="text-xs font-bold tracking-wider text-[var(--accent-warm)] uppercase mb-2">{leftColumnTitle}</p>
      <ul class="space-y-1.5 text-xs text-[var(--text-secondary)]">
        {leftColumnItems.map((item) => <li class="flex gap-2"><span class="text-[var(--accent-primary)]">•</span>{item}</li>)}
      </ul>
    </div>
    <div>
      <p class="text-xs font-bold tracking-wider text-[var(--accent-warm)] uppercase mb-2">{rightColumnTitle}</p>
      <ul class="space-y-1.5 text-xs text-[var(--text-secondary)]">
        {rightColumnItems.map((item) => <li class="flex gap-2"><span class="text-[var(--accent-primary)]">•</span>{item}</li>)}
      </ul>
    </div>
  </div>

  <div class="rounded-xl bg-[var(--surface-sunken)] border border-[var(--border)] text-[var(--accent-primary)] text-center font-bold py-3 px-4 text-xs tracking-wide">
    {oneLiner}
  </div>
</div>
