---
interface Props {
  title: string;
  subtitle: string;
  leftColumnTitle: string;
  leftColumnItems: string[];
  rightColumnTitle: string;
  rightColumnItems: string[];
  oneLiner: string;
}

const { title, subtitle, leftColumnTitle, leftColumnItems, rightColumnTitle, rightColumnItems, oneLiner } = Astro.props;
---

<div class="concept-card rounded-2xl bg-[#111827]/75 backdrop-blur-xl border border-white/10 text-[#f8fafc] p-8 max-w-xl mx-auto shadow-2xl ring-1 ring-white/5 transition-all duration-300 hover:-translate-y-1 hover:border-white/20">
  <h3 class="text-2xl font-extrabold tracking-tight text-[#f8fafc]">{title}</h3>
  <p class="text-[#94a3b8] mt-1 mb-6 text-sm">{subtitle}</p>
  <div class="h-px bg-white/10 mb-6"></div>

  <div class="grid sm:grid-cols-2 gap-6 mb-6">
    <div>
      <p class="text-xs font-bold tracking-wider text-[#e2c974] uppercase mb-2">{leftColumnTitle}</p>
      <ul class="space-y-1.5 text-xs text-[#94a3b8]">
        {leftColumnItems.map((item) => <li class="flex gap-2"><span class="text-[#06b6d4]">•</span>{item}</li>)}
      </ul>
    </div>
    <div>
      <p class="text-xs font-bold tracking-wider text-[#e2c974] uppercase mb-2">{rightColumnTitle}</p>
      <ul class="space-y-1.5 text-xs text-[#94a3b8]">
        {rightColumnItems.map((item) => <li class="flex gap-2"><span class="text-[#06b6d4]">•</span>{item}</li>)}
      </ul>
    </div>
  </div>

  <div class="rounded-xl bg-[#0b1120]/90 border border-white/10 text-[#38bdf8] text-center font-bold py-3 px-4 text-xs tracking-wide">
    {oneLiner}
  </div>
</div>
