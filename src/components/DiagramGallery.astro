---
// Drop your own diagram images into /public/diagrams/ and add an entry
// here to swap these out - these three are real, matching the case
// studies already on this site, not blank placeholders.
const diagrams = [
  { file: 'fraud-detection-flow.svg', title: 'Fraud detection & forensic tracing flow', category: 'Fintech / Fraud' },
  { file: 'event-driven-payments.svg', title: 'Event-driven payment architecture', category: 'System Architecture' },
  { file: 'multi-bank-reconciliation.svg', title: 'Multi-bank C2C reconciliation', category: 'Fintech / Payments' },
];
const base = import.meta.env.BASE_URL;
---

<section id="diagrams" class="relative z-10 max-w-6xl mx-auto px-6 py-24">
  <h2 class="text-3xl font-bold text-center mb-2">Diagrams</h2>
  <p class="text-center text-(--color-text-muted) mb-12">
    Years of whiteboard sessions, distilled. Click any diagram to view it full size.
  </p>

  <div class="grid sm:grid-cols-3 gap-4">
    {diagrams.map((d, i) => (
      <button
        type="button"
        class="spotlight-card glass rounded-2xl p-4 text-left group"
        data-diagram-trigger={i}
      >
        <img src={base + "diagrams/" + d.file} alt={d.title} class="rounded-lg w-full h-40 object-cover mb-3 bg-black/20" loading="lazy" />
        <p class="text-xs text-(--color-aurora-2) mb-1">{d.category}</p>
        <p class="text-sm font-medium">{d.title}</p>
      </button>
    ))}
  </div>

  {diagrams.map((d, i) => (
    <dialog id={`diagram-dialog-${i}`} class="glass rounded-2xl p-4 max-w-4xl w-[90vw] backdrop:bg-black/70 backdrop:backdrop-blur-sm">
      <div class="flex justify-between items-center mb-3">
        <p class="font-medium">{d.title}</p>
        <button type="button" class="text-(--color-text-muted) hover:text-(--color-text)" data-diagram-close={i}>✕</button>
      </div>
      <img src={base + "diagrams/" + d.file} alt={d.title} class="rounded-lg w-full" />
    </dialog>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-diagram-trigger]').forEach((btn) => {
    const i = btn.dataset.diagramTrigger;
    const dialog = document.getElementById(`diagram-dialog-${i}`) as HTMLDialogElement | null;
    btn.addEventListener('click', () => dialog?.showModal());
  });
  document.querySelectorAll<HTMLButtonElement>('[data-diagram-close]').forEach((btn) => {
    const i = btn.dataset.diagramClose;
    const dialog = document.getElementById(`diagram-dialog-${i}`) as HTMLDialogElement | null;
    btn.addEventListener('click', () => dialog?.close());
  });
</script>
