const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const diagrams = [
  {
    title: 'Fraud Detection & Forensic Tracing',
    subtitle: 'Event-driven ingestion, temporal graph analysis, and real-time AML screening pipeline.',
    file: 'fraud-tracing-architecture.svg',
    tags: ['Kafka', 'Neo4j', 'Flink', 'PostgreSQL'],
  },
  {
    title: 'Event-Driven Payment Settlement',
    subtitle: 'Idempotent transaction log, two-phase commit reconciliation, and ledger immutability.',
    file: 'payment-switch-architecture.svg',
    tags: ['Outbox Pattern', 'gRPC', 'Redis', 'ScyllaDB'],
  },
  {
    title: 'National Telecom SMS Routing Switch',
    subtitle: 'High-throughput SMPP aggregator managing multi-operator trunk failover, delivery receipt reconciliation.',
    file: 'sms-routing-architecture.svg',
    tags: ['SMPP', 'Sliding Window', 'Least Cost Routing'],
  },
];
---

<section class="max-w-7xl mx-auto px-6 sm:px-8 py-16 font-mono" dir="ltr">
  <div class="mb-10">
    <h2 class="text-xs uppercase tracking-widest text-[#06b6d4] font-bold mb-2">Architectural Blueprints</h2>
    <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[#f8fafc]">Core System Topologies</h3>
    <p class="text-[#94a3b8] mt-2 max-w-2xl text-xs sm:text-sm leading-relaxed">
      High-reliability enterprise architectures designed for auditability, high throughput, and fault tolerance.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {diagrams.map((d) => (
      <div class="bg-[#111827] border border-white/10 p-5 flex flex-col justify-between hover:border-[#06b6d4] transition-colors rounded-xl">
        <div>
          <div class="overflow-hidden bg-[#0b1120] border border-white/10 mb-4 p-2 flex items-center justify-center min-h-[190px] rounded-lg">
            <img 
              src={`${baseUrl}diagrams/${d.file}`} 
              alt={d.title}
              class="w-full h-auto max-h-48 object-contain"
              loading="lazy"
            />
          </div>
          <h4 class="text-sm sm:text-base font-bold uppercase text-[#f8fafc] mb-1.5">{d.title}</h4>
          <p class="text-xs text-[#94a3b8] leading-relaxed">{d.subtitle}</p>
        </div>

        <div class="flex flex-wrap gap-2 mt-5 pt-3 border-t border-white/10">
          {d.tags.map((tag) => (
            <span class="text-[10px] uppercase font-bold px-2 py-0.5 bg-[#0b1120] border border-white/10 text-[#38bdf8] rounded">
              {tag}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
