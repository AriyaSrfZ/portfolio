---
const diagrams = [
  {
    title: 'Fraud Detection & Forensic Tracing',
    subtitle: 'Event-driven ingestion, temporal graph analysis, and real-time AML screening pipeline.',
    file: 'placeholder-1.svg',
    tags: ['Kafka', 'Neo4j', 'Flink', 'PostgreSQL'],
  },
  {
    title: 'Event-Driven Payment Settlement',
    subtitle: 'Idempotent transaction log, two-phase commit reconciliation, and ledger immutability.',
    file: 'placeholder-2.svg',
    tags: ['Outbox Pattern', 'gRPC', 'Redis', 'ScyllaDB'],
  },
  {
    title: 'Multi-Tenant Identity Service',
    subtitle: 'Zero-trust authorization layer, RS256 token verification, and policy enforcement points.',
    file: 'placeholder-3.svg',
    tags: ['OAuth 2.1', 'OPA', 'mTLS', 'Distributed Cache'],
  },
];
---

<section class="max-w-7xl mx-auto px-6 sm:px-8 py-16 font-['IBM_Plex_Mono',monospace]">
  <div class="mb-10">
    <h2 class="text-xs uppercase tracking-widest text-[#c4562e] font-bold mb-2">Architectural Blueprints</h2>
    <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[#e8e2d5]">Core System Topologies</h3>
    <p class="text-[#a8a196] mt-2 max-w-2xl text-xs sm:text-sm leading-relaxed">
      High-reliability enterprise architectures designed for auditability, high throughput, and fault tolerance.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {diagrams.map((d) => (
      <div class="bg-[#1c1916] border border-[#5c6650] p-5 flex flex-col justify-between hover:border-[#c4562e] transition-colors">
        <div>
          <div class="overflow-hidden bg-[#141210] border border-[#5c6650] mb-4 p-2 flex items-center justify-center min-h-[190px]">
            <img 
              src={`/diagrams/${d.file}`} 
              alt={d.title}
              class="w-full h-auto max-h-48 object-contain"
              loading="lazy"
            />
          </div>
          <h4 class="text-sm sm:text-base font-bold uppercase text-[#e8e2d5] mb-1.5">{d.title}</h4>
          <p class="text-xs text-[#a8a196] leading-relaxed">{d.subtitle}</p>
        </div>

        <div class="flex flex-wrap gap-2 mt-5 pt-3 border-t border-[#5c6650]">
          {d.tags.map((tag) => (
            <span class="text-[10px] uppercase font-bold px-2 py-0.5 bg-[#141210] border border-[#5c6650] text-[#c9d4a8]">
              {tag}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
