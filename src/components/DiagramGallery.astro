---
interface Diagram {
  src: string;
  title: string;
  category: string;
  desc: string;
}

const diagrams: Diagram[] = [
  {
    src: "/diagrams/fraud-detection-flow.svg",
    title: "Fraud Detection & Forensic Tracing",
    category: "Security & Data Engineering",
    desc: "Real-time heuristic scoring, distributed feature extraction, and immutable forensic audit trails for high-volume transactions."
  },
  {
    src: "/diagrams/event-driven-payments.svg",
    title: "Event-Driven Payment Settlement",
    category: "System Architecture",
    desc: "Asynchronous settlement orchestration with distributed state machines, idempotent webhooks, and outbox pattern."
  },
  {
    src: "/diagrams/multi-bank-reconciliation.svg",
    title: "Multi-Bank Core Reconciliation",
    category: "Financial Infrastructure",
    desc: "Automated ledger balancing, dual-entry accounting guarantees, and anomaly resolution across heterogeneous bank protocols."
  }
];
---

<section id="diagrams" class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12 py-24">
  <div class="max-w-3xl mb-14">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-500/20 bg-purple-500/10 text-xs text-purple-300 mb-4 font-mono tracking-wide">
      <span>SYSTEM BLUEPRINTS</span>
    </div>
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4">
      Architecture & Flows
    </h2>
    <p class="text-base md:text-lg text-(--color-text-muted) leading-relaxed">
      Production-grade architectural schematics, distributed state machines, and payment reconciliation topology.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
    {diagrams.map((d, i) => (
      <div class="group relative flex flex-col justify-between rounded-2xl border border-white/10 bg-white/[0.02] p-5 backdrop-blur-xl transition-all duration-300 hover:border-purple-500/40 hover:bg-white/[0.04] hover:shadow-[0_0_30px_rgba(168,85,247,0.15)]">
        <div>
          <div class="relative w-full aspect-[16/10] rounded-xl overflow-hidden bg-neutral-950 border border-white/10 flex items-center justify-center p-3 mb-5 group-hover:border-purple-500/30 transition-colors">
            <img 
              src={d.src} 
              alt={d.title} 
              class="w-full h-full object-contain filter drop-shadow-md transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
          </div>

          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-mono font-medium px-2.5 py-0.5 rounded-md bg-white/5 text-purple-300 border border-white/5">
              {d.category}
            </span>
          </div>

          <h3 class="text-lg font-semibold text-white group-hover:text-purple-200 transition-colors">
            {d.title}
          </h3>
          <p class="text-sm text-(--color-text-muted) mt-2 line-clamp-3 leading-relaxed">
            {d.desc}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-white/5">
          <button
            type="button"
            data-diagram-trigger={i}
            class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-white/5 hover:bg-purple-600 hover:text-white border border-white/10 transition-all duration-200 cursor-pointer group-hover:border-purple-500/30"
          >
            <span>Inspect Blueprint</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </div>
    ))}
  </div>

  {diagrams.map((d, i) => (
    <dialog id={`diagram-dialog-${i}`} class="diagram-modal">
      <div class="diagram-modal-backdrop" data-diagram-close={i}></div>
      <div class="diagram-modal-box">
        <div class="flex items-center justify-between px-6 py-4 border-b border-white/10 bg-neutral-900/80">
          <div class="flex items-center gap-3">
            <span class="text-xs font-mono px-2.5 py-1 rounded bg-purple-500/10 border border-purple-500/20 text-purple-300 font-semibold">
              {d.category}
            </span>
            <h4 class="text-base md:text-lg font-semibold text-white truncate max-w-lg">
              {d.title}
            </h4>
          </div>
          <button
            type="button"
            data-diagram-close={i}
            class="p-2 text-neutral-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer"
            aria-label="Close modal"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="p-6 md:p-10 flex items-center justify-center bg-neutral-950/95 overflow-auto min-h-[50vh]">
          <img 
            src={d.src} 
            alt={d.title} 
            class="w-full max-w-5xl max-h-[75vh] object-contain rounded-lg shadow-2xl" 
          />
        </div>

        <div class="px-6 py-3 border-t border-white/5 bg-neutral-900/50 text-xs text-neutral-400 flex items-center justify-between">
          <span>{d.desc}</span>
          <span>Press <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-white font-mono">ESC</kbd> to close</span>
        </div>
      </div>
    </dialog>
  ))}
</section>

<style>
  .diagram-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    background: transparent;
    border: none;
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100vh;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .diagram-modal[open] {
    display: flex;
  }

  .diagram-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1;
  }

  .diagram-modal-box {
    position: relative;
    z-index: 2;
    width: 94vw;
    max-width: 1200px;
    max-height: 90vh;
    border-radius: 1.25rem;
    background: #0d0d11;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.9), 0 0 40px rgba(168, 85, 247, 0.15);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-diagram-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const i = btn.dataset.diagramTrigger;
      const dialog = document.getElementById(`diagram-dialog-${i}`) as HTMLDialogElement | null;
      if (dialog) {
        dialog.showModal();
        document.body.style.overflow = "hidden";
      }
    });
  });

  document.querySelectorAll<HTMLElement>("[data-diagram-close]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const i = btn.dataset.diagramClose;
      const dialog = document.getElementById(`diagram-dialog-${i}`) as HTMLDialogElement | null;
      if (dialog) {
        dialog.close();
        document.body.style.overflow = "";
      }
    });
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      document.body.style.overflow = "";
    }
  });
</script>
