---
const diagrams = [
  {
    title: 'Fraud Detection & Forensic Tracing',
    subtitle: 'Event-driven ingestion, temporal graph analysis, and real-time AML screening pipeline.',
    file: 'placeholder-1.svg',
    tags: ['Kafka', 'Neo4j', 'Flink', 'PostgreSQL'],
  },
  {
    title: 'Event-Driven Payment Settlement',
    subtitle: 'Idempotent transaction log, two-phase commit reconciliation, and ledger immutability.',
    file: 'placeholder-2.svg',
    tags: ['Outbox Pattern', 'gRPC', 'Redis', 'ScyllaDB'],
  },
  {
    title: 'Multi-Tenant Identity Service',
    subtitle: 'Zero-trust authorization layer, RS256 token verification, and policy enforcement points.',
    file: 'placeholder-3.svg',
    tags: ['OAuth 2.1', 'OPA', 'mTLS', 'Distributed Cache'],
  },
];
---

<section class="max-w-7xl mx-auto px-6 sm:px-8 py-16">
  <div class="mb-10">
    <h2 class="text-xs uppercase tracking-widest text-emerald-500 font-mono mb-2">Architectural Blueprints</h2>
    <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-(--color-text)">Core System Topologies</h3>
    <p class="text-(--color-text-muted) mt-2 max-w-2xl text-xs sm:text-sm leading-relaxed">
      High-reliability enterprise architectures designed for auditability, high throughput, and fault tolerance.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {diagrams.map((d) => (
      <div class="archival-card rounded-xl p-5 flex flex-col justify-between border border-[#23262E] hover:border-emerald-500/50 transition-all duration-300">
        <div>
          <div class="rounded-lg overflow-hidden bg-[#0D0E11] border border-white/5 mb-4 p-2 flex items-center justify-center min-h-[190px]">
            <img 
              src={`/diagrams/${d.file}`} 
              alt={d.title}
              class="w-full h-auto max-h-48 object-contain"
              loading="lazy"
            />
          </div>
          <h4 class="text-sm sm:text-base font-semibold text-(--color-text) mb-1.5">{d.title}</h4>
          <p class="text-xs text-(--color-text-muted) leading-relaxed">{d.subtitle}</p>
        </div>

        <div class="flex flex-wrap gap-1.5 mt-5 pt-3 border-t border-white/5">
          {d.tags.map((tag) => (
            <span class="tag-badge text-[10px] font-mono px-2 py-0.5 rounded">
              {tag}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
