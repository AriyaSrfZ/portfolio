---
import '../styles/global.css';
import FloatingNavbar from '../components/react/FloatingNavbar';
import BackgroundController from '../components/react/BackgroundController';
import Velaris from '../components/ui/velaris';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  theme?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  image?: string;
}

const { 
  title, 
  description = 'Ariya Sarrafzadeh | Systems Architect & Infrastructure Engineer specializing in Iranian fintech switches, double-entry ledgers, and telecom routing.',
  theme = 'rugged',
  lang = 'en',
  dir = lang === 'fa' ? 'rtl' : 'ltr',
  image = '/diagrams/double-entry-ledger-schematic.svg'
} = Astro.props;

const isFa = lang === 'fa';
const siteUrl = 'https://ariya-sarrafzadeh.ir';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;

const jsonLdPerson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://ariya-sarrafzadeh.ir/#person",
      "name": "Ariya Sarrafzadeh",
      "alternateName": "آریا صراف‌زاده",
      "jobTitle": "Principal Systems Architect & Technical Product Manager",
      "description": "Architect of high-throughput payment switches, double-entry accounting ledgers, and telecom infrastructure.",
      "url": "https://ariya-sarrafzadeh.ir",
      "email": "ariasg2002@gmail.com",
      "sameAs": [
        "https://github.com/ariasg2002",
        "https://www.linkedin.com/in/ariya-sarrafzadeh/",
        "https://t.me/ariasg2002"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tehran",
        "addressCountry": "IR"
      },
      "knowsAbout": [
        "Payment Switch Architecture",
        "ISO 8583 Protocol",
        "Double-Entry Accounting Ledgers",
        "Multi-Bank Financial Reconciliation",
        "eKYC & Identity Verification",
        "SMPP Telecom Gateways",
        "Distributed Systems & Raft Consensus"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://ariya-sarrafzadeh.ir/#website",
      "url": "https://ariya-sarrafzadeh.ir",
      "name": "Ariya Sarrafzadeh — Systems Architecture & Engineering Portfolio",
      "publisher": { "@id": "https://ariya-sarrafzadeh.ir/#person" },
      "inLanguage": ["en", "fa"]
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": "https://ariya-sarrafzadeh.ir/#website" },
      "about": { "@id": "https://ariya-sarrafzadeh.ir/#person" },
      "inLanguage": lang
    },
    {
      "@type": "Organization",
      "@id": "https://ariya-sarrafzadeh.ir/#organization",
      "name": "Ariya Sarrafzadeh Systems Engineering",
      "url": "https://ariya-sarrafzadeh.ir",
      "logo": "https://ariya-sarrafzadeh.ir/favicon.svg",
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "email": "ariasg2002@gmail.com",
          "contactType": "technical support and enterprise consultation",
          "availableLanguage": ["English", "Persian"]
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tehran",
        "addressCountry": "IR"
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang={lang} dir={dir} data-theme={theme} class="dark bg-[#0e1117]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content={isFa ? 'fa_IR' : 'en_US'} />
  <meta property="og:site_name" content="Ariya Sarrafzadeh Portfolio" />

  <!-- Twitter Meta Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Autonomous Agent & API Discovery Links -->
  <link rel="alternate" type="text/markdown" href={`${siteUrl}/index.md`} title="Markdown Edition" />
  <link rel="service-desc" type="application/vnd.oai.openapi+json" href={`${siteUrl}/openapi.json`} title="OpenAPI 3.1 Specification" />
  <link rel="api-catalog" href={`${siteUrl}/openapi.json`} />
  <link rel="author" href={`${siteUrl}/about/`} />
  <link rel="help" href={`${siteUrl}/docs/`} />
  <link rel="help" href={`${siteUrl}/developers/`} />
  <link rel="privacy-policy" href={`${siteUrl}/privacy/`} />

  <!-- JSON-LD Structured Data Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />

  <!-- Apple Appearance & Dark Mode Early Initialization -->
  <script is:inline>
    (function() {
      try {
        var appearance = localStorage.getItem('apple-appearance-mode') || 'dark';
        var darkFlavor = localStorage.getItem('apple-dark-flavor') || 'spacegray';
        var glass = localStorage.getItem('apple-glass-intensity') || 'liquid';
        var root = document.documentElement;
        var effective = appearance;
        if (appearance === 'system') {
          effective = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-appearance', effective);
        root.setAttribute('data-dark-flavor', darkFlavor);
        root.setAttribute('data-glass-intensity', glass);
        if (effective === 'light') {
          root.classList.remove('dark');
          root.classList.add('light');
        } else {
          root.classList.remove('light');
          root.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>

  <Analytics />
</head>
<body class="min-h-screen bg-transparent text-[var(--system-label,#ffffff)] selection:bg-white/10 selection:text-white font-sans antialiased overflow-x-hidden pt-16 sm:pt-20">
  <!-- Living WebGL Simplex-Noise Telemetry Background -->
  <div id="velaris-container" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <Velaris
      client:only="react"
      height="100vh"
      speed={0.25}
      grain={0.04}
      colors={["#1c293d", "#132032", "#1e2430", "#0e1117"]}
      bg="#0e1117"
    />
  </div>

  <BackgroundController client:load />
  <FloatingNavbar client:load locale={isFa ? 'fa' : 'en'} />

  <div class="relative z-10">
    <slot />
  </div>

  <footer class="relative z-10 border-t border-white/[0.07] mt-24 py-12 px-6 font-sans text-xs text-[#94a3b8]">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col items-center md:items-start gap-1">
        {isFa ? (
          <p class="text-white font-semibold">© {new Date().getFullYear()} آریا صراف‌زاده · کلیه سامانه‌ها عملیاتی</p>
        ) : (
          <p class="text-white font-semibold">© {new Date().getFullYear()} Ariya Sarrafzadeh · NODE: NOMINAL · PRODUCTION READY</p>
        )}
        <p class="text-[11px] text-neutral-400 font-sans">
          Fintech &amp; Telecom Systems Engineering · Tehran, Iran
        </p>
      </div>

      <!-- Quick Trust & Agent Links -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-[11px] font-sans font-medium">
        <a href={`${import.meta.env.BASE_URL}developers/`} class="hover:text-white transition-colors">
          {isFa ? 'پورتال توسعه‌دهندگان' : 'Developers'}
        </a>
        <span>·</span>
        <a href={`${import.meta.env.BASE_URL}docs/`} class="hover:text-white transition-colors">
          {isFa ? 'مستندات API' : 'API Docs'}
        </a>
        <span>·</span>
        <a href={`${import.meta.env.BASE_URL}contact/`} class="hover:text-white transition-colors">
          {isFa ? 'تماس و مشاوره' : 'Contact'}
        </a>
        <span>·</span>
        <a href={`${import.meta.env.BASE_URL}privacy/`} class="hover:text-white transition-colors">
          {isFa ? 'حریم خصوصی' : 'Privacy'}
        </a>
        <span>·</span>
        <a href={`${import.meta.env.BASE_URL}openapi.json`} target="_blank" rel="noopener noreferrer" class="text-[#38bdf8] hover:text-[#06b6d4] transition-colors">
          OpenAPI
        </a>
        <span>·</span>
        <a href={`${import.meta.env.BASE_URL}llms.txt`} target="_blank" rel="noopener noreferrer" class="text-[#10b981] hover:text-[#34d399] transition-colors">
          llms.txt
        </a>
      </div>
    </div>
  </footer>

  <script>
    import Lenis from 'lenis';

    const lenis = new Lenis({
      duration: 1.1,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 0.9,
    });

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }

    requestAnimationFrame(raf);
  </script>
</body>
</html>