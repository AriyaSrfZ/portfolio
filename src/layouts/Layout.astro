---
import '../styles/global.css';
import FloatingNavbar from '../components/react/FloatingNavbar';
import Analytics from '../components/Analytics.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { BRAND_NAME, BRAND_NAME_FA, SUPPORTING_STATEMENT, SUPPORTING_STATEMENT_FA } from '../consts';

interface Props {
  title: string;
  description?: string;
  theme?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  image?: string;
}

const { 
  title, 
  description = 'Ariya Sarrafzadeh | Systems Architect & Technical Product Leader. Complexity, made dependable. High-throughput switches, double-entry ledgers, and telecom infrastructure.',
  theme = 'rugged',
  lang = 'en',
  dir = lang === 'fa' ? 'rtl' : 'ltr',
  image = '/brand/og-preview.svg'
} = Astro.props;

const isFa = lang === 'fa';
const siteUrl = 'https://ariya-sarrafzadeh.xyz';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;

const jsonLdPerson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://ariya-sarrafzadeh.xyz/#person",
      "name": "Ariya Sarrafzadeh",
      "alternateName": "آریا صراف‌زاده",
      "jobTitle": "Principal Systems Architect & Technical Product Leader",
      "description": SUPPORTING_STATEMENT,
      "url": "https://ariya-sarrafzadeh.xyz",
      "email": "ariasg2002@gmail.com",
      "sameAs": [
        "https://github.com/AriyaSrfZ",
        "https://github.com/ariasg2002",
        "https://www.linkedin.com/in/ariya-sarrafzadeh/",
        "https://t.me/ariasg2002"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tehran",
        "addressCountry": "IR"
      },
      "knowsAbout": [
        "Systems Architecture",
        "Distributed Systems & Consensus",
        "Payment Switch Architecture",
        "ISO 8583 Protocol",
        "Double-Entry Accounting Ledgers",
        "Multi-Bank Financial Reconciliation",
        "eKYC & Fraud Risk Forensics",
        "SMPP Telecom Gateways",
        "Technical Product Management"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://ariya-sarrafzadeh.xyz/#website",
      "url": "https://ariya-sarrafzadeh.xyz",
      "name": "Ariya Sarrafzadeh — Systems Architecture & Engineering Portfolio",
      "publisher": { "@id": "https://ariya-sarrafzadeh.xyz/#person" },
      "inLanguage": ["en", "fa"]
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": "https://ariya-sarrafzadeh.xyz/#website" },
      "about": { "@id": "https://ariya-sarrafzadeh.xyz/#person" },
      "inLanguage": lang
    },
    {
      "@type": "Organization",
      "@id": "https://ariya-sarrafzadeh.xyz/#organization",
      "name": "Ariya Sarrafzadeh Systems Engineering",
      "url": "https://ariya-sarrafzadeh.xyz",
      "logo": "https://ariya-sarrafzadeh.xyz/brand/as-lockup-dark.svg",
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "email": "ariasg2002@gmail.com",
          "contactType": "technical advisory and architecture consultation",
          "availableLanguage": ["English", "Persian"]
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tehran",
        "addressCountry": "IR"
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang={lang} dir={dir} data-theme={theme} class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content={isFa ? 'fa_IR' : 'en_US'} />
  <meta property="og:site_name" content="Ariya Sarrafzadeh" />

  <!-- Twitter Meta Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Autonomous Agent & API Discovery Links -->
  <link rel="alternate" type="text/markdown" href={`${siteUrl}/index.md`} title="Markdown Edition" />
  <link rel="service-desc" type="application/vnd.oai.openapi+json" href={`${siteUrl}/openapi.json`} title="OpenAPI 3.1 Specification" />
  <link rel="api-catalog" href={`${siteUrl}/openapi.json`} />
  <link rel="author" href={`${siteUrl}/about/`} />
  <link rel="help" href={`${siteUrl}/docs/`} />
  <link rel="help" href={`${siteUrl}/developers/`} />
  <link rel="privacy-policy" href={`${siteUrl}/privacy/`} />

  <!-- JSON-LD Structured Data Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />

  <!-- Design System Appearance & Theme Early Initialization (Zero Flash) -->
  <script is:inline>
    (function() {
      try {
        var savedMode = localStorage.getItem('appearance-mode') || localStorage.getItem('apple-appearance-mode') || 'light';
        var root = document.documentElement;
        var effective = savedMode;
        if (savedMode === 'system') {
          effective = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-appearance', effective);
        if (effective === 'light') {
          root.classList.remove('dark');
          root.classList.add('light');
        } else {
          root.classList.remove('light');
          root.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>

  <Analytics />
</head>
<body class="min-h-screen text-[var(--text-primary)] font-sans antialiased overflow-x-hidden pt-16 sm:pt-20">
  <FloatingNavbar client:load locale={isFa ? 'fa' : 'en'} />

  <div class="relative z-10">
    <slot />
  </div>

  <footer class="relative z-10 mt-24 bg-[var(--ink-2)] text-[var(--on-accent)] font-sans">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12 pt-14 pb-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
        <div class="lg:col-span-7">
          <p class="font-[family-name:var(--font-display)] font-semibold leading-[1.02] text-[clamp(2.25rem,5vw,4rem)] tracking-[-0.01em]">
            {isFa ? 'سیستمی دارید که باید زیر بار درست بماند؟' : 'Have a system that must stay correct under load?'}
          </p>
          <p class="mt-4 max-w-[58ch] text-base sm:text-lg opacity-90">
            {isFa
              ? 'برای پروژه‌های طراحی سیستم، بازبینی معماری و نقش‌های ارشد در دسترس هستم.'
              : 'I take on system-design projects and architecture reviews, and I am open to conversations about senior roles.'}
          </p>
        </div>
        <div class="lg:col-span-5 flex flex-wrap gap-3 lg:justify-end">
          <a href={`${import.meta.env.BASE_URL}${isFa ? 'fa/' : ''}contact/`} class="inline-flex items-center gap-2 bg-[var(--on-accent)] text-[var(--ink-2)] font-semibold text-[1.0625rem] px-6 py-3.5 rounded-sm hover:opacity-90 transition-opacity">
            {isFa ? 'رزرو جلسه' : 'Book a call'}
          </a>
          <a href="mailto:ariasg2002@gmail.com?subject=Project%20inquiry" class="inline-flex items-center gap-2 border-[1.5px] border-[var(--on-accent)] font-semibold px-6 py-3.5 rounded-sm hover:bg-[var(--on-accent)] hover:text-[var(--ink-2)] transition-colors">
            {isFa ? 'ایمیل' : 'Email me'}
          </a>
        </div>
      </div>

      <dl class="title-block mt-12 grid-cols-2 md:grid-cols-4 !border-[var(--on-accent)] [&>*]:!border-[var(--on-accent)]/60 [&_dt]:!text-[var(--on-accent)] [&_dt]:opacity-70 [&_dd]:!text-[var(--on-accent)]">
        <div>
          <dt>{isFa ? 'نام' : 'Drawn by'}</dt>
          <dd>{isFa ? BRAND_NAME_FA : BRAND_NAME}</dd>
        </div>
        <div>
          <dt>{isFa ? 'حوزه' : 'Discipline'}</dt>
          <dd>{isFa ? 'پرداخت، دفتر کل، مخابرات' : 'Payments, ledgers, telecom'}</dd>
        </div>
        <div>
          <dt>{isFa ? 'محل' : 'Based in'}</dt>
          <dd>{isFa ? 'تهران، ایران' : 'Tehran, Iran'}</dd>
        </div>
        <div>
          <dt>{isFa ? 'تاریخ' : 'Date'}</dt>
          <dd>{new Date().getFullYear()}</dd>
        </div>
      </dl>

      <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label={isFa ? 'پیوندها' : 'Footer'}>
        <a class="underline decoration-1 hover:opacity-80" href="https://www.linkedin.com/in/ariya-sarrafzadeh/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="underline decoration-1 hover:opacity-80" href="https://github.com/AriyaSrfZ" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="underline decoration-1 hover:opacity-80" href={`${import.meta.env.BASE_URL}${isFa ? 'fa/' : ''}whitepapers/`}>{isFa ? 'مقالات فنی' : 'Whitepapers'}</a>
        <a class="underline decoration-1 hover:opacity-80" href={`${import.meta.env.BASE_URL}developers/`}>{isFa ? 'پورتال توسعه‌دهندگان' : 'Developers'}</a>
        <a class="underline decoration-1 hover:opacity-80" href={`${import.meta.env.BASE_URL}docs/`}>{isFa ? 'مستندات API' : 'API docs'}</a>
        <a class="underline decoration-1 hover:opacity-80" href={`${import.meta.env.BASE_URL}privacy/`}>{isFa ? 'حریم خصوصی' : 'Privacy'}</a>
        <a class="underline decoration-1 hover:opacity-80" href={`${import.meta.env.BASE_URL}openapi.json`} target="_blank" rel="noopener noreferrer">OpenAPI</a>
        <a class="underline decoration-1 hover:opacity-80" href={`${import.meta.env.BASE_URL}llms.txt`} target="_blank" rel="noopener noreferrer">llms.txt</a>
      </nav>
    </div>
  </footer>

  <script>
    import Lenis from 'lenis';

    const lenis = new Lenis({
      duration: 1.1,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 0.9,
    });

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }

    requestAnimationFrame(raf);
  </script>
  <ImageLightbox />
</body>
</html>