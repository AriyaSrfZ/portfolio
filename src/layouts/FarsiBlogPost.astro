---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  technologies: string[];
  metric?: string;
  slug?: string;
}

const { title, description, date, technologies, metric, slug } = Astro.props;

const specNumberMap: Record<string, string> = {
  'payment-gateway': '۰۱',
  'sms-infrastructure': '۰۲',
  'fraud-tracing': '۰۳',
  'fraud-detection-forensic-tracing': '۰۳',
  'event-driven-migration': '۰۴',
  'contact-enrichment-pipeline': '۰۵',
  'iran-sms-market-research': '۰۶',
};

const specNum = slug && specNumberMap[slug] ? specNumberMap[slug] : null;
---

<Layout title={`${title} — آریا صراف‌زاده`} description={description} lang="fa" dir="rtl">
  <article
    dir="rtl"
    class="relative z-10 max-w-3xl mx-auto px-6 pt-24 pb-20 font-['Vazirmatn',sans-serif] tracking-normal"
  >
    <a
      href={`${import.meta.env.BASE_URL}fa/#blueprints`}
      class="text-xs uppercase tracking-normal text-[#94a3b8] hover:text-[#ededed] inline-flex items-center gap-1.5 transition-colors font-mono"
    >
      → بازگشت به نقشه‌های معماری
    </a>

    {specNum && (
      <div class="mt-5 mb-1 font-mono text-[11px] font-semibold text-[#06b6d4] uppercase tracking-wider" dir="rtl">
        SPEC {specNum} · مشخصات فنی سامانه
      </div>
    )}

    <h1 class={`text-2xl sm:text-3xl font-bold ${specNum ? 'mt-1' : 'mt-5'} mb-2 text-[#ededed] tracking-normal`}>{title}</h1>
    <p class="text-xs text-[#94a3b8] mb-4 tracking-normal font-mono">
      {date.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>

    <div class="flex flex-wrap gap-1.5 mb-6" dir="ltr">
      {technologies.map((tech) => (
        <span class="text-[10px] px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400 font-mono tracking-normal">
          [{tech}]
        </span>
      ))}
    </div>

    {metric && (
      <div class="bg-[#111317]/90 border border-white/[0.07] rounded-xl px-4 py-2.5 text-[#10b981] font-bold text-xs uppercase mb-8 inline-flex items-center gap-2 font-mono tracking-normal shadow-lg" dir="ltr">
        <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-pulse"></span>
        <span>{metric}</span>
      </div>
    )}

    <div class="max-w-none text-xs sm:text-sm leading-relaxed tracking-normal
      [&_h2]:text-[#ededed] [&_h2]:text-lg [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:border-b [&_h2]:border-white/[0.07] [&_h2]:pb-2 [&_h2]:font-bold [&_h2]:tracking-normal
      [&_h3]:text-[#ededed] [&_h3]:text-base [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:font-bold [&_h3]:tracking-normal
      [&_p]:mb-5 [&_p]:text-[#cbd5e1] [&_p]:leading-relaxed [&_p]:tracking-normal
      [&_ul]:list-disc [&_ul]:ps-5 [&_ul]:mb-5
      [&_li]:mb-1.5 [&_li]:text-[#94a3b8] [&_li]:tracking-normal
      [&_table]:[direction:ltr] [&_table]:text-left [&_table]:w-full [&_table]:border-collapse [&_table]:mb-6 [&_table]:text-xs
      [&_th]:[direction:ltr] [&_th]:text-left [&_th]:border [&_th]:border-white/[0.07] [&_th]:p-2.5 [&_th]:text-[#ededed] [&_th]:bg-[#111317] [&_th]:tracking-normal
      [&_td]:[direction:ltr] [&_td]:text-left [&_td]:border [&_td]:border-white/[0.07] [&_td]:p-2.5 [&_td]:text-[#cbd5e1] [&_td]:tracking-normal
      [&_strong]:text-[#ededed] [&_strong]:font-semibold
      [&_pre]:[direction:ltr] [&_pre]:text-left [&_pre]:!whitespace-pre [&_pre]:overflow-x-auto [&_pre]:!bg-[#090a0c] [&_pre]:!border [&_pre]:!border-white/[0.08] [&_pre]:p-4 [&_pre]:my-5 [&_pre]:rounded-xl [&_pre]:max-w-full
      [&_code]:[direction:ltr] [&_code]:text-left [&_code]:!text-[#ededed] [&_code]:!font-mono [&_code]:!bg-transparent [&_code]:!p-0 [&_code]:tracking-normal
      [&_blockquote]:border-r-2 [&_blockquote]:border-[#d97706] [&_blockquote]:bg-[#111317]/60 [&_blockquote]:p-3.5 [&_blockquote]:my-5 [&_blockquote]:rounded-l-xl [&_blockquote]:not-italic [&_blockquote]:text-[#ededed]">
      <slot />
    </div>
  </article>
</Layout>
