---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  technologies: string[];
  metric?: string;
  lang?: 'en' | 'fa';
  slug?: string;
}

const { title, description, date, technologies, metric, lang = 'en', slug } = Astro.props;
const isFa = lang === 'fa';

const specNumberMap: Record<string, string> = {
  'payment-gateway': '01',
  'sms-infrastructure': '02',
  'fraud-tracing': '03',
  'fraud-detection-forensic-tracing': '03',
  'event-driven-migration': '04',
  'contact-enrichment-pipeline': '05',
  'global-business-messaging-landscape': '06',
};

const specNum = slug && specNumberMap[slug] ? specNumberMap[slug] : null;
---

<Layout title={`${title} — Ariya Sarrafzadeh`} description={description}>
  <article
    dir={isFa ? 'rtl' : 'ltr'}
    class="relative z-10 max-w-3xl mx-auto px-6 pt-24 pb-20 font-sans"
  >
    <a
      href={isFa ? `${import.meta.env.BASE_URL}fa/#blueprints` : `${import.meta.env.BASE_URL}#blueprints`}
      class="text-xs uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center gap-1.5 transition-colors font-mono"
    >
      {isFa ? '→ بازگشت به نقشه‌های معماری' : '← Back to architecture blueprints'}
    </a>

    {specNum && (
      <div class="mt-5 mb-1 font-mono text-[11px] font-semibold text-[var(--accent-primary)] uppercase tracking-wider">
        SPEC {specNum} · PRODUCTION SPECIFICATION
      </div>
    )}

    <h1 class={`text-2xl sm:text-3xl font-bold tracking-tight ${specNum ? 'mt-1' : 'mt-5'} mb-2 text-[var(--text-primary)]`}>{title}</h1>
    <p class="text-xs text-[var(--text-secondary)] mb-4 font-mono">
      {isFa
        ? date.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' })
        : date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
    </p>

    <div class="flex flex-wrap gap-1.5 mb-6">
      {technologies.map((tech) => (
        <span class="text-[10px] px-2 py-0.5 rounded bg-[var(--surface-elevated)] border border-[var(--border)] text-[var(--text-secondary)] font-mono">
          [{tech}]
        </span>
      ))}
    </div>

    {metric && (
      <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl px-4 py-2.5 text-[var(--accent-primary)] font-bold text-xs uppercase mb-8 inline-flex items-center gap-2 font-mono shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)] animate-pulse"></span>
        <span>{metric}</span>
      </div>
    )}

    <div class="max-w-none text-xs sm:text-sm leading-relaxed [&_h2]:text-[var(--text-primary)] [&_h2]:text-lg [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:border-b [&_h2]:border-[var(--border)] [&_h2]:pb-2 [&_h2]:font-bold [&_h3]:text-[var(--text-primary)] [&_h3]:text-base [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:font-bold [&_p]:mb-5 [&_p]:text-[var(--text-primary)] [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:ps-5 [&_ul]:mb-5 [&_li]:mb-1.5 [&_li]:text-[var(--text-secondary)] [&_table]:w-full [&_table]:border-collapse [&_table]:mb-6 [&_table]:text-xs [&_th]:border [&_th]:border-[var(--border)] [&_th]:p-2.5 [&_th]:text-start [&_th]:text-[var(--text-primary)] [&_th]:bg-[var(--surface-elevated)] [&_td]:border [&_td]:border-[var(--border)] [&_td]:p-2.5 [&_td]:text-[var(--text-primary)] [&_strong]:text-[var(--text-primary)] [&_strong]:font-semibold [&_pre]:!whitespace-pre-wrap [&_pre]:!break-words [&_pre]:!bg-[var(--code-surface)] [&_pre]:!border [&_pre]:!border-[var(--border)] [&_pre]:p-4 [&_pre]:my-5 [&_pre]:rounded-xl [&_pre]:[direction:ltr] [&_pre]:text-left [&_code]:!text-[var(--text-primary)] [&_code]:!font-mono [&_code]:!bg-transparent [&_code]:!p-0 [&_code]:[direction:ltr] [&_blockquote]:border-l-2 [&_blockquote]:border-[#B39A77] [&_blockquote]:bg-[var(--surface-elevated)] [&_blockquote]:p-3.5 [&_blockquote]:my-5 [&_blockquote]:rounded-r-xl [&_blockquote]:text-[var(--text-primary)]">
      <slot />
    </div>
  </article>
</Layout>
