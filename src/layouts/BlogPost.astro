---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  technologies: string[];
  metric?: string;
}

const { title, description, date, technologies, metric } = Astro.props;
---

<Layout title={`${title} — Ariya Sarrafzadeh`} description={description}>
  <article class="relative z-10 max-w-3xl mx-auto px-6 pt-32 pb-24 font-['IBM_Plex_Mono',monospace]">
    <a href={`${import.meta.env.BASE_URL}#work`} class="text-xs uppercase tracking-wider text-[#a8a196] hover:text-[#e8e2d5]">&larr; Back to case studies</a>

    <h1 class="text-3xl font-bold uppercase mt-6 mb-2 text-[#e8e2d5]">{title}</h1>
    <p class="text-xs text-[#a8a196] uppercase mb-4">{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</p>

    <div class="flex flex-wrap gap-2 mb-6">
      {technologies.map((tech) => (
        <span class="text-xs px-2.5 py-1 bg-[#1c1916] border border-[#5c6650] text-[#c9d4a8]">{tech}</span>
      ))}
    </div>

    {metric && <p class="bg-[#1c1916] border border-[#5c6650] px-4 py-3 text-[#c9a15a] font-bold text-xs uppercase mb-8 inline-block">{metric}</p>}

    <div class="max-w-none text-sm leading-relaxed [&_h2]:text-[#c9a15a] [&_h2]:text-xl [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:border-b [&_h2]:border-[#5c6650] [&_h2]:pb-2 [&_h2]:font-bold [&_h3]:text-[#c4562e] [&_h3]:text-lg [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-bold [&_p]:mb-6 [&_p]:text-[#e8e2d5] [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-6 [&_li]:mb-2 [&_li]:text-[#a8a196] [&_table]:w-full [&_table]:border-collapse [&_table]:mb-8 [&_table]:text-sm [&_th]:border [&_th]:border-[#5c6650] [&_th]:p-3 [&_th]:text-left [&_th]:text-[#c9a15a] [&_th]:bg-[#1c1916] [&_td]:border [&_td]:border-[#5c6650] [&_td]:p-3 [&_td]:text-[#e8e2d5] [&_strong]:text-[#c9d4a8] [&_strong]:font-bold">
      <slot />
    </div>
  </article>
</Layout>
