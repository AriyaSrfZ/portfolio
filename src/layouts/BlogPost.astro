---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  technologies: string[];
  metric?: string;
}

const { title, description, date, technologies, metric } = Astro.props;
---

<Layout title={`${title} — Ariya Sarrafzadeh`} description={description}>
  <article class="relative z-10 max-w-2xl mx-auto px-6 pt-32 pb-24">
    <a href={`${import.meta.env.BASE_URL}#work`} class="text-sm text-(--color-text-muted) hover:text-(--color-text)">&larr; Back to case studies</a>

    <h1 class="text-3xl font-bold mt-6 mb-2">{title}</h1>
    <p class="text-(--color-text-muted) mb-4">{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</p>

    <div class="flex flex-wrap gap-1.5 mb-6">
      {technologies.map((tech) => (
        <span class="text-xs px-2 py-0.5 rounded-full bg-white/5 text-(--color-text-muted)">{tech}</span>
      ))}
    </div>

    {metric && <p class="glass rounded-xl px-4 py-3 text-emerald-400 font-medium mb-8 inline-block">{metric}</p>}

    <div class="prose prose-invert prose-p:text-(--color-text-muted) prose-headings:text-(--color-text) max-w-none">
      <slot />
    </div>
  </article>
</Layout>
