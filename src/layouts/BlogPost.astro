---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  technologies: string[];
  metric?: string;
}

const { title, description, date, technologies, metric } = Astro.props;
---

<Layout title={`${title} — Ariya Sarrafzadeh`} description={description}>
  <article class="relative z-10 max-w-3xl mx-auto px-6 pt-32 pb-24 font-['IBM_Plex_Mono',monospace]">
    <a href={`${import.meta.env.BASE_URL}#work`} class="text-xs uppercase tracking-wider text-[#a8a196] hover:text-[#e8e2d5]">&larr; Back to case studies</a>

    <h1 class="text-3xl font-bold uppercase mt-6 mb-2 text-[#e8e2d5]">{title}</h1>
    <p class="text-xs text-[#a8a196] uppercase mb-4">{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</p>

    <div class="flex flex-wrap gap-2 mb-6">
      {technologies.map((tech) => (
        <span class="text-xs px-2.5 py-1 bg-[#1c1916] border border-[#5c6650] text-[#c9d4a8]">{tech}</span>
      ))}
    </div>

    {metric && <p class="bg-[#1c1916] border border-[#5c6650] px-4 py-3 text-[#c9a15a] font-bold text-xs uppercase mb-8 inline-block">{metric}</p>}

    <div class="prose prose-invert prose-p:text-[#a8a196] prose-headings:text-[#e8e2d5] max-w-none text-sm leading-relaxed">
      <slot />
    </div>
  </article>
</Layout>
