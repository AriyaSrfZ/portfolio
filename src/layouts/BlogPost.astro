---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  technologies: string[];
  metric?: string;
  lang?: 'en' | 'fa';
}

const { title, description, date, technologies, metric, lang = 'en' } = Astro.props;
const isFa = lang === 'fa';
---

<Layout title={`${title} — Ariya Sarrafzadeh`} description={description}>
  <article
    dir={isFa ? 'rtl' : 'ltr'}
    class="relative z-10 max-w-3xl mx-auto px-6 pt-24 pb-20 font-sans"
  >
    <a
      href={isFa ? `${import.meta.env.BASE_URL}fa/#blueprints` : `${import.meta.env.BASE_URL}#blueprints`}
      class="text-xs uppercase tracking-wider text-[#94a3b8] hover:text-[#ededed] inline-flex items-center gap-1.5 transition-colors font-mono"
    >
      {isFa ? '→ بازگشت به نقشه‌های معماری' : '← Back to architecture blueprints'}
    </a>

    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mt-5 mb-2 text-[#ededed]">{title}</h1>
    <p class="text-xs text-[#94a3b8] mb-4 font-mono">
      {isFa
        ? date.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' })
        : date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
    </p>

    <div class="flex flex-wrap gap-1.5 mb-6">
      {technologies.map((tech) => (
        <span class="text-[10px] px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400 font-mono">
          [{tech}]
        </span>
      ))}
    </div>

    {metric && (
      <div class="bg-[#111317]/90 border border-white/[0.07] rounded-xl px-4 py-2.5 text-[#10b981] font-bold text-xs uppercase mb-8 inline-flex items-center gap-2 font-mono shadow-lg">
        <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-pulse"></span>
        <span>{metric}</span>
      </div>
    )}

    <div class="max-w-none text-xs sm:text-sm leading-relaxed [&_h2]:text-[#ededed] [&_h2]:text-lg [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:border-b [&_h2]:border-white/[0.07] [&_h2]:pb-2 [&_h2]:font-bold [&_h3]:text-[#ededed] [&_h3]:text-base [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:font-bold [&_p]:mb-5 [&_p]:text-[#cbd5e1] [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:ps-5 [&_ul]:mb-5 [&_li]:mb-1.5 [&_li]:text-[#94a3b8] [&_table]:w-full [&_table]:border-collapse [&_table]:mb-6 [&_table]:text-xs [&_th]:border [&_th]:border-white/[0.07] [&_th]:p-2.5 [&_th]:text-start [&_th]:text-[#ededed] [&_th]:bg-[#111317] [&_td]:border [&_td]:border-white/[0.07] [&_td]:p-2.5 [&_td]:text-[#cbd5e1] [&_strong]:text-[#ededed] [&_strong]:font-semibold [&_pre]:!whitespace-pre-wrap [&_pre]:!break-words [&_pre]:!bg-[#090a0c] [&_pre]:!border [&_pre]:!border-white/[0.08] [&_pre]:p-4 [&_pre]:my-5 [&_pre]:rounded-xl [&_pre]:[direction:ltr] [&_pre]:text-left [&_code]:!text-[#ededed] [&_code]:!font-mono [&_code]:!bg-transparent [&_code]:!p-0 [&_code]:[direction:ltr] [&_blockquote]:border-l-2 [&_blockquote]:border-[#d97706] [&_blockquote]:bg-[#111317]/60 [&_blockquote]:p-3.5 [&_blockquote]:my-5 [&_blockquote]:rounded-r-xl [&_blockquote]:text-[#ededed]">
      <slot />
    </div>
  </article>
</Layout>
