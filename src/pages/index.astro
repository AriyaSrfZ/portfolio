---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BookingSection from '../components/BookingSection.astro';

const patterns = [
  {
    id: "payment-settlement",
    kicker: "01 // SYSTEM ARCHITECTURE",
    title: "Event-Driven Payment Settlement",
    desc: "Low-latency double-entry ledger handling zero-loss reconciliation under network partitioning with idempotent state machines.",
    diagram: "/diagrams/placeholder-2.svg",
    metrics: ["Sub-50ms p99 SLA", "Deterministic Reversals", "Zero-Loss Audit Trail"],
  },
  {
    id: "fraud-forensics",
    kicker: "02 // CONTROL LOOP & SECURITY",
    title: "Real-Time Fraud Detection & Forensic Tracing",
    desc: "Sliding-window transaction scoring engine coupled with asynchronous forensic trace graphs for real-time anomaly isolation.",
    diagram: "/diagrams/placeholder-1.svg",
    metrics: ["Async Graph Analysis", "Sub-10ms Rule Engine", "Dynamic Thresholds"],
  },
  {
    id: "sms-gateway-routing",
    kicker: "03 // TELECOM & DISTRIBUTED INFRA",
    title: "High-Throughput Multi-Carrier SMS Gateway",
    desc: "National scale multi-protocol (SMPP/HTTP) dispatch engine with dynamic operator failover and adaptive rate throttling.",
    diagram: "/diagrams/placeholder-3.svg",
    metrics: ["50K+ msg/sec Peak", "Dynamic LBS Routing", "Circuit-Breaker Recovery"],
  }
];
---

<Layout title="Ariya Sarrafzadeh | Systems Architecture & Product Specs">
  <!-- Progress bar tracker -->
  <div id="progress-bar" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-cyan-500 to-emerald-400 z-50 transition-all duration-75"></div>

  <Hero />

  <!-- 12-Column Technical Layout matching Agentic AI Spec -->
  <main class="max-w-7xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Sticky Sidebar (TOC) - 3 Columns -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 space-y-6">
        <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-4">
          <div class="text-[11px] font-mono font-bold text-cyan-400 tracking-wider uppercase mb-3">
            System Topology Index
          </div>
          <nav class="space-y-1 text-xs font-mono">
            <a href="#overview" class="block px-2.5 py-1.5 rounded text-slate-400 hover:text-white hover:bg-slate-800/60 transition">
              00 // ARCHITECTURE MATRIX
            </a>
            {patterns.map((p, idx) => (
              <a href={`#${p.id}`} class="block px-2.5 py-1.5 rounded text-slate-400 hover:text-white hover:bg-slate-800/60 transition">
                0{idx + 1} // {p.title.toUpperCase()}
              </a>
            ))}
            <a href="#book" class="block px-2.5 py-1.5 rounded text-slate-400 hover:text-white hover:bg-slate-800/60 transition">
              04 // DIRECT ENGAGEMENT
            </a>
          </nav>
        </div>

        <div class="bg-cyan-950/30 border border-cyan-800/40 rounded-xl p-4 text-xs font-mono text-cyan-300">
          <span class="block font-bold text-cyan-400 mb-1">🔍 Diagram Inspection</span>
          All architectural blueprints are deterministic SVGs rendered inline for low-overhead verification.
        </div>
      </aside>

      <!-- Main Specification Column - 9 Columns -->
      <div class="lg:col-span-9 space-y-16" id="blueprints">
        
        {patterns.map((item) => (
          <section id={item.id} class="bg-slate-900/40 border border-slate-800/90 rounded-2xl p-6 sm:p-8 hover:border-slate-700/80 transition-all">
            
            <div class="flex items-center gap-3 mb-2">
              <span class="font-mono text-xs text-cyan-400 tracking-wider font-semibold">{item.kicker}</span>
              <div class="h-px flex-1 bg-slate-800"></div>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-white font-mono mt-1">
              {item.title}
            </h2>

            <p class="text-slate-400 text-sm sm:text-base mt-3 leading-relaxed">
              {item.desc}
            </p>

            <!-- Metrics Matrix Strip -->
            <div class="flex flex-wrap gap-2 mt-4 mb-6">
              {item.metrics.map(m => (
                <span class="px-2.5 py-1 rounded bg-slate-950 border border-slate-800 text-[11px] font-mono text-emerald-400">
                  ✓ {m}
                </span>
              ))}
            </div>

            <!-- SVG Diagram Display Canvas -->
            <div class="relative bg-slate-950 border border-slate-800 rounded-xl p-4 overflow-hidden group">
              <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-900 text-xs font-mono text-slate-500">
                <span>CANVAS_TYPE: VECTOR_SVG</span>
                <span class="group-hover:text-cyan-400 transition-colors">RENDER: LIVE_SYSTEM</span>
              </div>
              <img
                src={item.diagram}
                alt={item.title}
                class="w-full h-auto max-h-[380px] object-contain mx-auto"
                loading="lazy"
              />
            </div>

          </section>
        ))}

        <section id="book">
          <BookingSection />
        </section>

      </div>

    </div>
  </main>

  <script>
    // Reading Progress Bar
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('progress-bar');
      if (bar) bar.style.width = scrolled + '%';
    });
  </script>
</Layout>
