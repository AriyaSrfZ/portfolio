---
import Layout from '../layouts/Layout.astro';
import LandingStage from '../components/react/LandingStage';
import ArchitectureSidebar from '../components/react/ArchitectureSidebar';
import BookingSection from '../components/BookingSection.astro';
import { stats } from '../data/stats';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Ariya Sarrafzadeh | Systems Architect & Infrastructure Engineer">
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-transparent via-white/50 to-transparent z-50 transition-all duration-100"></div>

  <main class="w-full max-w-[1920px] 2xl:max-w-[2160px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 pt-20 pb-16 font-sans" id="blueprints">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Sticky Sidebar Index & Minimized Bio -->
      <ArchitectureSidebar client:load locale="en" />

      <!-- Main Stage Pages (Executive Dossiers) -->
      <div class="lg:col-span-9 space-y-16">

        <!-- PAGE 01: EXECUTIVE LANDING OVERVIEW -->
        <LandingStage client:load locale="en" />

        <!-- PAGE 02: DOSSIER 01 - Double-Entry Ledger & Two-Phase Balance Engine -->
        <section id="payment-settlement" class="scroll-mt-20 min-h-[calc(100vh-5.5rem)] flex flex-col justify-between bg-[#0f1217]/90 border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl ring-1 ring-white/5 space-y-6 hover:border-white/20 transition-all">
      <!-- Header -->
      <div class="space-y-2">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2 font-mono text-xs text-neutral-400 uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>01 · SETTLEMENTS &amp; LEDGERS</span>
          </div>
          <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded">
            ACID LEDGER
          </span>
        </div>
        <h2 class="text-xl md:text-2xl font-bold text-white tracking-tight">
          The Double-Entry Ledger &amp; Two-Phase Balance Reservation Engine
        </h2>
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">Peak Throughput</span>
          <span class="text-white font-semibold">{stats.ledgerPeakTps.en}</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">Lock TTL</span>
          <span class="text-cyan-400 font-semibold">{stats.ledgerLockTtl.en}</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">Replay Window</span>
          <span class="text-white font-semibold">{stats.ledgerReplayWindow.en}</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">Financial Drift</span>
          <span class="text-emerald-400 font-semibold">{stats.financialDriftPercent.en}</span>
        </div>
      </div>

      <!-- Architecture Blueprint (Full-Width Interactive SVG Container) -->
      <div class="bg-[#13161c] border border-white/10 rounded-xl p-2 md:p-3 shadow-inner w-full">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-300 mb-2 px-2 pb-2 border-b border-white/5">
          <span class="tracking-wider uppercase">ARCHITECTURE BLUEPRINT · TOPOLOGY SCHEMATIC</span>
          <span class="text-emerald-400 font-semibold">2PC VERIFIED</span>
        </div>
        <img 
          src={`${baseUrl}diagrams/double-entry-ledger-schematic.svg?v=fintech-v3`} 
          alt="Double-Entry Ledger and Two-Phase Reservation Topology Schematic"
          class="w-full h-auto block rounded"
          loading="eager"
        />
      </div>

      <!-- 2-Column Technical Spec (Balanced 50/50 Grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <!-- Left: Invariants & Mechanism -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>Invariants &amp; Business Logic</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>Single Source of Financial Truth:</strong> Strict &Sigma; Debits &minus; &Sigma; Credits = 0 mathematical balance enforcement across ScyllaDB and PostgreSQL ACID fact tables.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>Two-Phase Reservation:</strong> Transitions capital from <code class="text-amber-400 font-mono text-xs bg-white/5 px-1 py-0.5 rounded">AVAILABLE</code> to <code class="text-cyan-400 font-mono text-xs bg-white/5 px-1 py-0.5 rounded">RESERVED</code> prior to dispatching upstream bank webhooks.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>Distributed Idempotency:</strong> Redis atomic <code class="text-white font-mono text-xs bg-white/5 px-1 py-0.5 rounded">SETNX</code> mutex locks keyed by UUIDv4 with a {stats.ledgerReplayWindow.textEn}.</span>
            </li>
          </ul>
        </div>

        <!-- Right: Failure Modes & Recovery -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>Failure Modes &amp; Recovery</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>Upstream Banking Timeouts:</strong> Handled via transactional outbox pattern and Raft-backed distributed state recovery, rejecting uncommitted transient states.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>Automated Rollback:</strong> Expired balance reservations automatically revert to <code class="text-white font-mono text-xs bg-white/5 px-1 py-0.5 rounded">AVAILABLE</code> upon receipt of failure webhooks or TTL expiry.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>Production Impact:</strong> 100% mathematical parity across {stats.reconciliationTrialEvents.en} with zero duplicate payouts during upstream PSP brownouts.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Product Decision Box -->
      <div class="bg-[#13161c]/80 border border-white/10 rounded-xl p-5 space-y-3">
        <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-[#38bdf8]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
          <span>Product Decision · DigiPay Core Ledger</span>
        </div>
        <div class="text-xs sm:text-sm text-neutral-300 space-y-2 leading-relaxed">
          <p><strong class="text-white">Why this, why then:</strong> Inconsistent ledger states and ghost balances during high-concurrency wallet checkouts threatened regulatory standing.</p>
          <p><strong class="text-white">What I traded off:</strong> Enforced strict synchronous two-phase balance reservation over raw optimistic write throughput.</p>
          <p><strong class="text-white">Who pushed back, and how it resolved:</strong> Growth stakeholders favored sub-10ms unreserved checkouts. I demonstrated that preventing unbacked overdraws was mandatory for Central Bank audit.</p>
          <p><strong class="text-white">Business result:</strong> Maintained {stats.reconMatchParity.textEn} across {stats.reconciliationTrialEvents.en} with zero duplicate payouts.</p>
        </div>
      </div>

      <!-- Footer Bar -->
      <div class="flex flex-wrap items-center justify-between pt-4 border-t border-white/5 gap-3 font-mono text-xs">
        <div class="flex flex-wrap gap-1.5">
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[ACID]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[2PC RESERVATION]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[REDIS SETNX]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[SCYLLADB]</span>
        </div>
        <a href={`${baseUrl}blog/payment-gateway/`} class="text-white hover:text-cyan-400 font-semibold inline-flex items-center gap-1 group transition-colors">
          <span>Read Full Whitepaper Specification</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <!-- Rolling Stepper Bar -->
      <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
        <a href="#overview" class="text-neutral-400 hover:text-white flex items-center gap-1.5 transition-colors">
          <span>↑</span>
          <span>Previous: Overview</span>
        </a>
        <span class="text-[10px] text-neutral-500 uppercase tracking-wider font-mono">SECTION 01</span>
        <a href="#payment-switch" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center gap-1.5 transition-all">
          <span>Next: Payment Switch</span>
          <span>↓</span>
        </a>
      </div>
    </section>


    <!-- DOSSIER 02: Smart PSP Switch & Dynamic Weighted Routing -->
    <section id="payment-switch" class="scroll-mt-20 min-h-[calc(100vh-5.5rem)] flex flex-col justify-between bg-[#0f1217]/90 border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl ring-1 ring-white/5 space-y-6 hover:border-white/20 transition-all">
      <!-- Header -->
      <div class="space-y-2">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2 font-mono text-xs text-neutral-300 uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>02 · PAYMENT SWITCH &amp; PROTOCOLS</span>
          </div>
          <span class="text-xs font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-2.5 py-0.5 rounded">
            ISO 8583 SWITCH
          </span>
        </div>
        <h2 class="text-xl md:text-2xl font-bold text-white tracking-tight">
          Smart PSP Switch &amp; Dynamic Weighted Routing Engine (ISO 8583)
        </h2>
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">Failover SLA</span>
          <span class="text-cyan-400 font-semibold text-sm">{stats.switchFailoverSla.en}</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">Protocol</span>
          <span class="text-white font-semibold text-sm">{stats.switchProtocolWireFormat.en}</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">Gateway Uptime</span>
          <span class="text-emerald-400 font-semibold text-sm">{stats.switchGatewayUptime.en}</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">Conversion Lift</span>
          <span class="text-emerald-400 font-semibold text-sm">{stats.switchConversionLift.en}</span>
        </div>
      </div>

      <!-- Architecture Blueprint (Full-Width Interactive SVG Container) -->
      <div class="bg-[#13161c] border border-white/10 rounded-xl p-2 md:p-3 shadow-inner w-full">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-300 mb-2 px-2 pb-2 border-b border-white/5">
          <span class="tracking-wider uppercase">MULTI-PSP HEAD-TO-HEAD (H2H) ROUTING PIPELINE</span>
          <span class="text-cyan-400 font-semibold">DYNAMIC WEIGHTED SLAS</span>
        </div>
        <img 
          src={`${baseUrl}diagrams/payment-switch-iso8583-pipeline.svg?v=fintech-v3`} 
          alt="Smart PSP Switch and ISO 8583 Pipeline Topology Schematic"
          class="w-full h-auto block rounded"
          loading="eager"
        />
      </div>

      <!-- 2-Column Technical Spec (Balanced 50/50 Grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <!-- Left: Invariants & Mechanism -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>Dynamic Routing Architecture</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>Head-to-Head (H2H) Switch:</strong> Unpacks ISO 8583 MTI 0200/0210 financial telegrams, parsing STAN, RRN, and terminal authentication headers in real time.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>Multi-PSP Orchestration:</strong> Dynamically balances checkout loads across SEP (Saman), PEC (Parsian), BPM (Mellat), and PEP (Pasargad) through Faravaran Hub adapters.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>Score-Based Weighting:</strong> Computes real-time gateway health scores factoring rolling P99 latency, success ratios, and merchant contractual fee tiers.</span>
            </li>
          </ul>
        </div>

        <!-- Right: Failure Modes & Recovery -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>Circuit Breakers &amp; Failover</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>Degraded Socket Shedding:</strong> Upstream network brownouts trigger automated circuit breakers shedding failing PSP connections in {stats.switchFailoverSla.textEn}.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>Zero User Drop:</strong> In-flight requests encountering network disconnects seamlessly reroute to secondary PSP backbones without requiring user re-entry.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>Telecom Throttling:</strong> Controls carrier SMPP 3.4 traffic with sliding window algorithms ({stats.incident02SlidingWindow.en}), preventing banking OTP delay under marketing spikes.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Product Decision Box -->
      <div class="bg-[#13161c]/80 border border-white/10 rounded-xl p-5 space-y-3">
        <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-[#38bdf8]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
          <span>Product Decision · Multi-PSP Switch</span>
        </div>
        <div class="text-xs sm:text-sm text-neutral-300 space-y-2 leading-relaxed">
          <p><strong class="text-white">Why this, why then:</strong> Single-PSP vendor lock-in created massive checkout drop-offs during bank maintenance windows and national clearing congestion.</p>
          <p><strong class="text-white">What I traded off:</strong> Built an agnostic multi-PSP switch topology with dynamic weight allocation rather than relying on a single PSP relationship.</p>
          <p><strong class="text-white">Who pushed back, and how it resolved:</strong> Legacy PSP account managers resisted routing diversification. I proved that dynamic failover boosted overall transaction conversion by {stats.switchConversionLift.raw}%.</p>
          <p><strong class="text-white">Business result:</strong> Achieved {stats.switchGatewayUptime.textEn}, sub-250ms roundtrip checkout latency, and {stats.switchFailoverSla.raw}ms automated failover during upstream provider outages.</p>
        </div>
      </div>

      <!-- Footer Bar -->
      <div class="flex flex-wrap items-center justify-between pt-4 border-t border-white/5 gap-3 font-mono text-xs">
        <div class="flex flex-wrap gap-1.5">
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[ISO 8583]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[FARAVARAN HUB]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[MULTI-PSP ROUTING]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[CIRCUIT BREAKER]</span>
        </div>
        <a href={`${baseUrl}blog/payment-gateway/`} class="text-white hover:text-cyan-400 font-semibold inline-flex items-center gap-1 group transition-colors">
          <span>Read Full Whitepaper Specification</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <!-- Rolling Stepper Bar -->
      <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
        <a href="#payment-settlement" class="text-neutral-400 hover:text-white flex items-center gap-1.5 transition-colors">
          <span>↑</span>
          <span>Previous: Settlements &amp; Ledgers</span>
        </a>
        <span class="text-[10px] text-neutral-500 uppercase tracking-wider font-mono">SECTION 02</span>
        <a href="#fraud-forensics" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center gap-1.5 transition-all">
          <span>Next: eKYC &amp; Fraud</span>
          <span>↓</span>
        </a>
      </div>
    </section>


    <!-- DOSSIER 03: eKYC, Central Bank Harim OTP & PCI-DSS Token Vault -->
    <section id="fraud-forensics" class="scroll-mt-20 min-h-[calc(100vh-5.5rem)] flex flex-col justify-between bg-[#0f1217]/90 border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl ring-1 ring-white/5 space-y-6 hover:border-white/20 transition-all">
      <!-- Header -->
      <div class="space-y-2">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2 font-mono text-xs text-neutral-300 uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>03 · FRAUD RISK &amp; EKYC</span>
          </div>
          <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded">
            PCI-DSS VAULT
          </span>
        </div>
        <h2 class="text-xl md:text-2xl font-bold text-white tracking-tight">
          eKYC, Central Bank Harim OTP &amp; PCI-DSS Token Vault
        </h2>
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">Risk Scoring SLA</span>
          <span class="text-emerald-400 font-semibold text-sm">{stats.fraudRiskLoopSla.en}</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">CVV2 Retention</span>
          <span class="text-white font-semibold text-sm">{stats.cvv2RetentionTime.en}</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">Fraud Reduction</span>
          <span class="text-emerald-400 font-semibold text-sm">{stats.fraudDrainReduction.en}</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">3DS Frictionless</span>
          <span class="text-cyan-400 font-semibold text-sm">{stats.frictionless3dsPassRate.en}</span>
        </div>
      </div>

      <!-- Architecture Blueprint (Full-Width Interactive SVG Container) -->
      <div class="bg-[#13161c] border border-white/10 rounded-xl p-2 md:p-3 shadow-inner w-full">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-300 mb-2 px-2 pb-2 border-b border-white/5">
          <span class="tracking-wider uppercase">PERIMETER ISOLATION &amp; EKYC VERIFICATION SCHEMATIC</span>
          <span class="text-emerald-400 font-semibold">PCI-DSS COMPLIANT</span>
        </div>
        <img 
          src={`${baseUrl}diagrams/fraud-tracing-architecture.svg?v=fintech-v3`} 
          alt="eKYC, Harim Dynamic OTP and Forensic Graph Tracing Schematic"
          class="w-full h-auto block rounded"
          loading="eager"
        />
      </div>

      <!-- 2-Column Technical Spec (Balanced 50/50 Grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <!-- Left: Invariants & Mechanism -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>Security Invariants &amp; eKYC</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>Zero-Storage Token Vault:</strong> Replaces raw PAN with opaque tokens; ephemeral CVV2 codes are purged immediately post-authorization per PCI-DSS.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>National eKYC Integration:</strong> Cryptographically queries Shahkar (SIM-to-National-ID) and Sabt-Ahval APIs, correlating SIM issuance timestamps with Harim OTP.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>Neo4j Graph Forensics:</strong> Computes real-time risk vectors [0.00, 1.00] across multi-hop card and device clusters in {stats.fraudRiskLoopSla.textEn}.</span>
            </li>
          </ul>
        </div>

