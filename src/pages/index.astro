---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BookingSection from '../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Ariya Sarrafzadeh | Systems Architect & Infrastructure Engineer">
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-transparent via-white/50 to-transparent z-50 transition-all duration-100"></div>

  <Hero />

  <main class="max-w-[1500px] mx-auto px-6 py-10 font-sans" id="blueprints">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Index -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-20 space-y-4">
        <div class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-4 shadow-2xl ring-1 ring-white/[0.03]">
          <div class="text-[11px] font-mono font-semibold text-[#ededed] uppercase tracking-wider mb-3 border-b border-white/[0.06] pb-2.5 flex justify-between items-center">
            <span>Architecture Index</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-pulse"></span>
          </div>
          
          <nav class="space-y-1 text-xs font-mono">
            <a href="#payment-settlement" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              01 · Dual-Entry Ledger &amp; 2PC
            </a>
            <a href="#fraud-forensics" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              02 · eKYC &amp; Token Vault
            </a>
            <a href="#payment-switch" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              03 · Smart PSP Switch &amp; ISO 8583
            </a>
            <a href="#reconciliation-engine" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              04 · Multi-Pass Reconciliation
            </a>
            <a href="#incident-dossiers" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              05 · Incident Postmortems
            </a>
            <a href="#lifecycle" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              06 · Product Delivery Arc
            </a>
            <a href={`${baseUrl}whitepapers/`} class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              07 · Engineering Whitepapers
            </a>
            <a href="#book" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              08 · Architecture Intake
            </a>
          </nav>
        </div>
      </aside>

      <!-- Main Blueprint Sections -->
      <div class="lg:col-span-9 space-y-8">
        
        <!-- SECTION 01: Double-Entry Ledger & Settlements -->
        <section id="payment-settlement" class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-7 shadow-2xl ring-1 ring-white/[0.03] transition-all duration-300 hover:border-white/15">
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-7 items-start">
            <!-- Left: Breakdown -->
            <div class="xl:col-span-7 space-y-3.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                <span class="text-[11px] font-mono uppercase tracking-wider text-[#94a3b8]">01 · Settlements &amp; Ledgers</span>
                <div class="h-px flex-1 bg-white/[0.06]"></div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400">DOSSIER 01</span>
              </div>

              <h2 class="text-xl sm:text-2xl font-bold text-[#ededed] tracking-tight">
                The Double-Entry Ledger &amp; Two-Phase Balance Reservation Engine
              </h2>

              <div class="p-3.5 bg-[#090a0c]/80 border border-white/[0.07] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">Architectural Invariant</span>
                <p class="text-[#ededed] font-mono text-[11px] leading-relaxed">
                  Single Source of Financial Truth. Zero double-settlements across 86,400s replay windows with two-phase balance reservation (AVAILABLE &rarr; RESERVED) and mathematical &Sigma; Debits &minus; &Sigma; Credits = 0 balance enforcement.
                </p>
              </div>

              <div class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed space-y-2">
                <p>
                  Client mutations enter via Spring Cloud Gateway with strict UUIDv4 <code class="text-[#ededed] font-mono text-[11px] bg-white/[0.04] px-1 py-0.5 rounded border border-white/[0.06]">Idempotency-Key</code> and Redis atomic <code class="text-[#ededed] font-mono text-[11px] bg-white/[0.04] px-1 py-0.5 rounded border border-white/[0.06]">SETNX</code> mutex locks (24h TTL). Direct balance allocations execute a Two-Phase Reservation State Machine transitioning funds from <code class="text-[#d97706] font-mono text-[11px] bg-white/[0.04] px-1 py-0.5 rounded border border-white/[0.06]">AVAILABLE</code> to <code class="text-neutral-200 font-mono text-[11px] bg-white/[0.04] px-1 py-0.5 rounded border border-white/[0.06]">RESERVED</code> status before dispatch. Final settlement writes append-only balanced debit/credit legs into an immutable ACID ledger in ScyllaDB and PostgreSQL, guaranteeing zero unrecorded floating capital.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-[#d97706]">Failure Mode &amp; Mitigation</span>
                <p class="text-[#94a3b8] leading-relaxed text-[11.5px]">
                  Partial network timeouts or broker partitions during multi-leg bank ledger updates. Solved by transactional outbox pattern and Raft-backed distributed state recovery, rejecting uncommitted transient states.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">Product Decision · DigiPay Core Ledger</span>
                <div class="text-[#cbd5e1] space-y-1 text-[11.5px] leading-relaxed">
                  <p><strong class="text-[#ededed]">Why this, why then:</strong> Inconsistent ledger states and ghost balances during high-concurrency wallet checkouts threatened regulatory standing.</p>
                  <p><strong class="text-[#ededed]">Tradeoff:</strong> Enforced strict synchronous two-phase balance reservation over raw optimistic write throughput.</p>
                  <p><strong class="text-[#ededed]">Outcome:</strong> 100% mathematical ledger parity across 50,000+ daily transactions with zero duplicate payouts.</p>
                </div>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-1">
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[ACID]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[2PC RESERVATION]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[REDIS SETNX]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[SCYLLADB]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[ZERO DRIFT]</span>
              </div>

              <div class="pt-2 flex items-center justify-between text-xs border-t border-white/[0.06]">
                <span class="text-neutral-500 font-mono text-[10px]">SPECIFICATION: DOSSIER 01</span>
                <a href={`${baseUrl}blog/payment-gateway/`} class="font-mono text-xs font-medium text-[#ededed] hover:text-white inline-flex items-center gap-1 group">
                  <span>Inspect Full Dossier</span>
                  <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Right: Flow Diagram & Parameters -->
            <div class="xl:col-span-5 space-y-3">
              <div class="bg-[#090a0c] border border-white/[0.08] rounded-xl p-3 sm:p-4 shadow-inner">
                <div class="flex items-center justify-between text-[10px] font-mono text-neutral-500 pb-2 border-b border-white/[0.06] mb-3">
                  <span>TOPOLOGY SCHEMATIC</span>
                  <span class="text-emerald-500">2PC · VERIFIED</span>
                </div>
                <img 
                  src={`${baseUrl}diagrams/double-entry-ledger-schematic.svg?v=fintech-2026`} 
                  alt="Double-Entry Ledger and Two-Phase Reservation Topology Schematic"
                  class="w-full h-auto object-contain rounded filter contrast-105"
                  loading="lazy"
                />
              </div>

              <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">REPLAY WINDOW</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">86,400s (24h)</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">MUTEX LOCK TTL</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">15,000ms</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">LEDGER STORE</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">ScyllaDB / Postgres</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">DRIFT AUDIT</div>
                  <div class="text-[#10b981] font-semibold mt-0.5">0.00 IRR (ZERO)</div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Divider -->
        <div class="flex items-center justify-center gap-4 my-1 opacity-60">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
          <span class="w-1.5 h-1.5 rounded-full bg-white/20"></span>
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
        </div>

        <!-- SECTION 02: Fraud Forensics & eKYC -->
        <section id="fraud-forensics" class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-7 shadow-2xl ring-1 ring-white/[0.03] transition-all duration-300 hover:border-white/15">
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-7 items-start">
            <!-- Left: Breakdown -->
            <div class="xl:col-span-7 space-y-3.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                <span class="text-[11px] font-mono uppercase tracking-wider text-[#94a3b8]">02 · Threat Isolation &amp; eKYC</span>
                <div class="h-px flex-1 bg-white/[0.06]"></div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400">DOSSIER 02</span>
              </div>

              <h2 class="text-xl sm:text-2xl font-bold text-[#ededed] tracking-tight">
                eKYC, Central Bank Harim OTP &amp; PCI-DSS Token Vault
              </h2>

              <div class="p-3.5 bg-[#090a0c]/80 border border-white/[0.07] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">Architectural Invariant</span>
                <p class="text-[#ededed] font-mono text-[11px] leading-relaxed">
                  Zero storage of raw CVV2/PIN data post-authorization (PCI-DSS compliance); Central Bank 4-parameter Harim OTP cryptographically bound to National Identity &amp; Card PAN.
                </p>
              </div>

              <div class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed space-y-2">
                <p>
                  Card data enters an isolated PCI-DSS bank demilitarized zone where the Token Vault exchanges raw PANs for opaque tokens; raw CVV2 codes are purged immediately after authorization. Seamlessly integrates national eKYC (Shahkar mobile-to-national-ID verification and Sabt-Ahval queries) with Central Bank Harim dynamic OTP services. Device intelligence and behavioral telemetry compute sub-15ms risk vectors [0.00, 1.00] in Neo4j graph clusters to trigger 3DS 2.0 biometric challenges or freeze illicit accounts.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-[#d97706]">Failure Mode &amp; Mitigation</span>
                <p class="text-[#94a3b8] leading-relaxed text-[11.5px]">
                  Distributed account takeovers, SIM-swap attacks, and dynamic OTP phishing rings. Mitigated by cryptographic correlation of Shahkar SIM issuance timestamp against dynamic Harim OTP generation requests.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">Product Decision · Bank Zone Compliance</span>
                <div class="text-[#cbd5e1] space-y-1 text-[11.5px] leading-relaxed">
                  <p><strong class="text-[#ededed]">Why this, why then:</strong> Static rules caused high false positives and fraudsters exploited SIM-swap delays to bypass legacy OTPs.</p>
                  <p><strong class="text-[#ededed]">Tradeoff:</strong> Refused to cache CVV2 credentials for one-click checkout convenience, enforcing strict zero-storage PCI-DSS tokenization.</p>
                  <p><strong class="text-[#ededed]">Outcome:</strong> Slashed illicit drain by 94 percent while shifting financial liability to issuing banks via 3DS 2.0.</p>
                </div>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-1">
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[PCI-DSS]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[HARIM OTP]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[SHAHKAR eKYC]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[NEO4J FORENSICS]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[<15MS RISK LOOP]</span>
              </div>

              <div class="pt-2 flex items-center justify-between text-xs border-t border-white/[0.06]">
                <span class="text-neutral-500 font-mono text-[10px]">SPECIFICATION: DOSSIER 02</span>
                <a href={`${baseUrl}blog/fraud-tracing/`} class="font-mono text-xs font-medium text-[#ededed] hover:text-white inline-flex items-center gap-1 group">
                  <span>Inspect Full Dossier</span>
                  <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Right: Flow Diagram & Parameters -->
            <div class="xl:col-span-5 space-y-3">
              <div class="bg-[#090a0c] border border-white/[0.08] rounded-xl p-3 sm:p-4 shadow-inner">
                <div class="flex items-center justify-between text-[10px] font-mono text-neutral-500 pb-2 border-b border-white/[0.06] mb-3">
                  <span>THREAT TOPOLOGY</span>
                  <span class="text-emerald-500">PCI-DSS · ISOLATED</span>
                </div>
                <img 
                  src={`${baseUrl}diagrams/fraud-tracing-architecture.svg?v=fintech-2026`} 
                  alt="eKYC, Harim Dynamic OTP and Forensic Graph Tracing Schematic"
                  class="w-full h-auto object-contain rounded filter contrast-105"
                  loading="lazy"
                />
              </div>

              <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">RISK EVAL SLA</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">&lt;15ms (P99)</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">CVV2 RETENTION</div>
                  <div class="text-[#10b981] font-semibold mt-0.5">0.00s (EPHEMERAL)</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">IDENTITY ENGINE</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">Shahkar / Sabt-Ahval</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">FRAUD DRAIN DROP</div>
                  <div class="text-[#10b981] font-semibold mt-0.5">-94% VERIFIED</div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Divider -->
        <div class="flex items-center justify-center gap-4 my-1 opacity-60">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
          <span class="w-1.5 h-1.5 rounded-full bg-white/20"></span>
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
        </div>

        <!-- SECTION 03: Smart PSP Switch & Dynamic Weighted Routing -->
        <section id="payment-switch" class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-7 shadow-2xl ring-1 ring-white/[0.03] transition-all duration-300 hover:border-white/15">
          <span id="sms-gateway" class="sr-only"></span>
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-7 items-start">
            <!-- Left: Breakdown -->
            <div class="xl:col-span-7 space-y-3.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                <span class="text-[11px] font-mono uppercase tracking-wider text-[#94a3b8]">03 · Payment Switch &amp; Routing</span>
                <div class="h-px flex-1 bg-white/[0.06]"></div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400">DOSSIER 03</span>
              </div>

              <h2 class="text-xl sm:text-2xl font-bold text-[#ededed] tracking-tight">
                Smart PSP Switch &amp; Dynamic Weighted Routing Engine
              </h2>

              <div class="p-3.5 bg-[#090a0c]/80 border border-white/[0.07] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">Architectural Invariant</span>
                <p class="text-[#ededed] font-mono text-[11px] leading-relaxed">
                  Sub-30ms automated gateway failover; dynamic traffic distribution across 4 national PSPs (SEP, PEC, BPM, PEP) and Faravaran Hub with 99.99% payment switch uptime.
                </p>
              </div>

              <div class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed space-y-2">
                <p>
                  Enterprise Head-to-Head (H2H) switch unpacking ISO 8583 MTI 0200/0210 financial telegrams. Dynamic weighted routing algorithm evaluates real-time PSP success rates, rolling P99 latency, merchant contractual fee tiers, and bank maintenance windows to steer traffic across SEP (Saman), PEC (Parsian), BPM (Behpardakht Mellat), and PEP (Pasargad). Integrated Faravaran Hub adapters and automated circuit breakers drop degraded connections in sub-30ms to prevent checkout drops.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-[#d97706]">Failure Mode &amp; Mitigation</span>
                <p class="text-[#94a3b8] leading-relaxed text-[11.5px]">
                  Upstream PSP network brownouts and partial HTTP/socket hangs. Resolved through active sliding-window health probes, circuit breaker shedding, and instant fallback to secondary PSP routes within 30ms SLA.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">Product Decision · Multi-PSP Switch</span>
                <div class="text-[#cbd5e1] space-y-1 text-[11.5px] leading-relaxed">
                  <p><strong class="text-[#ededed]">Why this, why then:</strong> Single-PSP vendor lock-in created massive checkout drop-offs during bank maintenance windows and national clearing congestion.</p>
                  <p><strong class="text-[#ededed]">Tradeoff:</strong> Built an agnostic multi-PSP switch topology with dynamic weight allocation rather than relying on a single PSP relationship.</p>
                  <p><strong class="text-[#ededed]">Outcome:</strong> Achieved 99.99% gateway availability, sub-250ms roundtrip checkout latency, and 30ms automated failover during upstream provider outages.</p>
                </div>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-1">
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[ISO 8583]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[MTI 0200/0210]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[FARAVARAN HUB]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[MULTI-PSP ROUTING]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[30MS FAILOVER]</span>
              </div>

              <div class="pt-2 flex items-center justify-between text-xs border-t border-white/[0.06]">
                <span class="text-neutral-500 font-mono text-[10px]">SPECIFICATION: DOSSIER 03</span>
                <a href={`${baseUrl}blog/sms-infrastructure/`} class="font-mono text-xs font-medium text-[#ededed] hover:text-white inline-flex items-center gap-1 group">
                  <span>Inspect Full Dossier</span>
                  <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Right: Flow Diagram & Parameters -->
            <div class="xl:col-span-5 space-y-3">
