          <!-- Linked SVG Diagram -->
          <div class="bg-[#0b1120]/80 border border-white/10 rounded-xl p-3 sm:p-5 my-4 overflow-hidden">
            <img 
              src={`${baseUrl}diagrams/payment-switch-architecture.svg?v=fintech-2026`} 
              alt="Payment Switch and Settlement Engine Topology Schematic"
              class="w-full h-auto object-contain rounded-lg"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex flex-wrap justify-between items-center gap-2 text-xs">
            <span class="text-[#94a3b8]">Full protocol specification documented in Dossier 01.</span>
            <a href={`${baseUrl}blog/payment-gateway/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold uppercase transition-all duration-300 hover:border-[#06b6d4] hover:bg-[#06b6d4]/10 hover:translate-x-0.5 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-[#06b6d4]">
              Open Spec 01 Dossier &rarr;
            </a>
          </div>
        </section>

        <!-- SECTION 02: Fraud Forensics -->
        <section id="fraud-forensics" class="bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase font-mono">02 · Threat Isolation & Surveillance</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">Real-Time Fraud Mitigation &amp; Forensic Graph Tracing</h2>
          
          <!-- Invariant Box: Refined Badge -->
          <div class="mt-4 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">Architectural Invariant</span>
            </div>
            <p class="text-[#f8fafc] font-mono leading-relaxed">Checkout latency &lt; 15ms SLA; dispute packet must withstand judicial intake.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              Ingress extracts canvas entropy, device acceleration, and typing cadence to generate high-dimensional risk vectors [0.00, 1.00] in sub-15ms. Transactions under 0.30 execute friction-free; 0.30–0.75 triggers biometric 3DS 2.0 (shifting financial liability to issuing banks); &gt;0.75 quarantines into forensic Neo4j graph clusters.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge -->
          <div class="mt-3 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
