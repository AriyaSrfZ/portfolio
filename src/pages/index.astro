---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BookingSection from '../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Ariya Sarrafzadeh | Systems Architect & Infrastructure Engineer">
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-[#06b6d4] via-[#e2c974] to-[#38bdf8] z-50 transition-all duration-100"></div>

  <Hero />

  <main class="max-w-[1600px] mx-auto px-6 py-12 font-sans" id="blueprints">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Index -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 space-y-4">
        <div class="bg-[#111827]/70 backdrop-blur-xl border border-white/10 rounded-2xl p-5 shadow-2xl ring-1 ring-white/5">
          <div class="text-xs font-semibold text-[#e2c974] tracking-wider uppercase mb-3 border-b border-white/10 pb-2.5 flex justify-between items-center">
            <span>Architecture Index</span>
            <span class="w-2 h-2 rounded-full bg-[#38bdf8] shadow-[0_0_8px_rgba(201,212,168,0.6)] animate-signal"></span>
          </div>
          
          <nav class="space-y-1 text-xs">
            <a href="#payment-settlement" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              01 · Settlements
            </a>
            <a href="#fraud-forensics" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              02 · Fraud &amp; eKYC
            </a>
            <a href="#payment-switch" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              03 · Smart PSP Switch
            </a>
            <a href="#reconciliation-engine" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              04 · Multi-Pass Reconciliation
            </a>
            <a href="#incident-dossiers" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              05 · Incident Dossiers
            </a>
            <a href="#lifecycle" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              06 · Product Lifecycle
            </a>
            <a href={`${baseUrl}whitepapers/`} class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              07 · Technical Whitepapers
            </a>
            <a href="#book" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              08 · Architecture Intake
            </a>
          </nav>
        </div>
      </aside>

      <!-- Main Blueprint Sections -->
      <div class="lg:col-span-9 space-y-10">
        
        <!-- SECTION 01: Double-Entry Ledger & Settlements -->
        <section id="payment-settlement" class="bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase font-mono">01 · Settlements &amp; Ledgers</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">The Double-Entry Ledger &amp; Two-Phase Balance Reservation Engine</h2>
          
          <!-- Invariant Box: Refined Badge (No side-tab slop) -->
          <div class="mt-4 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">Architectural Invariant</span>
            </div>
            <p class="text-[#f8fafc] font-mono leading-relaxed">Single Source of Financial Truth. Zero double-settlements across 86,400s replay windows with two-phase balance reservation (AVAILABLE &rarr; RESERVED) and mathematical &Sigma; Debits &minus; &Sigma; Credits = 0 balance enforcement.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              Client mutations enter via Spring Cloud Gateway with strict UUIDv4 <code class="text-[#38bdf8] font-mono text-[11px]">Idempotency-Key</code> and Redis atomic <code class="text-[#38bdf8] font-mono text-[11px]">SETNX</code> mutex locks (24h TTL). Direct balance allocations execute a Two-Phase Reservation State Machine transitioning funds from <code class="text-[#e2c974] font-mono text-[11px]">AVAILABLE</code> to <code class="text-[#06b6d4] font-mono text-[11px]">RESERVED</code> status before dispatch. Final settlement writes append-only balanced debit/credit legs into an immutable ACID ledger in ScyllaDB and PostgreSQL, guaranteeing zero unrecorded floating capital.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge (No side-tab slop) -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974]"></span>
              <span class="text-[#e2c974] font-bold uppercase tracking-wider">Failure Mode &amp; Mitigation</span>
            </div>
            <p class="text-[#94a3b8] leading-relaxed">
              Partial network timeouts or broker partitions during multi-leg bank ledger updates. Solved by transactional outbox pattern and Raft-backed distributed state recovery, rejecting uncommitted transient states.
            </p>
          </div>

          <!-- Product Decision: Refined Badge -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
              <span class="text-[#38bdf8] font-bold uppercase tracking-wider font-mono">Product Decision · DigiPay Core Ledger</span>
            </div>
            <div class="text-[#cbd5e1] space-y-1.5 leading-relaxed">
              <p><strong class="text-[#f8fafc]">Why this, why then:</strong> Inconsistent ledger states and ghost balances during high-concurrency wallet checkouts threatened regulatory standing.</p>
              <p><strong class="text-[#f8fafc]">What I traded off:</strong> Enforced strict synchronous two-phase balance reservation over raw optimistic write throughput.</p>
              <p><strong class="text-[#f8fafc]">Who pushed back, and how it resolved:</strong> Growth stakeholders favored sub-10ms unreserved checkouts. I demonstrated that preventing unbacked overdraws was mandatory for Central Bank audit.</p>
              <p><strong class="text-[#f8fafc]">Business result:</strong> Maintained 100% mathematical ledger parity across 50,000+ daily transactions with zero duplicate payouts.</p>
            </div>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-5">
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Double-Entry Ledger</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Two-Phase Reservation</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">ACID Compliance</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Redis SETNX Idempotency</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">ScyllaDB Fact Store</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl p-3 sm:p-5 my-4 overflow-hidden">
            <img 
              src={`${baseUrl}diagrams/double-entry-ledger-schematic.svg?v=fintech-2026`} 
              alt="Double-Entry Ledger and Two-Phase Reservation Topology Schematic"
              class="w-full h-auto object-contain rounded-lg"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex flex-wrap justify-between items-center gap-2 text-xs">
            <span class="text-[#94a3b8]">Full protocol specification documented in Dossier 01.</span>
            <a href={`${baseUrl}blog/payment-gateway/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold uppercase transition-all duration-300 active:scale-[0.98] hover:-translate-y-1 hover:shadow-2xl hover:border-[#06b6d4]/40 hover:bg-[#06b6d4]/10 focus-visible:outline-2 focus-visible:outline-[#06b6d4]">
              Open Spec 01 Dossier &rarr;
            </a>
          </div>
        </section>

        
        <div class="flex items-center justify-center gap-4 my-2">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
          <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]/40"></span>
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
        </div>


        <!-- SECTION 02: Fraud Forensics & eKYC -->
        <section id="fraud-forensics" class="bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase font-mono">02 · Threat Isolation &amp; eKYC</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">eKYC, Central Bank Harim OTP &amp; PCI-DSS Token Vault</h2>
          
          <!-- Invariant Box: Refined Badge -->
          <div class="mt-4 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">Architectural Invariant</span>
            </div>
            <p class="text-[#f8fafc] font-mono leading-relaxed">Zero storage of raw CVV2/PIN data post-authorization (PCI-DSS compliance); Central Bank 4-parameter Harim OTP bound to National Identity &amp; Card PAN.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              Card data enters an isolated PCI-DSS bank demilitarized zone where the Token Vault exchanges raw PANs for opaque tokens; raw CVV2 codes are purged immediately after authorization. Seamlessly integrates national eKYC (Shahkar mobile-to-national-ID verification and Sabt-Ahval queries) with Central Bank Harim dynamic OTP services. Device intelligence and behavioral telemetry compute sub-15ms risk vectors [0.00, 1.00] in Neo4j graph clusters to trigger 3DS 2.0 biometric challenges or freeze illicit accounts.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974]"></span>
              <span class="text-[#e2c974] font-bold uppercase tracking-wider">Failure Mode &amp; Mitigation</span>
            </div>
            <p class="text-[#94a3b8] leading-relaxed">
              Distributed account takeovers, SIM-swap attacks, and dynamic OTP phishing rings. Mitigated by cryptographic correlation of Shahkar SIM issuance timestamp against dynamic Harim OTP generation requests.
            </p>
          </div>

          <!-- Product Decision: Refined Badge -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
              <span class="text-[#38bdf8] font-bold uppercase tracking-wider font-mono">Product Decision · Bank Zone Compliance</span>
            </div>
            <div class="text-[#cbd5e1] space-y-1.5 leading-relaxed">
              <p><strong class="text-[#f8fafc]">Why this, why then:</strong> Static rules caused high false positives and fraudsters exploited SIM-swap delays to bypass legacy OTPs.</p>
              <p><strong class="text-[#f8fafc]">What I traded off:</strong> Refused to cache CVV2 credentials for one-click checkout convenience, enforcing strict zero-storage PCI-DSS tokenization.</p>
              <p><strong class="text-[#f8fafc]">Who pushed back, and how it resolved:</strong> Commercial teams pushed for frictionless CVV2 storage. I proved the liability of regulatory penalties and card credential breach far outweighed the checkout friction.</p>
              <p><strong class="text-[#f8fafc]">Business result:</strong> Slashed illicit drain by 94 percent while shifting financial liability to issuing banks via 3DS 2.0.</p>
            </div>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-5">
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Zero-Storage CVV2 Vault</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Harim Dynamic OTP</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Shahkar National eKYC</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">PCI-DSS Compliance</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Neo4j Graph Forensics</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl p-3 sm:p-5 my-4 overflow-hidden">
            <img 
              src={`${baseUrl}diagrams/fraud-tracing-architecture.svg?v=fintech-2026`} 
              alt="eKYC, Harim Dynamic OTP and Forensic Graph Tracing Schematic"
              class="w-full h-auto object-contain rounded-lg"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex flex-wrap justify-between items-center gap-2 text-xs">
            <span class="text-[#94a3b8]">Detailed mitigation logic documented in Dossier 02.</span>
            <a href={`${baseUrl}blog/fraud-tracing/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold uppercase transition-all duration-300 active:scale-[0.98] hover:-translate-y-1 hover:shadow-2xl hover:border-[#06b6d4]/40 hover:bg-[#06b6d4]/10 focus-visible:outline-2 focus-visible:outline-[#06b6d4]">
              Open Spec 02 Dossier &rarr;
            </a>
          </div>
        </section>

        
        <div class="flex items-center justify-center gap-4 my-2">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
          <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]/40"></span>
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
        </div>


        <!-- SECTION 03: Smart PSP Switch & Dynamic Weighted Routing -->
        <section id="payment-switch" class="bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <span id="sms-gateway" class="sr-only"></span>
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase font-mono">03 · Payment Switch &amp; Routing</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">Smart PSP Switch &amp; Dynamic Weighted Routing Engine</h2>
          
          <!-- Invariant Box: Refined Badge -->
          <div class="mt-4 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">Architectural Invariant</span>
            </div>
            <p class="text-[#f8fafc] font-mono leading-relaxed">Sub-30ms automated gateway failover; dynamic traffic distribution across 4 national PSPs (SEP, PEC, BPM, PEP) and Faravaran Hub with 99.99% payment switch uptime.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              Enterprise Head-to-Head (H2H) switch unpacking ISO 8583 MTI 0200/0210 financial telegrams. Dynamic weighted routing algorithm evaluates real-time PSP success rates, rolling P99 latency, merchant contractual fee tiers, and bank maintenance windows to steer traffic across SEP (Saman), PEC (Parsian), BPM (Behpardakht Mellat), and PEP (Pasargad). Integrated Faravaran Hub adapters and automated circuit breakers drop degraded connections in sub-30ms to prevent checkout drops.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974]"></span>
              <span class="text-[#e2c974] font-bold uppercase tracking-wider">Failure Mode &amp; Mitigation</span>
            </div>
            <p class="text-[#94a3b8] leading-relaxed">
              Upstream PSP network brownouts and partial HTTP/socket hangs. Resolved through active sliding-window health probes, circuit breaker shedding, and instant fallback to secondary PSP routes within 30ms SLA.
            </p>
          </div>

          <!-- Product Decision: Refined Badge -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
              <span class="text-[#38bdf8] font-bold uppercase tracking-wider font-mono">Product Decision · Multi-PSP Switch</span>
            </div>
            <div class="text-[#cbd5e1] space-y-1.5 leading-relaxed">
              <p><strong class="text-[#f8fafc]">Why this, why then:</strong> Single-PSP vendor lock-in created massive checkout drop-offs during bank maintenance windows and national clearing congestion.</p>
              <p><strong class="text-[#f8fafc]">What I traded off:</strong> Built an agnostic multi-PSP switch topology with dynamic weight allocation rather than relying on a single PSP relationship.</p>
              <p><strong class="text-[#f8fafc]">Who pushed back, and how it resolved:</strong> Legacy PSP account managers resisted routing diversification. I proved that dynamic failover boosted overall transaction conversion by 14%.</p>
              <p><strong class="text-[#f8fafc]">Business result:</strong> Achieved 99.99% gateway availability, sub-250ms roundtrip checkout latency, and 30ms automated failover during upstream provider outages.</p>
            </div>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-5">
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Smart PSP Switch</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Dynamic Weighted Routing</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Faravaran Hub Integration</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">ISO 8583 H2H Pipeline</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">Sub-30ms Failover SLA</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl p-3 sm:p-5 my-4 overflow-hidden">
            <img 
              src={`${baseUrl}diagrams/payment-switch-iso8583-pipeline.svg?v=fintech-2026`} 
              alt="Smart PSP Switch and ISO 8583 Pipeline Topology Schematic"
              class="w-full h-auto object-contain rounded-lg"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex flex-wrap justify-between items-center gap-2 text-xs">
            <span class="text-[#94a3b8]">Smart PSP Switch and ISO 8583 specs documented in Dossier 03.</span>
            <a href={`${baseUrl}blog/sms-infrastructure/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold uppercase transition-all duration-300 active:scale-[0.98] hover:-translate-y-1 hover:shadow-2xl hover:border-[#06b6d4]/40 hover:bg-[#06b6d4]/10 focus-visible:outline-2 focus-visible:outline-[#06b6d4]">
              Open Spec 03 Dossier &rarr;
            </a>
          </div>
        </section>

        
        <div class="flex items-center justify-center gap-4 my-2">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
          <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]/40"></span>
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
        </div>


        <!-- SECTION 04: Multi-Pass Reconciliation & Early Merchant Settlement -->
        <section id="reconciliation-engine" class="bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <span id="data-pipeline" class="sr-only"></span>
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase font-mono">04 · Multi-Pass Reconciliation</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">Event-Driven Multi-Pass Reconciliation &amp; Early Merchant Settlement</h2>
          
          <!-- Invariant Box: Refined Badge -->
          <div class="mt-4 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
