---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BookingSection from '../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Ariya Sarrafzadeh | Systems Architect & Infrastructure Engineer">
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-[#06b6d4] via-[#e2c974] to-[#38bdf8] z-50 transition-all duration-100"></div>

  <Hero />

  <main class="max-w-[1600px] mx-auto px-6 py-12 font-sans" id="blueprints">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Index -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 space-y-4">
        <div class="bg-[#111827]/70 backdrop-blur-xl border border-white/10 rounded-2xl p-5 shadow-2xl ring-1 ring-white/5">
          <div class="text-xs font-semibold text-[#e2c974] tracking-wider uppercase mb-3 border-b border-white/10 pb-2.5 flex justify-between items-center">
            <span>Architecture Index</span>
            <span class="w-2 h-2 rounded-full bg-[#38bdf8] shadow-[0_0_8px_rgba(201,212,168,0.6)] animate-signal"></span>
          </div>
          
          <nav class="space-y-1 text-xs">
            <a href="#payment-settlement" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              01 · Settlements
            </a>
            <a href="#fraud-forensics" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              02 · Fraud Risk
            </a>
            <a href="#sms-gateway" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              03 · SMS Switch
            </a>
            <a href="#data-pipeline" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              04 · Data Pipeline
            </a>
            <a href="#incident-dossiers" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              05 · Incident Dossiers
            </a>
            <a href="#lifecycle" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              06 · Product Lifecycle
            </a>
            <a href={`${baseUrl}whitepapers/`} class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              07 · Technical Whitepapers
            </a>
            <a href="#book" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              08 · Architecture Intake
            </a>
          </nav>
        </div>
      </aside>

      <!-- Main Blueprint Sections -->
      <div class="lg:col-span-9 space-y-10">
        
        <!-- SECTION 01: Payment Settlement -->
        <section id="payment-settlement" class="bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase font-mono">01 · Transaction Routing & Ledgers</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">Event-Driven Payment Settlement Engine</h2>
          
          <!-- Invariant Box: Refined Badge (No side-tab slop) -->
          <div class="mt-4 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">Architectural Invariant</span>
            </div>
            <p class="text-[#f8fafc] font-mono leading-relaxed">Request State &ne; Settlement Fact. Zero double-settlements across 86,400s replay windows.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              TLS 1.3 ingress claims an atomic Redis distributed lock (<code class="text-[#e2c974] bg-white/[0.04] px-1.5 py-0.5 rounded">SETNX</code>, TTL 86,400s). Payloads serialize into ISO 8583 binary bitmaps for direct host-to-host clearing switches. Balances compute strictly through append-only log replay across an ACID-compliant ScyllaDB cluster.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge (No side-tab slop) -->
          <div class="mt-3 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974]"></span>
              <span class="text-[#e2c974] font-bold uppercase tracking-wider">Failure Mode &amp; Mitigation</span>
            </div>
            <p class="text-[#94a3b8] leading-relaxed">
              Network drops between gateway and upstream clearing switch. Zero duplicate charges via replay isolation; automatic 0420 reverse commits post as a new immutable ledger row without state overwrites.
            </p>
          </div>

          <!-- Product Decision: Refined Badge -->
          <div class="mt-3 p-4 bg-[#0b1120]/70 border border-white/10 border-dashed rounded-xl text-xs space-y-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
                <span class="text-[#38bdf8] font-bold uppercase tracking-wider font-mono">Product Decision</span>
              </div>
              <span class="text-[10px] text-[#94a3b8] font-mono uppercase px-2 py-0.5 rounded bg-white/[0.04] border border-white/5">Draft — pending real content</span>
            </div>
            <div class="text-[#94a3b8] space-y-1.5 leading-relaxed">
