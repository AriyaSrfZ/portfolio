          </div>

          <div class="mt-4 flex flex-wrap justify-between items-center gap-2 text-xs">
            <span class="text-[#94a3b8]">Detailed mitigation logic documented in Dossier 02.</span>
            <a href={`${baseUrl}blog/fraud-tracing/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold uppercase transition-all duration-300 hover:border-[#06b6d4] hover:bg-[#06b6d4]/10 hover:translate-x-0.5 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-[#06b6d4]">
