---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BookingSection from '../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Ariya Sarrafzadeh | Systems Architect & Infrastructure Engineer">
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-[#c4562e] z-50 transition-all duration-75"></div>

  <Hero />

  <main class="max-w-[1600px] mx-auto px-6 py-10 font-['IBM_Plex_Mono',monospace]" id="blueprints">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Index (Strict 01 to 06 sequence) -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-20 space-y-4">
        <div class="relative bg-[#1c1916] border border-[#5c6650] p-4 shadow-xl rugged-hatch rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="text-[11px] font-bold text-[#c9a15a] tracking-widest uppercase mb-3 border-b border-[#5c6650] pb-2 flex justify-between items-center">
            <span>SYSTEM INDEX</span>
            <span class="w-1.5 h-1.5 bg-[#c9d4a8] animate-signal"></span>
          </div>
          
          <nav class="space-y-1.5 text-xs">
            <a href="#payment-settlement" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-l border-transparent hover:border-[#c4562e]">
              01 // Settlements
            </a>
            <a href="#fraud-forensics" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-l border-transparent hover:border-[#c4562e]">
              02 // Fraud Risk
            </a>
            <a href="#sms-gateway" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-l border-transparent hover:border-[#c4562e]">
              03 // SMS Switch
            </a>
            <a href="#data-pipeline" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-l border-transparent hover:border-[#c4562e]">
              04 // Data Pipeline
            </a>
            <a href="#incident-dossiers" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-l border-transparent hover:border-[#c4562e]">
              05 // Incident Dossiers
            </a>
            <a href={`${baseUrl}whitepapers/`} class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-l border-transparent hover:border-[#c4562e]">
              06 // Whitepapers (4)
            </a>
            <a href="#book" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-l border-transparent hover:border-[#c4562e]">
              07 // Architecture Intake
            </a>
          </nav>
        </div>
      </aside>

      <!-- Main Blueprint Sections -->
      <div class="lg:col-span-9 space-y-10">
        
        <!-- SECTION 01: Payment Settlement -->
        <section id="payment-settlement" class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-8 rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">01 // TRANSACTION ROUTING &amp; LEDGERS</span>
            <div class="h-px flex-1 bg-[#5c6650]"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#e8e2d5] uppercase">Event-Driven Payment Settlement Engine</h2>
          
          <!-- Invariant Box -->
          <div class="mt-4 p-3 bg-[#141210] border-l-2 border-[#c4562e] text-xs space-y-1">
            <span class="text-[#c4562e] font-bold uppercase tracking-wider block">Architectural Invariant</span>
            <p class="text-[#e8e2d5] font-mono">Request State &ne; Settlement Fact. Zero double-settlements across 86,400s replay windows.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#a8a196] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              TLS 1.3 ingress claims an atomic Redis distributed lock (<code class="text-[#c9a15a]">SETNX</code>, TTL 86,400s). Payloads serialize into ISO 8583 binary bitmaps for direct host-to-host clearing switches. Balances compute strictly through append-only log replay across an ACID-compliant ScyllaDB cluster.
            </p>
          </div>

          <!-- Failure Mode -->
          <div class="mt-3 p-3 bg-[#141210] border-l-2 border-[#c9a15a] text-xs space-y-1">
            <span class="text-[#c9a15a] font-bold uppercase tracking-wider block">Failure Mode &amp; Mitigation</span>
            <p class="text-[#a8a196] leading-relaxed">
              Network drops between gateway and upstream clearing switch. Zero duplicate charges via replay isolation; automatic 0420 reverse commits post as a new immutable ledger row without state overwrites.
            </p>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-4">
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">Sub-50ms SLA</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">Redis O(1) Idempotency</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">ISO 8583 Bitmaps</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">ScyllaDB Double-Entry</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210] border border-[#5c6650] p-2 sm:p-4 my-4 overflow-hidden rounded-none">
            <img 
              src={`${baseUrl}diagrams/placeholder-1.svg`} 
              alt="Payment Switch and Settlement Engine Topology Schematic"
              class="w-full h-auto object-contain rounded-none"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex justify-between items-center text-xs">
            <span class="text-[#a8a196]">Full protocol specification documented in Dossier 01.</span>
            <a href={`${baseUrl}whitepapers/payment-gateway.html`} class="text-[#c4562e] font-bold hover:underline uppercase">
              Open Spec 01 Dossier &rarr;
            </a>
          </div>
        </section>

        <!-- SECTION 02: Fraud Forensics -->
        <section id="fraud-forensics" class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-8 rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">02 // SURVEILLANCE &amp; THREAT ISOLATION</span>
            <div class="h-px flex-1 bg-[#5c6650]"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#e8e2d5] uppercase">Real-Time Fraud Mitigation &amp; Forensic Graph Tracing</h2>
          
          <!-- Invariant Box -->
          <div class="mt-4 p-3 bg-[#141210] border-l-2 border-[#c4562e] text-xs space-y-1">
            <span class="text-[#c4562e] font-bold uppercase tracking-wider block">Architectural Invariant</span>
            <p class="text-[#e8e2d5] font-mono">Checkout latency &lt; 15ms SLA; dispute packet must withstand judicial intake.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#a8a196] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              Ingress extracts canvas entropy, device acceleration, and typing cadence to generate high-dimensional risk vectors [0.00, 1.00] in sub-15ms. Transactions under 0.30 execute friction-free; 0.30–0.75 triggers biometric 3DS 2.0 (shifting financial liability to issuing banks); &gt;0.75 quarantines into forensic Neo4j graph clusters.
            </p>
          </div>

          <!-- Failure Mode -->
          <div class="mt-3 p-3 bg-[#141210] border-l-2 border-[#c9a15a] text-xs space-y-1">
            <span class="text-[#c9a15a] font-bold uppercase tracking-wider block">Failure Mode &amp; Mitigation</span>
            <p class="text-[#a8a196] leading-relaxed">
              Distributed account takeover and promo abuse rings. Heuristic bypasses eliminated by recursive money-flow tracing across 40+ microservices in Neo4j.
            </p>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-4">
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">Sub-15ms Risk Loop</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">3DS 2.0 Liability Shift</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">&lt; 0.5% False Positives</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">Neo4j Forensic Graph</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210] border border-[#5c6650] p-2 sm:p-4 my-4 overflow-hidden rounded-none">
            <img 
              src={`${baseUrl}diagrams/placeholder-2.svg`} 
              alt="Real-Time Fraud Mitigation and Forensic Graph Tracing Schematic"
              class="w-full h-auto object-contain rounded-none"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex justify-between items-center text-xs">
            <span class="text-[#a8a196]">Detailed mitigation logic documented in Dossier 02.</span>
            <a href={`${baseUrl}whitepapers/fraud-tracing.html`} class="text-[#c4562e] font-bold hover:underline uppercase">
              Open Spec 02 Dossier &rarr;
            </a>
          </div>
        </section>

        <!-- SECTION 03: Telecom SMS Gateway -->
        <section id="sms-gateway" class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-8 rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">03 // TELECOM SWITCHING &amp; QUEUES</span>
            <div class="h-px flex-1 bg-[#5c6650]"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#e8e2d5] uppercase">National Telecom Routing &amp; Aggregator Infrastructure</h2>
          
          <!-- Invariant Box -->
          <div class="mt-4 p-3 bg-[#141210] border-l-2 border-[#c4562e] text-xs space-y-1">
            <span class="text-[#c4562e] font-bold uppercase tracking-wider block">Architectural Invariant</span>
            <p class="text-[#e8e2d5] font-mono">Zero OTP blockage during multi-million marketing broadcast surges. 1B+ SMS routed/year.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#a8a196] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              Stateful SMPP 3.4 TCP sessions balanced over prefix bands (1000–9000). Dynamic sliding-window flow control (16–64 PDU) paired with upstream HLR lookups to filter dead numbers and Do-Not-Disturb (*800#) numbers before dispatch.
            </p>
          </div>

          <!-- Failure Mode -->
          <div class="mt-3 p-3 bg-[#141210] border-l-2 border-[#c9a15a] text-xs space-y-1">
            <span class="text-[#c9a15a] font-bold uppercase tracking-wider block">Failure Mode &amp; Mitigation</span>
            <p class="text-[#a8a196] leading-relaxed">
              Carrier pipe saturation under UCS-2 Persian 70-character segmentation limits. Resolved through strict priority queue partitioning separating transactional OTPs from bulk marketing campaigns.
            </p>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-4">
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">50K+ TPS Capacity</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">SMPP 3.4 Sockets</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">UCS-2 Segmentation</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">*800# DND Bypass</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210] border border-[#5c6650] p-2 sm:p-4 my-4 overflow-hidden rounded-none">
            <img 
              src={`${baseUrl}diagrams/placeholder-3.svg`} 
              alt="National Telecom SMS Routing Hub Topology Schematic"
              class="w-full h-auto object-contain rounded-none"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex justify-between items-center text-xs">
            <span class="text-[#a8a196]">Telecom routing and aggregator specs documented in Dossier 03.</span>
            <a href={`${baseUrl}whitepapers/sms-infrastructure.html`} class="text-[#c4562e] font-bold hover:underline uppercase">
              Open Spec 03 Dossier &rarr;
            </a>
          </div>
        </section>

        <!-- SECTION 04: Data Pipeline -->
        <section id="data-pipeline" class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-8 rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">04 // HIGH-VOLUME ANALYTICS &amp; ENRICHMENT</span>
            <div class="h-px flex-1 bg-[#5c6650]"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#e8e2d5] uppercase">National Contact Consolidation &amp; Smart DB v1</h2>
          
          <!-- Invariant Box -->
          <div class="mt-4 p-3 bg-[#141210] border-l-2 border-[#c4562e] text-xs space-y-1">
            <span class="text-[#c4562e] font-bold uppercase tracking-wider block">Architectural Invariant</span>
            <p class="text-[#e8e2d5] font-mono">70% predictive behavioral accuracy for user preferences prior to formal KYC data ingestion.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#a8a196] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              Vectorized DuckDB engine ingesting unstructured operator CSV/TSV dumps. Generates dynamic scoring matrices with 70% predictive accuracy for user preferences prior to identity verification. Storage overhead reduced by 70% via Snappy-compressed Apache Parquet.
            </p>
          </div>

          <!-- Failure Mode -->
          <div class="mt-3 p-3 bg-[#141210] border-l-2 border-[#c9a15a] text-xs space-y-1">
            <span class="text-[#c9a15a] font-bold uppercase tracking-wider block">Failure Mode &amp; Mitigation</span>
            <p class="text-[#a8a196] leading-relaxed">
              Relational database degradation during multi-attribute joins on 94M+ records. Solved by decoupling query paths into an Elasticsearch cluster fronted by an API gateway.
            </p>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-4">
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">100M Records</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">Columnar Parquet</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">DuckDB In-Memory</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">Elasticsearch Decoupled</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210] border border-[#5c6650] p-2 sm:p-4 my-4 overflow-hidden rounded-none">
            <img 
              src={`${baseUrl}diagrams/placeholder-4.svg`} 
              alt="Smart DB v1 Contact Consolidation and Data Pipeline Schematic"
              class="w-full h-auto object-contain rounded-none"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex justify-between items-center text-xs">
            <span class="text-[#a8a196]">Columnar normalization and DuckDB benchmarks documented in Case Study.</span>
            <a href={`${baseUrl}data-cleaning/`} class="text-[#c4562e] font-bold hover:underline uppercase">
              View Name-Cleaning Blueprint &rarr;
            </a>
          </div>
        </section>

        <!-- PRODUCTION INCIDENT DOSSIERS -->
        <section id="incident-dossiers" class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-8 space-y-6 rounded-none">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">PRODUCTION INCIDENT DOSSIERS</span>
            <div class="h-px flex-1 bg-[#5c6650]"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#e8e2d5] uppercase">Battle-Tested Failure Resolution</h2>
          <p class="text-[#a8a196] text-xs sm:text-sm leading-relaxed">
            Hands-on systems architecture: production failure resolution and incident mitigation under strict SLA constraints.
          </p>

          <div class="space-y-4 mt-4">
            <!-- Dossier 01 -->
            <div class="bg-[#141210] border border-[#5c6650] p-5 rounded-none">
              <div class="flex items-center justify-between border-b border-[#5c6650] pb-2 mb-3">
                <span class="text-[10px] font-mono text-[#c4562e] uppercase font-bold tracking-widest">DOSSIER 01 // PAYMENT GATEWAY</span>
                <span class="text-[9px] text-[#c9d4a8] font-mono">STATUS: RESOLVED</span>
              </div>
              <h3 class="text-sm font-bold text-[#e8e2d5] uppercase">Upstream ISO 8583 Timeout Recovery</h3>
              <div class="text-xs text-[#a8a196] mt-2.5 space-y-1.5 leading-relaxed font-mono">
                <p><strong class="text-[#c9a15a]">Context:</strong> Merchant retry storms triggering duplicate captures during banking host timeouts.</p>
                <p><strong class="text-[#c4562e]">Invariant:</strong> An idempotent lock must outlive the longest carrier retry window (86,400s).</p>
                <p><strong class="text-[#e8e2d5]">Resolution:</strong> Distributed Redis mutex with 24-hour expiration. Database updates migrated to append-only double-entry ledger. Zero financial drift.</p>
              </div>
            </div>

            <!-- Dossier 02 -->
            <div class="bg-[#141210] border border-[#5c6650] p-5 rounded-none">
              <div class="flex items-center justify-between border-b border-[#5c6650] pb-2 mb-3">
                <span class="text-[10px] font-mono text-[#c4562e] uppercase font-bold tracking-widest">DOSSIER 02 // TELECOM SWITCH</span>
                <span class="text-[9px] text-[#c9d4a8] font-mono">STATUS: RESOLVED</span>
              </div>
              <h3 class="text-sm font-bold text-[#e8e2d5] uppercase">Carrier SMPP Sliding-Window Choke</h3>
              <div class="text-xs text-[#a8a196] mt-2.5 space-y-1.5 leading-relaxed font-mono">
                <p><strong class="text-[#c9a15a]">Context:</strong> High-volume marketing runs delaying critical banking OTP verification codes.</p>
                <p><strong class="text-[#c4562e]">Invariant:</strong> Critical authentication traffic cannot share worker pipes with bulk broadcast queues.</p>
                <p><strong class="text-[#e8e2d5]">Resolution:</strong> Multi-tiered queue partitioning; real-time SMPP sliding window throttle (16–64 PDU); upstream HLR validation to discard dead lines before billing.</p>
              </div>
            </div>

            <!-- Dossier 03 -->
            <div class="bg-[#141210] border border-[#5c6650] p-5 rounded-none">
              <div class="flex items-center justify-between border-b border-[#5c6650] pb-2 mb-3">
                <span class="text-[10px] font-mono text-[#c4562e] uppercase font-bold tracking-widest">DOSSIER 03 // SMART DB v1</span>
                <span class="text-[9px] text-[#c9d4a8] font-mono">STATUS: RESOLVED</span>
              </div>
              <h3 class="text-sm font-bold text-[#e8e2d5] uppercase">Smart DB v1 100M Pre-KYC Scoring</h3>
              <div class="text-xs text-[#a8a196] mt-2.5 space-y-1.5 leading-relaxed font-mono">
                <p><strong class="text-[#c9a15a]">Context:</strong> 94.7M orphaned, unindexed records with inconsistent schemas causing RDBMS lock degradation.</p>
