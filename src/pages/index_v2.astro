---
// Home layout test v2 (2026-11-21). Order of operations: who → proof → work → contact.
// One accent only. No entrance animation. Variant via ?v=dark.
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { stats } from '../data/stats';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const picks = [
  { id: 'telecom-smpp-sliding-window', tag: 'Telecom', fig: 'telecom-smpp-sliding-window-schematic_v2.svg' },
  { id: 'fintech-lmax-balance-reservation', tag: 'Payments', fig: 'fintech-lmax-disruptor-schematic_v2.svg' },
  { id: 'fraud-detection-forensic-tracing', tag: 'Fraud', fig: 'fraud-tracing-architecture.svg' },
  { id: 'cdc-cache-poisoning', tag: 'Data', fig: 'cdc-wal-cache-poisoning-schematic.svg' },
];
const posts = await getCollection('blog');
const work = picks
  .map((p) => {
    const post = posts.find((x) => x.id === `en/${p.id}` || x.id === p.id);
    return post ? { ...p, title: post.data.title, desc: post.data.description, href: `${base}blog/${p.id}/` } : null;
  })
  .filter(Boolean);

const proof = [
  { n: stats.telecomHubAnnualVolume.en.replace(" SMS", ""), l: 'SMS a year through a national switch' },
  { n: stats.superAppMonthlyActives.en.replace(' Monthly Actives', ''), l: 'monthly users on a superapp I ran fraud response for' },
  { n: stats.commercialPartnerBanks.en.replace(' commercial banks', ''), l: 'commercial banks reconciled in one clearing flow' },
  { n: stats.clearingBatchesDaily.en.replace(' Daily Batches', ''), l: 'clearing batches settled per day' },
];
---

<Layout
  title="Ariya Sarrafzadeh — Systems Architect"
  description="Systems that hold under pressure. Payments, telecom and data platforms where correctness matters."
>
  <div class="v2" id="v2">
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">Ariya Sarrafzadeh · Systems architect</p>
        <h1>Systems that hold under&nbsp;pressure.</h1>
        <p class="lede">
          I design and rescue payment, telecom and data platforms where a wrong number costs money.
          You bring the problem; I research it, write the plan, and hand control back to your team.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={`${base}contact/`}>Book a call</a>
          <a class="btn btn-quiet" href="#work">See the work</a>
        </div>
      </div>
      <figure class="portrait">
        <img src={`${base}photos/ariya-portrait.jpg`} alt="Ariya Sarrafzadeh" width="385" height="1105" loading="eager" />
      </figure>
    </section>

    <section class="proof" aria-label="Scale of past work">
      {proof.map((p) => (
        <div class="fact">
          <span class="num">{p.n}</span>
          <span class="lbl">{p.l}</span>
        </div>
      ))}
    </section>

    <section class="work"><span id="work" class="anchor"></span>
      <header class="sec-head">
        <h2>Selected work</h2>
        <a class="link" href={`${base}whitepapers/`}>All write-ups →</a>
      </header>
      <div class="grid">
        {work.map((w) => (
          <a class="card" href={w.href}>
            <div class="fig"><img src={`${base}diagrams/${w.fig}`} alt="" loading="lazy" /></div>
            <div class="card-body">
              <span class="tag">{w.tag}</span>
              <h3>{w.title}</h3>
              <p>{w.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="close">
      <h2>Have a system that is failing under load?</h2>
      <p>One call is enough to tell whether I can help.</p>
      <a class="btn btn-primary" href={`${base}contact/`}>Book a call</a>
    </section>
  </div>
</Layout>

<script is:inline>
  if (new URLSearchParams(location.search).get('v') === 'dark') document.getElementById('v2').dataset.v = 'dark';
</script>

<style>
  .v2 {
    /* Light: warm neutrals + one accent (Patina, deepened for contrast). */
    --bg: #F6F5F1;
    --surface: #FFFFFF;
    --line: #E2DFD8;
    --ink: #17201D;
    --muted: #5E6662;
    --accent: #2F5F57;
    --accent-ink: #FFFFFF;
    --plate: #FFFFFF;
    background: var(--bg);
    color: var(--ink);
    margin: -4rem 0 0;
    padding: 6rem clamp(16px, 5vw, 64px) 5rem;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }
  .v2[data-v='dark'] {
    /* Canonical: Carbon / Graphite / Basalt + Patina. */
    --bg: #202725;
    --surface: #292F2D;
    --line: #343C38;
    --ink: #ECEFEC;
    --muted: #A3ACA7;
    --accent: #8FB4AA;
    --accent-ink: #16201D;
    --plate: #F4F3EF;
  }
  .v2 > section { max-width: 1120px; margin-inline: auto; }

  .hero { display: grid; grid-template-columns: 1fr auto; gap: clamp(32px, 6vw, 96px); align-items: end; padding-bottom: 56px; border-bottom: 1px solid var(--line); }
  .eyebrow { font-size: 14px; color: var(--muted); margin: 0 0 20px; }
  h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 600; margin: 0 0 24px; max-width: 13ch; }
  .lede { font-size: 18px; line-height: 1.6; color: var(--muted); max-width: 52ch; margin: 0 0 32px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .portrait { margin: 0; width: clamp(180px, 20vw, 260px); aspect-ratio: 3 / 4; overflow: hidden; border-radius: 6px; background: var(--line); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; display: block; }

  .btn { display: inline-flex; align-items: center; height: 44px; padding: 0 20px; border-radius: 8px; font-size: 15px; font-weight: 500; text-decoration: none; transition: background-color 150ms ease, color 150ms ease, transform 120ms ease; }
  .btn:active { transform: scale(0.97); }
  .btn-primary { background: var(--accent); color: var(--accent-ink); }
  .btn-quiet { color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover { background: color-mix(in oklab, var(--accent) 88%, var(--ink)); }
    .btn-quiet:hover { background: var(--surface); }
    .card:hover { border-color: color-mix(in oklab, var(--line) 50%, var(--muted)); }
    .link:hover { color: var(--accent); }
  }

  .proof { display: grid; grid-template-columns: repeat(4, 1fr); padding: 40px 0; border-bottom: 1px solid var(--line); }
  .fact { padding-right: 24px; }
  .fact + .fact { padding-left: 24px; border-left: 1px solid var(--line); }
  .num { display: block; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; margin-bottom: 6px; }
  .lbl { font-size: 14px; line-height: 1.45; color: var(--muted); }

  .work { padding-top: 64px; }
  .anchor { display: block; position: relative; top: -96px; }
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px; }
  h2 { font-size: 24px; letter-spacing: -0.02em; font-weight: 600; margin: 0; }
  .link { font-size: 14px; color: var(--muted); text-decoration: none; transition: color 150ms ease; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; color: inherit; text-decoration: none; transition: border-color 150ms ease; }
  .fig { background: var(--plate); aspect-ratio: 16 / 9; display: grid; place-items: center; padding: 16px; border-bottom: 1px solid var(--line); }
  .fig img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .card-body { padding: 20px 22px 24px; }
  .tag { font-size: 12px; color: var(--muted); font-family: 'IBM Plex Mono', ui-monospace, monospace; }
  h3 { font-size: 17px; line-height: 1.35; font-weight: 600; letter-spacing: -0.01em; margin: 8px 0; }
  .card-body p { font-size: 14px; line-height: 1.55; color: var(--muted); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .close { margin-top: 80px; padding: 48px 0 0; border-top: 1px solid var(--line); }
  .close p { color: var(--muted); margin: 8px 0 24px; }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .portrait { order: -1; width: 160px; }
    .proof { grid-template-columns: 1fr 1fr; row-gap: 24px; }
    .fact:nth-child(3) { padding-left: 0; border-left: 0; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
