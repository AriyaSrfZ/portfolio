---
import Layout from '../layouts/Layout.astro';
import Velaris from '../components/ui/velaris';
---

<Layout title="Velaris WebGL Shader Showcase — Ariya Sarrafzadeh">
  <main class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-24 font-sans">
    <div class="mb-8">
      <a
        href={`${import.meta.env.BASE_URL}`}
        class="text-xs uppercase tracking-wider text-[#94a3b8] hover:text-[#ededed] inline-flex items-center gap-1.5 transition-colors font-mono"
      >
        ← Back to Production Dashboard
      </a>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mt-4">
        Velaris Shader Pipeline
      </h1>
      <p class="text-sm text-neutral-400 mt-2 font-mono">
        Hardware-accelerated procedural simplex-noise background integrated via Astro client directive.
      </p>
    </div>

    {/* Live WebGL Showcase Container */}
    <div class="rounded-2xl border border-white/10 overflow-hidden shadow-2xl bg-[#090a0c]">
      <Velaris
        client:only="react"
        height="560px"
        bg="#090a0c"
        colors={["#38bdf8", "#0284c7", "#1e293b", "#090a0c"]}
        speed={1.2}
        grain={0.25}
        className="rounded-2xl"
      >
        <div class="flex h-full w-full flex-col items-center justify-center gap-5 px-6 text-center">
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-mono text-cyan-300 backdrop-blur-md shadow-lg">
            ● GLSL SIMPLEX NOISE · 60 FPS
          </span>

          <h2 class="max-w-2xl text-3xl sm:text-5xl font-bold tracking-tight text-white">
            Living gradients in perpetual motion
          </h2>

          <p class="max-w-md text-sm text-neutral-300/90 sm:text-base leading-relaxed">
            Continuous 4-color interpolation with radial vignette occlusion, DPR scaling, and WCAG reduced-motion safety.
          </p>

          <div class="mt-4 flex flex-wrap gap-3">
            <a
              href={`${import.meta.env.BASE_URL}#blueprints`}
              class="px-5 py-2.5 rounded-lg bg-white text-zinc-950 text-xs font-semibold font-mono hover:bg-neutral-200 transition-colors shadow-md"
            >
              Explore Architecture Blueprints
            </a>
          </div>
        </div>
      </Velaris>
    </div>
  </main>
</Layout>
