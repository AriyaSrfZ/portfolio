---
import Layout from '../../layouts/Layout.astro';
import TelecomCatalogExplorer from '../../components/react/TelecomCatalogExplorer';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const stats = [
  { value: '1,080,000+', label: 'Daily SMS Throughput', sub: 'Banking, OTP & Transactional' },
  { value: '22', label: 'Physical Carrier Trunks', sub: 'Magfa, Asiatech, Fanap, Asanak' },
  { value: '454', label: 'Operational Modules', sub: 'Reverse-Engineered & Catalogued' },
  { value: '14', label: 'Magfa 3000 Parallel Shards', sub: 'Physical Table Sharding in MySQL' },
  { value: '10', label: 'Official Client SDKs', sub: 'Go, Python, Node, Java, .NET, PHP' },
  { value: '< 120ms', label: 'P99 Edge Ingress Latency', sub: 'Sub-5ms Redis MNP Lookup' },
];

const networkFleet = [
  { name: 'DB-Master (Primary Node)', ip: '192.168.1.101', role: 'Primary MySQL 8.0 server hosting sharded SMS tables, billing ledgers, and authentication', os: 'Linux 5.15 / MySQL 8.0' },
  { name: 'Feresta-DB-Slave (Replica)', ip: '192.168.1.64', role: 'Replica backup node syncing via Binary Logs with 240GB free disk space for read offloading', os: 'Linux 5.15 / MySQL Replica' },
  { name: 'fersta-nginx-gateway', ip: '192.168.1.150', role: 'HAProxy and Nginx reverse proxies handling SSL termination, rate-limiting, and ingress routing', os: 'Nginx + HAProxy 2.6' },
  { name: 'smart-db (Monitoring Node)', ip: '192.168.1.136', role: 'Infrastructure telemetry server running Zabbix 6.4.6, Prometheus, and carrier health monitors', os: 'Zabbix Server 6.4.6' },
];

const allCarrierGateways = [
  { id: '1', name: '3000 - Main Trunk', op: 'Magfa (Main Trunk)', status: 'Active', table: 'sms_send_3000', endpoint: 'dargahha_edit&id=1' },
  { id: '2', name: '3000 - Secondary Trunk 1 (30001)', op: 'Magfa Line 1', status: 'Active', table: 'sms_send_30001', endpoint: 'dargahha_edit&id=2' },
  { id: '3', name: '3000 - Main ESB (30000)', op: 'Magfa High-Speed ESB', status: 'Active', table: 'sms_send_30000', endpoint: 'dargahha_edit&id=3' },
  { id: '4', name: '3000 - ESB Trunk 1 (300010)', op: 'Magfa ESB Trunk 1', status: 'Active', table: 'sms_send_300010', endpoint: 'dargahha_edit&id=4' },
  { id: '5', name: '3000 - Secondary Trunk 2 (30002)', op: 'Magfa Line 2', status: 'Active', table: 'sms_send_30002', endpoint: 'dargahha_edit&id=5' },
  { id: '6', name: '3000 - ESB Trunk 2 (300020)', op: 'Magfa ESB Trunk 2', status: 'Active', table: 'sms_send_300020', endpoint: 'dargahha_edit&id=6' },
  { id: '7', name: '9000 - Main Trunk', op: 'Asiatech / Samasoo', status: 'Active', table: 'sms_send_9000', endpoint: 'dargahha_edit&id=7' },
  { id: '8', name: '50002 - Main Route', op: 'Smart Land Solutions', status: 'Active', table: 'sms_send_50002', endpoint: 'dargahha_edit&id=8' },
  { id: '9', name: 'Magfa - MCI Filter (3000)', op: 'Magfa MCI Filter', status: 'Active', table: 'sms_send_3000', endpoint: 'dargahha_edit&id=9' },
  { id: '10', name: 'Magfa - MTN Filter (3000)', op: 'Magfa MTN Filter', status: 'Active', table: 'sms_send_3000', endpoint: 'dargahha_edit&id=10' },
  { id: '11', name: 'Asanak Landline (982100)', op: 'Asanak (021 Fixed Landline)', status: 'Active', table: 'sms_send_982100', endpoint: 'dargahha_edit&id=11' },
  { id: '12', name: 'Ryntel Bulk Route', op: 'Ryntel (999800)', status: 'Active', table: 'sms_send_999800', endpoint: 'dargahha_edit&id=12' },
  { id: '13', name: '3000 - Secondary Trunk 3 (30003)', op: 'Magfa Line 3', status: 'Active', table: 'sms_send_30003', endpoint: 'dargahha_edit&id=13' },
  { id: '14', name: '3000 - Secondary Trunk 4 (30004)', op: 'Magfa Line 4', status: 'Active', table: 'sms_send_30004', endpoint: 'dargahha_edit&id=14' },
  { id: '15', name: '3000 - Secondary Trunk 5 (30005)', op: 'Magfa Line 5', status: 'Active', table: 'sms_send_30005', endpoint: 'dargahha_edit&id=15' },
  { id: '16', name: '3000 - Secondary Trunk 6 (30006)', op: 'Magfa Line 6', status: 'Active', table: 'sms_send_30006', endpoint: 'dargahha_edit&id=16' },
  { id: '17', name: '3000 - Secondary Trunk 7 (30007)', op: 'Magfa Line 7', status: 'Active', table: 'sms_send_30007', endpoint: 'dargahha_edit&id=17' },
  { id: '18', name: '3000 - Secondary Trunk 8 (30008)', op: 'Magfa Line 8', status: 'Active', table: 'sms_send_30008', endpoint: 'dargahha_edit&id=18' },
  { id: '19', name: '3000 - Secondary Trunk 9 (30009)', op: 'Magfa Line 9', status: 'Active', table: 'sms_send_30009', endpoint: 'dargahha_edit&id=19' },
  { id: '20', name: '30003 ESB (300030)', op: 'Magfa ESB Trunk 3', status: 'Disabled', table: 'sms_send_300030', endpoint: 'dargahha_edit&id=20' },
  { id: '21', name: 'Fanap Telecom (9992101)', op: 'Fanap Telecom Enterprise', status: 'Active', table: 'sms_send_9992101', endpoint: 'dargahha_edit&id=21' },
  { id: '22', name: 'Voice OTP (9876)', op: 'Voice Call Authentication', status: 'Active', table: 'sms_send_9876', endpoint: 'dargahha_edit&id=22' },
];

const forensicTools = [
  { title: 'Long-Pending Message Detector', param: 'detect_long_pending', desc: 'Identifies messages stalled in pending state awaiting carrier upstream response, providing concrete proof of carrier-side outages.' },
  { title: 'Real-Time Uncounted Pendings', param: 'detect_long_pending_current', desc: 'Live tracker for the oldest uncounted messages, verifying worker pool health and queue draining performance.' },
  { title: 'Carrier Direct Error in Archive', param: 'sms_provider_error_in_archive', desc: 'Extracts upstream carrier error codes logged in historical archive tables to isolate carrier SLA breaches from platform faults.' },
  { title: 'No-Route Provider Detection', param: 'sms_no_route_providers_in_archive', desc: 'Identifies unrouted messages caused by carrier trunk disconnects or upstream gateway incapacitation.' },
  { title: 'SMS Ingest Count Discrepancy', param: 'sms_send_count_discrepancy', desc: 'Reconciles API ingress batch counts with actual delivery packages handed off to telecommunication operators for financial settlement.' },
  { title: 'Duplicate Message Archive Auditing', param: 'sms_duplicate_in_archive', desc: 'Identifies duplicate message payloads dispatched during network timeouts or uncoordinated application retry loops.' },
  { title: 'Duplicate Delivery Receipt Verifier', param: 'sms_deliver_duplicate_number', desc: 'Audits anomalous duplicate delivery receipt (DLR) webhook callbacks from telecommunication carriers.' },
  { title: 'Archive Integrity Validator', param: 'sms_check_archive_with_new_stat_from_archive', desc: 'Validates statistical consistency between long-term cold archives and real-time active message buffers.' },
  { title: 'Sent Table Database Value Check', param: 'sms_sent_check_db_value', desc: 'Audits field schema and column integrity across the sms_sent persistence layer in MySQL.' },
  { title: 'Financial Refund Reconciliation', param: 'detect_diff_price_back_state_admin_and_user', desc: 'Audits financial credit rollbacks for failed upstream carrier packets between tenants and platform accounts.' },
  { title: 'Mobile Number Portability (MNP) Cache', param: 'tarabord_redis_manager', desc: 'High-speed Redis cache managing operator mappings for ported MSISDNs in under 5ms, preventing misrouted carrier billing charges.' },
  { title: 'RabbitMQ Queue Telemetry Monitor', param: 'monitoring_rabbitmq', desc: 'Live monitoring of rabbitmq-delivery and rabbitmq-esb queue depths, worker consumers, and burst buffer saturation.' },
  { title: 'Kannel SMPP Visual Config Builder', param: 'kannel_config_builder', desc: 'Automated compiler for SMPP v3.4 connections, sliding-window flow control, and bearerbox/smsbox operational topologies.' },
  { title: 'Active MySQL Query Killer', param: 'query_list', desc: 'Real-time database process list monitor with one-click emergency termination for lock-holding reporting queries.' },
];

const actionPlan = [
  { step: '01', title: 'Formal Change Management Window', owner: 'Engineering Leadership', deadline: 'Immediate (24h)', impact: 'Schedule all replica synchronization and maintenance tasks strictly between 02:00 and 06:00 to eliminate daytime peak contention.' },
  { step: '02', title: 'Kernel Swappiness Optimization (vm.swappiness = 1)', owner: 'Infrastructure Team', deadline: '48 Hours', impact: 'Prevents premature kernel memory swapping to disk when over 22GB of unallocated physical RAM is readily available.' },
  { step: '03', title: 'Automated Binary Log Expiration (3 Days)', owner: 'Database Administrator', deadline: '48 Hours', impact: 'Sets binlog_expire_logs_seconds to 259200, eliminating 386GB disk log accumulation and preventing catastrophic 1,169 r/s disk read spikes.' },
  { step: '04', title: 'Read-Replica Traffic Offloading (192.168.1.64)', owner: 'DevOps & Backend Team', deadline: '1 Week', impact: 'Routes all non-transactional reporting and reconciliation queries to the replica node with 240GB free disk space.' },
  { step: '05', title: 'Zabbix Alert on Active Threads (> 50)', owner: 'Monitoring Team', deadline: '3 Days', impact: 'Automated instant alerting via Webhooks before database threads hit the cascading lock tipping point of 147.' },
];
---

<Layout 
  title="National Telecom SMS Gateway & Switching Platform (Tellir / Feresta) — Ariya Sarrafzadeh"
  description="Consolidated engineering dossier: 12-chapter Feresta User Manual, 264-endpoint Tellir Admin Core Catalog, 22 carrier gateways, 14 Magfa shards, 7-layer Zabbix telemetry, and post-mortem incident forensics."
  lang="en"
  dir="ltr"
>
  <article class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-28 font-sans text-left" dir="ltr">
    
    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-secondary)] font-mono">
        <a href={baseUrl} class="hover:text-[var(--text-primary)] transition">Home</a>
        <span>/</span>
        <a href={`${baseUrl}products/`} class="hover:text-[var(--text-primary)] transition">Products</a>
        <span>/</span>
        <span class="text-[var(--text-primary)] font-bold">Enterprise SMS Switching Platform</span>
      </nav>
      <div class="flex items-center gap-2">
        <a 
          href={`${baseUrl}fa/products/sms-gateway/`} 
          class="btn-3d-secondary text-xs"
          style="height: 32px; padding: 0 14px;"
        >
          نسخه فارسی (Persian Dossier)
        </a>
      </div>
    </div>

    <!-- Hero Header (Heavy 3D Liquid Glass Panel 28px) -->
    <header class="glass-panel-hero p-8 sm:p-10 mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="icon-well">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="status-pill">
          <span class="status-dot success"></span>
          <span>Production Platform · Consolidated Engineering Portals & Full Panel Manuals</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--text-primary)] tracking-tight leading-tight">
        National Telecom SMS Gateway & Switching Platform (Tellir / Feresta)
      </h1>
      
      <p class="mt-4 text-base sm:text-lg text-[var(--text-secondary)] max-w-5xl leading-relaxed">
        Engineered, audited, and scaled for <strong>Persia Fava Gostaresh</strong> to ingest, route, and deliver <strong>over 1,080,000 daily banking OTPs, transaction alerts, and service notifications</strong> across 22 carrier gateways, 14 parallel MySQL database shards, Kannel SMPP v3.4 clusters, and high-throughput RabbitMQ queues. Comprehensive consolidation includes the <strong>12-chapter Feresta User Portal Manual</strong>, the <strong>Tellir Admin Core 264-Endpoint Catalog</strong>, an interactive 454-module explorer, 7-layer Zabbix telemetry, and post-mortem incident forensics.
      </p>

      <hr class="separator-etched" />

      <!-- Segmented Dock Navigator -->
      <nav class="glass-dock-nav" aria-label="Consolidated Dossiers Navigator">
        <a href="#overview" class="dock-pill active">
          <span class="status-dot success"></span>
          01 · Topology & Fleet
        </a>
        <a href="#user-manual" class="dock-pill">
          02 · User Manual (12 Chapters)
        </a>
        <a href="#admin-catalog" class="dock-pill">
          03 · Admin Core & Diagnostics
        </a>
        <a href="#gateways" class="dock-pill">
          04 · 22 Gateways & Shards
        </a>
        <a href="#zabbix" class="dock-pill">
          05 · Zabbix & Grafana
        </a>
        <a href="#postmortem" class="dock-pill">
          06 · Incident Post-Mortem
        </a>
        <a href="#catalog" class="dock-pill">
          07 · 454-Module Explorer
        </a>
        <a href="#sdks" class="dock-pill">
          08 · 10 SDKs & Client API
        </a>
      </nav>
    </header>

    <!-- Key Metrics Grid -->
    <section class="mb-14">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {stats.map((s) => (
          <div class="glass-card p-5 text-center">
            <div class="text-2xl sm:text-3xl font-extrabold mono-tabular text-[var(--text-primary)] tracking-tight">{s.value}</div>
            <div class="text-xs font-bold text-[var(--text-primary)] mt-1.5">{s.label}</div>
            <div class="text-[10px] text-[var(--text-tertiary)] mt-1">{s.sub}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- =========================================================================
         SECTION 1: ARCHITECTURE & FLEET TOPOLOGY
         ========================================================================= -->
    <section id="overview" class="mb-16 space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--separator-line)]">
        <div>
          <span class="text-xs font-mono font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Chapter 01</span>
          <h2 class="text-2xl font-bold text-[var(--text-primary)] tracking-tight mt-1">
            System Architecture, Fleet Topology & Traffic Processing Layers
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card p-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="icon-well">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-[var(--text-primary)]">1. Edge Ingress & Web Layer</h3>
              <span class="text-[10px] font-mono text-[var(--text-tertiary)]">HAProxy / Nginx</span>
            </div>
          </div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            HAProxy load balancers deployed on node <code>192.168.1.150</code> handle TLS termination, client IP rate-limiting, and traffic balancing across API ports 4000 to 4005. High-priority OTP payloads are prioritized into dedicated message channels.
          </p>
        </div>

        <div class="glass-card p-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="icon-well">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-[var(--text-primary)]">2. Distributed Queues & Kannel</h3>
              <span class="text-[10px] font-mono text-[var(--text-tertiary)]">RabbitMQ & SMPP</span>
            </div>
          </div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            <code>rabbitmq-delivery</code> and <code>rabbitmq-esb</code> queues absorb burst traffic spikes. Kannel clusters utilizing SMPP v3.4 protocols and sliding-window flow control dispatch packets upstream at over 350 SMS/second per trunk.
          </p>
        </div>

        <div class="glass-card p-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="icon-well">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-[var(--text-primary)]">3. Sharded Persistence & Memory</h3>
              <span class="text-[10px] font-mono text-[var(--text-tertiary)]">MySQL & Redis MNP</span>
            </div>
          </div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            The primary database on <code>192.168.1.101</code> stores messages across 14 parallel physical tables. An in-memory Redis cluster verifies mobile number portability (MNP) and regulatory blacklists in under 5ms before carrier handoff.
          </p>
        </div>
      </div>

      <!-- Network Nodes Table -->
      <div class="glass-table-wrapper">
        <table class="glass-table-ltr">
          <thead>
            <tr>
              <th>Node & Service Name</th>
              <th>Network Address (IP)</th>
              <th>Software Stack & Version</th>
              <th>Role in Fleet Topology</th>
            </tr>
          </thead>
          <tbody>
            {networkFleet.map((n) => (
              <tr>
                <td style="font-weight: 700; color: var(--text-primary);">{n.name}</td>
                <td class="mono-tabular"><code>{n.ip}</code></td>
                <td class="mono-tabular" style="color: var(--text-secondary);">{n.os}</td>
                <td style="color: var(--text-secondary);">{n.role}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 2: FERESTA USER PANEL MANUAL (12 CHAPTERS)
         ========================================================================= -->
    <section id="user-manual" class="mb-16 space-y-8">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--separator-line)]">
        <div>
          <span class="text-xs font-mono font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Chapter 02</span>
          <h2 class="text-2xl font-bold text-[var(--text-primary)] tracking-tight mt-1">
            Feresta SMS User Portal Comprehensive Operating Manual
          </h2>
          <p class="text-sm text-[var(--text-secondary)] mt-1">
            Complete 12-chapter client operational guide · Portal: <code>panel.persiafava.com</code>
          </p>
        </div>
        <div class="status-pill">
          <span class="status-dot success"></span>
          <span>12 Complete Chapters Integrated</span>
        </div>
      </div>

      <!-- Chapters 1-4 Overview -->
      <div class="glass-card p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="icon-well">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7.5" r="4"></circle>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-[var(--text-primary)]">Chapters 1–4: Registration, Captcha, 3-Step Legal KYC & Dispatch Modules</h3>
            <p class="text-xs text-[var(--text-tertiary)]">Telecommunication regulatory compliance and multi-part SMS character rules</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
          <div class="glass-inner p-5">
            <h4 class="text-xs font-bold font-mono text-[var(--text-primary)] uppercase mb-2">A) Account Onboarding</h4>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Unique username registration, password complexity validation, verified MSISDN onboarding for OTP security, and subscription tier selection based on projected monthly volume.
            </p>
          </div>

          <div class="glass-inner p-5">
            <h4 class="text-xs font-bold font-mono text-[var(--text-primary)] uppercase mb-2">B) 3-Step Legal Verification</h4>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              <strong>1. Individual KYC:</strong> National ID, birthdate, postal address.<br />
              <strong>2. Corporate KYC:</strong> National company ID, registration certificate, executive board signatories.<br />
              <strong>3. Document Vault:</strong> Official ID and utility bill upload.
            </p>
          </div>

          <div class="glass-inner p-5">
            <h4 class="text-xs font-bold font-mono text-[var(--text-primary)] uppercase mb-2">C) Dispatch Heuristics</h4>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Persian character limits (70 chars part 1, 64 chars subsequently), English limits (160/153), simple manual sending, smart variable replacement (<code>%name%</code>, <code>%code%</code>), national postal code banks, and BTS cellular tower mapping.
            </p>
          </div>
        </div>
      </div>

      <!-- Chapters 5-12 Features -->
      <div class="glass-card p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="icon-well">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="2" y="5" width="20" height="14" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-[var(--text-primary)]">Chapters 5–12: Templates, Contacts, SMS Assist, Delivery Reports, API & Finance</h3>
            <p class="text-xs text-[var(--text-tertiary)]">5 contact import mechanisms, delivery webhook forwarders, and budget tax calculations</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
          <div class="glass-inner p-4">
            <h4 class="text-xs font-bold text-[var(--text-primary)] mb-1.5">Templates & Blacklist Bypass</h4>
            <p class="text-[11px] text-[var(--text-secondary)] leading-relaxed">
              Pre-approved regulatory service patterns with dynamic variable tokens (<code>%name%</code>) enabling legal delivery to telecommunication advertising blacklists.
            </p>
          </div>

          <div class="glass-inner p-4">
            <h4 class="text-xs font-bold text-[var(--text-primary)] mb-1.5">Audience & Contact Engine</h4>
            <p class="text-[11px] text-[var(--text-secondary)] leading-relaxed">
              5 contact import methods: manual input, XLSX/CSV parsing, bulk text paste, raw TXT file ingestion, and automated inbound subscriber extraction.
            </p>
          </div>

          <div class="glass-inner p-4">
            <h4 class="text-xs font-bold text-[var(--text-primary)] mb-1.5">SMS Assist & Value-Added</h4>
            <p class="text-[11px] text-[var(--text-secondary)] leading-relaxed">
              Automated keyword auto-responders, digital catalog dispatchers, code verification lotteries, smart appointments, and interactive survey analytics.
            </p>
          </div>

          <div class="glass-inner p-4">
            <h4 class="text-xs font-bold text-[var(--text-primary)] mb-1.5">Billing & Automated Refunds</h4>
            <p class="text-[11px] text-[var(--text-secondary)] leading-relaxed">
              Online payment gateways, automated 10% VAT and state budget levies, bank receipt uploads (Paya/Satna), and immediate credit rollbacks for failed packets.
            </p>
          </div>
        </div>
      </div>

      <!-- 8 Real UI Screens Gallery -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold text-[var(--text-primary)]">Feresta Client User Panel 8 Operational Interfaces</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="glass-card overflow-hidden">
            <img src={`${baseUrl}products/sms-gateway/assets/dashboard.png`} alt="Dashboard" class="w-full h-40 object-cover" loading="lazy" />
            <div class="p-3">
              <div class="text-xs font-bold text-[var(--text-primary)]">1. Client Dashboard</div>
              <p class="text-[10px] text-[var(--text-tertiary)] mt-1">Real-time credit balance, monthly volume trends, and carrier availability.</p>
            </div>
          </div>

