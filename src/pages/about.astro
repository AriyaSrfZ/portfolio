---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import CoreCompetencies from '../components/CoreCompetencies.astro';
---

<Layout title="About — Ariya Sarrafzadeh" description="15+ years as a Systems Architect & Infrastructure Engineer: payments, fraud, SMS switches, and data pipelines.">
  <section class="relative z-10 max-w-3xl mx-auto px-6 pt-32 pb-12 text-center font-sans">
    <div class="relative inline-block mx-auto mb-6">
      <div class="w-28 h-28 rounded-2xl p-1 bg-gradient-to-b from-white/20 to-white/5 border border-white/10 shadow-2xl overflow-hidden">
        <img
          src={`${import.meta.env.BASE_URL}photos/ariya.jpg`}
          alt="Ariya Sarrafzadeh"
          class="w-full h-full object-cover rounded-xl"
        />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2 text-[#f8fafc]">Ariya Sarrafzadeh</h1>
    <p class="text-[#e2c974] uppercase text-xs tracking-wider mb-6 font-medium">Systems Architect &amp; Infrastructure Engineer · Tehran, Iran</p>
    <p class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed max-w-xl mx-auto">
      15+ years designing, building, and operating high-availability payment,
      SMS, and fraud platforms. The work is hands-on systems architecture:
      ISO 8583 timeout recovery, SMPP UCS-2 windowing, Redis double-settlement
      guards, and DuckDB/Parquet enrichment under production load.
    </p>
  </section>

  <CoreCompetencies />
  <Timeline />
</Layout>
