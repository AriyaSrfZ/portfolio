---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import CoreCompetencies from '../components/CoreCompetencies.astro';
---

<Layout title="About — Ariya Sarrafzadeh" description="15+ years architecting high-availability fintech platforms in payments, fraud, and national-level compliance.">
  <section class="relative z-10 max-w-3xl mx-auto px-6 pt-32 pb-12 text-center">
    <img
      src={`${import.meta.env.BASE_URL}photos/ariya.jpg`}
      alt="Ariya Sarrafzadeh"
      class="w-28 h-28 rounded-full object-cover border-2 border-white/20 mx-auto mb-6"
    />
    <h1 class="text-3xl font-bold mb-2">Ariya Sarrafzadeh</h1>
    <p class="text-(--color-aurora-2) mb-6">Senior Technical Product Leader — Tehran, Iran (open to relocation)</p>
    <p class="text-(--color-text-muted) leading-relaxed max-w-xl mx-auto">
      15+ years architecting, building, and operating high-availability fintech
      platforms. My work sits at the intersection of product, technical
      operations, and deep domain knowledge in payments, fraud, and
      national-level compliance — usually as the single point of command when
      a technical, legal, or regulatory problem needed someone who actually
      understood every layer of it.
    </p>
  </section>

  <CoreCompetencies />
  <Timeline />
</Layout>
