---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import CoreCompetencies from '../components/CoreCompetencies.astro';
---

<Layout
  title="About — Ariya Sarrafzadeh"
  description="Senior Product Manager & Technical Systems Architect leading high-throughput payment infrastructure, SMS switches, fraud forensics, and data pipelines."
>
  <!-- Bio Header Section -->
  <section class="relative z-10 w-full max-w-5xl mx-auto px-6 pt-24 pb-10 text-center font-sans">
    <div class="relative inline-block mx-auto mb-5">
      <div class="relative z-10 w-28 h-28 rounded-2xl p-1 bg-[var(--surface-card)] border border-white/15 shadow-2xl overflow-hidden group">
        <img
          src={`${import.meta.env.BASE_URL}photos/ariya.jpg`}
          alt="Ariya Sarrafzadeh"
          class="w-full h-full object-cover rounded-xl opacity-100 transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </div>
    </div>
    
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2 text-[var(--text-primary)]">Ariya Sarrafzadeh</h1>
    
    <!-- Sub-head positioning statement -->
    <div class="max-w-2xl mx-auto mb-3">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--surface-elevated)] border border-[var(--border)] text-xs font-semibold uppercase tracking-wider text-[var(--accent-primary)] font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)]"></span>
        Systems Architect &amp; Technical Product Leader
      </span>
    </div>

    <p class="text-sm sm:text-base font-medium text-[var(--text-primary)] max-w-2xl mx-auto mb-2">
      Systems that hold under pressure.
    </p>

    <p class="text-[var(--text-secondary)] text-xs sm:text-sm leading-relaxed max-w-2xl mx-auto">
      I work at the intersection of systems architecture, engineering, and product thinking—designing dependable technology for complex, high-stakes environments. 15+ years engineering high-availability payment switches, distributed ledgers, and national telecom infrastructure.
    </p>
  </section>

  <!-- Cornerstone Section: The 0-to-Scale Story -->
  <section class="relative z-10 max-w-4xl mx-auto px-6 py-6 font-sans">
    <div class="bg-[var(--surface-card)] backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-8 shadow-2xl ring-1 ring-white/[0.03]">
      <div class="flex items-center justify-between border-b border-white/[0.06] pb-3 mb-5">
        <div class="flex items-center gap-2 font-mono text-[11px] text-[var(--text-secondary)] uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-warm)]"></span>
          <h2 class="text-base sm:text-lg font-bold text-[var(--text-primary)]">
            The 0-to-Scale Story
          </h2>
        </div>
        <span class="text-[10px] font-mono text-neutral-400 uppercase px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06]">
          Executive Foundation
        </span>
      </div>

      <!-- Cornerstone Content -->
      <div class="p-5 bg-[var(--surface-card)] border border-white/[0.06] rounded-xl">
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          I joined environments hampered by fragmented legacy systems and synchronous bottlenecks. Infrastructure was failing under the weight of national traffic spikes; gateway timeouts caused financial discrepancies, and untuned fraud rules choked legitimate revenue. I systematically tore down these bottlenecks: deployed Switch-PSP for dynamic routing across 4 national payment providers, built Double-Entry ACID Ledgers with two-phase reservations (AVAILABLE to RESERVED), enforced Redis token-bucket rate limiters, isolated PCI-DSS card data vaults, and unified credit/BNPL scoring with RabbitMQ eventual consistency. We scaled from handling thousands of localized events to processing 50,000+ TPS bursts with zero financial drift.
        </p>
      </div>
    </div>
  </section>

  <CoreCompetencies locale="en" />
  <Timeline locale="en" />

  <section class="max-w-4xl mx-auto px-6 py-10 text-center font-mono">
    <a href="#book" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-semibold text-xs uppercase tracking-wider bg-[var(--accent-primary)] text-white hover:bg-[var(--accent-light)] transition-all shadow-md active:scale-[0.98]">
      Book an Architecture Review ↓
    </a>
  </section>
</Layout>
