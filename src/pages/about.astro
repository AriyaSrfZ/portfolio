---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import CoreCompetencies from '../components/CoreCompetencies.astro';
---

<Layout title="About — Ariya Sarrafzadeh" description="15+ years as a Systems Architect & Infrastructure Engineer: payments, fraud, SMS switches, and data pipelines.">
  <section class="relative z-10 max-w-3xl mx-auto px-6 pt-32 pb-12 text-center">
    <img
      src={`${import.meta.env.BASE_URL}photos/ariya.jpg`}
      alt="Ariya Sarrafzadeh"
      class="w-28 h-28 rounded-full object-cover border-2 border-white/20 mx-auto mb-6"
    />
    <h1 class="text-3xl font-bold mb-2">Ariya Sarrafzadeh</h1>
    <p class="text-(--color-aurora-2) mb-6">Systems Architect &amp; Infrastructure Engineer — Tehran, Iran (open to relocation)</p>
    <p class="text-(--color-text-muted) leading-relaxed max-w-xl mx-auto">
      15+ years designing, building, and operating high-availability payment,
      SMS, and fraud platforms. The work is hands-on systems architecture:
      ISO 8583 timeout recovery, SMPP UCS-2 windowing, Redis double-settlement
      guards, and DuckDB/Parquet enrichment under production load.
    </p>
  </section>

  <CoreCompetencies />
  <Timeline />
</Layout>
