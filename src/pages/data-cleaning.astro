---
import Layout from '../layouts/Layout.astro';
import { copy } from '../lib/content';

const en = copy.en.dataCleaning;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title={`${en.title} — Ariya Sarrafzadeh`} description={en.lead} lang="en">
  <article class="max-w-4xl mx-auto px-6 pt-32 pb-24 font-sans">
    <div class="flex justify-between items-center mb-4">
      <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[var(--accent-primary)]">{en.kicker}</p>
      <a href={`${baseUrl}fa/data-cleaning/`} class="px-3 py-1.5 text-xs rounded-lg border border-[var(--border)] bg-[var(--surface-sunken)] text-[var(--accent-warm)] hover:border-[var(--accent-warm)] hover:text-[var(--text-primary)] uppercase font-bold transition">
        نسخه فارسی
      </a>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] tracking-tight mt-2">{en.title}</h1>
    <p class="mt-4 text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">{en.lead}</p>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[var(--text-primary)] tracking-tight">{en.s1Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">{en.s1Body1}</p>
      <p class="text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">{en.s1Body2}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[var(--text-primary)] tracking-tight">{en.s2Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">{en.s2Lead}</p>
      <div class="space-y-3">
        {(en.s2Items ?? []).map((item) => (
          <div class="bg-[var(--surface-card)] border border-[var(--border)] rounded-xl p-5 hover:border-[var(--accent-primary)] transition-colors">
            <h3 class="text-sm font-bold uppercase text-[var(--accent-warm)]">{item?.title ?? ''}</h3>
            <p class="text-xs leading-relaxed text-[var(--text-secondary)] mt-2">{item?.body ?? ''}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[var(--text-primary)] tracking-tight">{en.s3Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">{en.s3Body}</p>
      <ol class="list-decimal pl-5 space-y-2 text-xs sm:text-sm text-[var(--text-secondary)]">
        {(en.s3Steps ?? []).map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p class="text-[11px] text-[var(--text-muted)] mt-2">{en.fig1Caption}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[var(--text-primary)] tracking-tight">{en.s4Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">{en.s4Body}</p>
      {(en.s4Items ?? []).map((item) => (
        <div class="bg-[var(--surface-card)] border border-[var(--border)] rounded-xl p-5 hover:border-[var(--accent-primary)] transition-colors">
          <h3 class="text-sm font-bold uppercase text-[var(--accent-warm)]">{item?.title ?? ''}</h3>
          <p class="text-xs leading-relaxed text-[var(--text-secondary)] mt-2">{item?.body ?? ''}</p>
        </div>
      ))}
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[var(--text-primary)] tracking-tight">{en.s5Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">{en.s5Body}</p>
      {(en.s5Items ?? []).map((item) => (
        <div class="bg-[var(--surface-card)] border border-[var(--border)] rounded-xl p-5 hover:border-[var(--accent-primary)] transition-colors">
          <h3 class="text-sm font-bold uppercase text-[var(--accent-warm)]">{item?.title ?? ''}</h3>
          <p class="text-xs leading-relaxed text-[var(--text-secondary)] mt-2">{item?.body ?? ''}</p>
        </div>
      ))}
      <p class="text-[11px] text-[var(--text-muted)] mt-2">{en.fig2Caption}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[var(--text-primary)] tracking-tight">{en.s6Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">{en.s6Body}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{en.s7Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{en.s7Body}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{en.s8Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{en.s8Body}</p>
      <p class="text-[11px] text-[#64748b] mt-2">{en.fig3Caption}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{en.s9Title}</h2>
      <ul class="space-y-2 text-xs sm:text-sm text-[#94a3b8] list-disc pl-5">
        {(en.s9Items ?? []).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="text-xs sm:text-sm leading-relaxed text-[#e2c974] mt-3 font-semibold">{en.s9Note}</p>
    </section>
  </article>
</Layout>
