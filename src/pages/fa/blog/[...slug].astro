---
import { getCollection, render } from 'astro:content';
import FarsiBlogPost from '../../../layouts/FarsiBlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data, id }) => id.startsWith('fa/') || data.lang === 'fa');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^fa\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<FarsiBlogPost
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  technologies={post.data.technologies}
  metric={post.data.metric}
>
  <Content />
</FarsiBlogPost>
