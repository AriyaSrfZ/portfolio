---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.data.lang === 'fa' || post.id.startsWith('fa/'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryLabels: Record<string, string> = {
  'fintech': 'فین‌تک و پرداخت',
  'network-infrastructure': 'زیرساخت شبکه و مخابرات',
  'system-architecture': 'معماری سیستم‌های توزیع‌شده',
  'data-engineering': 'مهندسی داده',
  'product-management': 'استراتژی محصول فنی',
  'api-products': 'پلتفرم‌های API',
};

const categories = ['all', 'fintech', 'network-infrastructure', 'system-architecture', 'data-engineering', 'product-management'];
---

<Layout
  title="وبلاگ مهندسی و مستندات فنی معماری — آریا صراف‌زاده"
  description="یادداشت‌های میدانی، پیاده‌سازی دفتر کل توزیع‌شده، سوییچینگ مخابراتی، و استراتژی زیرساخت‌های بانکی ایران."
  lang="fa"
  dir="rtl"
>
  <main class="max-w-[1400px] mx-auto px-6 pt-24 pb-20 font-['Vazirmatn',sans-serif]" dir="rtl">
    <!-- Header -->
    <div class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-8 mb-8 shadow-2xl ring-1 ring-white/[0.03]">
      <div class="flex items-center gap-2 mb-2 font-mono text-[11px] text-[#94a3b8] uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
        <span>تحقیقات سیستمی · یادداشت‌های میدانی معماری · مقالات فنی</span>
        <div class="h-px flex-1 bg-white/[0.06]"></div>
        <span class="text-[10px] text-neutral-500 font-mono" dir="ltr">{posts.length} ARTICLES</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold uppercase text-[#ededed] mb-3 tracking-tight">
        وبلاگ مهندسی و مقالات تخصصی
      </h1>
      <p class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed max-w-3xl">
        بررسی عمیق معماری سوییچ‌های پرداخت شاپرکی <span dir="ltr">ISO 8583</span>، دفاتر کل دوطرفه <span dir="ltr">ACID</span>، مسیریابی مخابراتی <span dir="ltr">SMPP</span>، پایش ریسک و رهبری مهندسی در مقیاس ملی.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-2 mt-5 pt-4 border-t border-white/[0.06]">
        <button
          type="button"
          class="cat-filter-btn px-3 py-1 rounded-lg text-xs font-mono font-medium transition-all bg-white/10 border border-white/20 text-[#ededed]"
          data-category="all"
        >
          همه مقالات ({posts.length})
        </button>
        {categories.filter(c => c !== 'all').map((cat) => {
          const count = posts.filter(p => p.data.category === cat).length;
          if (count === 0) return null;
          return (
            <button
              type="button"
              class="cat-filter-btn px-3 py-1 rounded-lg text-xs font-mono font-medium transition-all bg-white/[0.03] border border-white/[0.06] text-[#94a3b8] hover:text-[#ededed] hover:border-white/15"
              data-category={cat}
            >
              {categoryLabels[cat] || cat} ({count})
            </button>
          );
        })}
      </div>
    </div>

    <!-- Articles Grid -->
    <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {posts.map((doc, idx) => (
        <article
          class="article-card bg-[#111317]/85 border border-white/[0.07] rounded-xl p-5 flex flex-col justify-between hover:border-white/20 transition-all duration-200 group"
          data-cat={doc.data.category}
        >
          <div>
            <div class="flex items-center justify-between border-b border-white/[0.06] pb-2.5 mb-3 font-mono text-[10px]">
              <span class="text-neutral-300 font-semibold tracking-wider">
                سند ۰{idx < 9 ? `۰${idx + 1}` : idx + 1} · {categoryLabels[doc.data.category] || doc.data.category}
              </span>
              {doc.data.metric && (
                <span class="text-[#10b981] px-1.5 py-0.5 rounded bg-white/[0.03] border border-white/[0.06]" dir="ltr">
                  {doc.data.metric}
                </span>
              )}
            </div>

            <h2 class="text-base font-bold text-[#ededed] uppercase group-hover:text-white transition-colors mb-2 leading-snug">
              <a href={`${baseUrl}fa/blog/${doc.id.replace(/^fa\//, '')}/`}>
                {doc.data.title}
              </a>
            </h2>

            <p class="text-xs text-[#94a3b8] leading-relaxed mb-4 line-clamp-3">
              {doc.data.description}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4" dir="ltr">
              {doc.data.technologies.slice(0, 4).map((t) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400">
                  [{t}]
                </span>
              ))}
            </div>
          </div>

          <div class="pt-3 border-t border-white/[0.06] flex justify-between items-center text-xs font-mono">
            <span class="text-[10px] text-neutral-500" dir="ltr">
              {doc.data.date.toLocaleDateString('fa-IR', { year: 'numeric', month: 'short' })}
            </span>
            <a
              href={`${baseUrl}fa/blog/${doc.id.replace(/^fa\//, '')}/`}
              class="font-medium text-[#ededed] hover:text-white flex items-center gap-1 group-hover:-translate-x-0.5 transition-transform"
            >
              مطالعه سند &larr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.cat-filter-btn');
      const cards = document.querySelectorAll('.article-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedCat = btn.getAttribute('data-category');

          filterBtns.forEach(b => {
            b.classList.remove('bg-white/10', 'border-white/20', 'text-[#ededed]');
            b.classList.add('bg-white/[0.03]', 'border-white/[0.06]', 'text-[#94a3b8]');
          });
          btn.classList.add('bg-white/10', 'border-white/20', 'text-[#ededed]');
          btn.classList.remove('bg-white/[0.03]', 'border-white/[0.06]', 'text-[#94a3b8]');

          cards.forEach(card => {
            const cardCat = card.getAttribute('data-cat');
            if (selectedCat === 'all' || cardCat === selectedCat) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</Layout>
