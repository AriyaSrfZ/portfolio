---
import Layout from '../../layouts/Layout.astro';
import Timeline from '../../components/Timeline.astro';
import CoreCompetencies from '../../components/CoreCompetencies.astro';
---

<Layout
  title="درباره آریا صراف‌زاده"
  description="مدیر ارشد محصول و معمار سیستم‌های فنی: بیش از ۱۵ سال تجربه در معماری و راهبری محصول سامانه‌های پرداخت، سوییچ‌های مخابراتی، کشف تقلب و پایپ‌لاین‌های داده."
  lang="fa"
  dir="rtl"
>
  <!-- Bio Header Section -->
  <section class="relative z-10 w-full max-w-5xl mx-auto px-6 pt-24 pb-10 text-center font-['Vazirmatn',sans-serif]" dir="rtl">
    <div class="relative inline-block mx-auto mb-5">
      <div class="relative z-10 w-28 h-28 rounded-2xl p-1 bg-[var(--surface-card)] border border-white/15 shadow-2xl overflow-hidden group">
        <img
          src={`${import.meta.env.BASE_URL}photos/ariya.jpg`}
          alt="آریا صراف‌زاده"
          class="w-full h-full object-cover rounded-xl opacity-100 transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </div>
    </div>
    
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2 text-[var(--text-primary)]">آریا صراف‌زاده</h1>
    
    <!-- Sub-head positioning statement -->
    <div class="max-w-2xl mx-auto mb-3">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--surface-elevated)] border border-[var(--border)] text-xs font-semibold text-[var(--accent-primary)] tracking-wide font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)]"></span>
        معمار سیستم‌ها و راهبر ارشد محصول فنی
      </span>
    </div>

    <p class="text-sm sm:text-base font-medium text-[var(--text-primary)] max-w-2xl mx-auto mb-2">
      سامانه‌هایی که زیر فشار تاب می‌آورند.
    </p>

    <p class="text-[var(--text-secondary)] text-xs sm:text-sm leading-relaxed max-w-2xl mx-auto">
      من در تقاطع معماری سیستم‌ها، مهندسی زیرساخت و تفکر محصول فعالیت می‌کنم؛ طراحی فناوری اتکاپذیر برای محیط‌های پیچیده و حیاتی. بیش از ۱۵ سال تجربه عملیاتی در سوییچ‌های پرداخت ISO 8583، دفاتر کل تغییرناپذیر، و هاب‌های ملی مخابرات.
    </p>
  </section>

  <!-- Cornerstone Section: The 0-to-Scale Story -->
  <section class="relative z-10 max-w-4xl mx-auto px-6 py-6 font-['Vazirmatn',sans-serif]" dir="rtl">
    <div class="bg-[var(--surface-card)] backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-8 shadow-2xl ring-1 ring-white/[0.03]">
      <div class="flex items-center justify-between border-b border-white/[0.06] pb-3 mb-5">
        <div class="flex items-center gap-2 font-mono text-[11px] text-[var(--text-secondary)] uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-warm)]"></span>
          <h2 class="text-base sm:text-lg font-bold text-[var(--text-primary)]">
            داستان تحول سیستم از صفر به مقیاس کشوری
          </h2>
        </div>
        <span class="text-[10px] text-neutral-400 px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06]">
          روایت بنیادین معماری
        </span>
      </div>

      <!-- Cornerstone Content -->
      <div class="p-5 bg-[var(--surface-card)] border border-white/[0.06] rounded-xl">
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          من وارد محیط‌هایی شدم که با سیستم‌های قدیمی جزیره‌ای و گلوگاه‌های همزمان درگیر بودند. زیرساخت‌ها زیر بار ترافیک ملی دچار افت عملکرد می‌شدند؛ تایم‌اوت درگاه‌ها مغایرت‌های مالی ایجاد می‌کرد و قواعد غیربهینه کنترل ریسک، جلوی درآمدهای مشروع را می‌گرفت. من این گلوگاه‌ها را به صورت سیستماتیک حذف کردم: سامانه <span dir="ltr">Switch-PSP</span> را برای مسیریابی پویا میان درگاه‌های پرداخت ملی پیاده‌سازی کردم، دفتر کل دوطرفه را با تخصیص دومرحله‌ای موجودی (تبدیل موجودی به رزرو) پایدار ساختم، امنیت داده‌های کارت را در زون ایزوله بانکی (PCI-DSS) پیاده کردم و فرآیند تسویه زودتر از موعد پذیرندگان (Merchant Credit) را به همراه همگامی نهایی در <span dir="ltr">RabbitMQ</span> و پایش شبانه با <span dir="ltr">Spring Batch</span> مستقر ساختم. ما از پردازش چند هزار رویداد به مدیریت پیک‌های ترافیک بالای ۵۰ هزار <span dir="ltr">TPS</span> با مغایرت مالی صفر رسیدیم.
        </p>
      </div>
    </div>
  </section>

  <CoreCompetencies locale="fa" />
  <Timeline locale="fa" />

  <section class="max-w-4xl mx-auto px-6 py-10 text-center font-['Vazirmatn',sans-serif]" dir="rtl">
    <a href="#book" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-semibold text-xs uppercase tracking-wider bg-[var(--accent-primary)] text-white hover:bg-[var(--accent-light)] transition-all shadow-md active:scale-[0.98]">
      رزرو جلسه بررسی معماری ↓
    </a>
  </section>
</Layout>
