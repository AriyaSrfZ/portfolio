---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { stats } from '../../data/stats';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const whitepapers = (await getCollection('blog', ({ id }) => id.startsWith('fa/')))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryLabels: Record<string, string> = {
  'fintech': 'فین‌تک و پرداخت',
  'network-infrastructure': 'زیرساخت مخابرات',
  'data-engineering': 'مهندسی داده',
  'system-architecture': 'معماری سیستم',
  'product-management': 'استراتژی محصول',
  'api-products': 'پلتفرم API',
};

// 4 Core Architectural Dossiers (FA)
const primaryDossiers = [
  {
    num: "۰۱",
    tag: "دفاتر کل و ACID",
    title: "معماری درگاه پرداخت: سوییچ‌های پرترافیک و دفاتر کل توزیع‌شده",
    slug: "payment-gateway",
    metric: stats.ledgerPeakTps.dossierFa,
    spec: "تخصیص دومرحله‌ای موجودی (AVAILABLE به RESERVED)، دفاتر کل ACID در ScyllaDB و PostgreSQL و قفل‌های توزیع‌شده Redis بدون مغایرت مالی.",
    chips: ["ISO 8583", "2PC RESERVATION", "REDIS SETNX", "SCYLLADB", "ACID"],
  },
  {
    num: "۰۲",
    tag: "سوییچینگ مخابرات و SMPP",
    title: "زیرساخت سوییچینگ پیامک کشوری و تجمیع‌کننده مخابراتی",
    slug: "sms-infrastructure",
    metric: stats.telecomHubAnnualVolume.badgeFa,
    spec: `کنترل جریان الگوریتم پنجره لغزان SMPP 3.4، تفکیک صفوف ارسال رمز پویای بانکی از پیامک‌های انبوه و جابجایی ${stats.switchFailoverSla.textFa} درگاه‌ها.`,
    chips: ["SMPP 3.4", "ISO 8583", "SLIDING WINDOW", "QUEUE ISOLATION", stats.switchFailoverSla.en.toUpperCase()],
  },
  {
    num: "۰۳",
    tag: "امنیت بانکی و شاهکار",
    title: "کاهش تقلب در لبه سیستم: تله‌متری بلادرنگ و گراف‌های ریسک",
    slug: "fraud-tracing",
    metric: stats.fraudRiskLoopSla.shortFa,
    spec: "سرویس رمز پویای حریم بانک مرکزی، استعلام هویتی شاهکار و ثبت‌احوال، و عدم ذخیره‌سازی داده‌های حساس CVV2/PIN مطابق الزامات شاپرک.",
    chips: ["PCI-DSS", "HARIM OTP", "SHAHKAR eKYC", "NEO4J", "3DS 2.0"],
  },
  {
    num: "۰۴",
    tag: "مغایرت‌گیری و تسویه",
    title: "مهاجرت از معماری یکپارچه به معماری رویدادمحور در جریان پرداخت",
    slug: "event-driven-migration",
    metric: stats.financialDriftPercent.zeroDriftFa,
    spec: `مش رویدادی RabbitMQ، ورکر‌های شبانه Spring Batch جهت پالایش مغایرت‌های بانکی و تسویه زودهنگام ${stats.merchantPayoutWindow.raw} ساعته پذیرندگان با پایا و ساتنا.`,
    chips: ["RABBITMQ", "SPRING BATCH", "REFUND-MNG", "PAYA / SATNA", "EARLY PAYOUT"],
  },
];

const toPersianNum = (n: number | string) => {
  const pNums = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
  return n.toString().split('').map(d => {
    const parsed = parseInt(d);
    return isNaN(parsed) ? d : pNums[parsed];
  }).join('');
};
---

<Layout
  title="مجموعه مقالات و مستندات مهندسی — آریا صراف‌زاده"
  description="تحلیل معماری سامانه‌های پردازش تراکنش، سوییچ‌های مخابراتی، و ایزوله‌سازی ریسک در زیرساخت‌های حیاتی."
  lang="fa"
  dir="rtl"
>
  <main class="max-w-[1400px] mx-auto px-6 pt-24 pb-20 font-['Vazirmatn',sans-serif]" dir="rtl">
    
    <!-- Header -->
    <div class="bg-[var(--surface-card)] backdrop-blur-xl border border-[var(--border)] rounded-2xl p-6 sm:p-8 mb-8 shadow-2xl">
      <div class="flex items-center gap-2 mb-2 font-mono text-[11px] text-[var(--text-secondary)] uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-warm)]"></span>
        <span>مستندات معماری تولیدی · مشخصات فنی</span>
        <div class="h-px flex-1 bg-[var(--border)]"></div>
        <span class="text-[10px] text-[var(--text-muted)] font-mono" dir="ltr">14 DOSSIERS</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold uppercase text-[var(--text-primary)] mb-3 tracking-tight">
        مجموعه مقالات و مستندات مهندسی
      </h1>
      <p class="text-[var(--text-secondary)] text-xs sm:text-sm leading-relaxed max-w-3xl">
        تحلیل عمیق معماری سوییچ‌های پرداخت شاپرکی، سوییچینگ مخابراتی، ایزوله‌سازی ریسک و مدیریت دفاتر کل مالی در زیرساخت‌های پرترافیک.
      </p>
    </div>

    <!-- 4 Core Featured Blueprint Dossiers -->
    <div class="mb-10 space-y-3">
      <div class="text-[11px] font-mono text-[var(--text-secondary)] uppercase tracking-wider flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)]"></span>
        <span>پرونده‌های کلیدی معماری (ماموریت‌های حیاتی)</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {primaryDossiers.map((item) => (
          <article class="bg-[var(--surface-card)] border border-[var(--border)] rounded-xl p-5 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all duration-200 group">
            <div>
              <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-[var(--border)] font-mono text-[10px]">
                <span class="text-[var(--text-primary)] font-semibold tracking-wider">
                  SPEC {item.num} · {item.tag}
                </span>
                <span class="text-[var(--accent-primary)] px-2 py-0.5 rounded bg-[var(--surface-sunken)] border border-[var(--border)]" dir="ltr">
                  {item.metric}
                </span>
              </div>

              <h2 class="text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors mb-2 leading-snug">
                <a href={`${baseUrl}fa/blog/${item.slug}/`}>
                  {item.title}
                </a>
              </h2>

              <p class="text-xs text-[var(--text-secondary)] leading-relaxed mb-4">
                {item.spec}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-4" dir="ltr">
                {item.chips.map((chip) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[var(--surface-sunken)] border border-[var(--border)] text-[var(--text-secondary)]">
                    [{chip}]
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-3 border-t border-[var(--border)] flex justify-between items-center text-xs font-mono">
              <span class="text-[10px] text-[var(--text-muted)] uppercase" dir="ltr">ACID VERIFIED</span>
              <a
                href={`${baseUrl}fa/blog/${item.slug}/`}
                class="font-semibold text-[var(--text-primary)] hover:text-[var(--accent-primary)] flex items-center gap-1 group-hover:-translate-x-0.5 transition-all"
              >
                مشاهده مشخصات فنی &larr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Complete Specification Library -->
    <div class="space-y-3">
      <div class="text-[11px] font-mono text-[var(--text-secondary)] uppercase tracking-wider flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-warm)]"></span>
        <span>کلیه مستندات و یادداشت‌های میدانی مهندسی ({whitepapers.length})</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {whitepapers.map((doc, idx) => (
          <article class="bg-[var(--surface-card)] border border-[var(--border)] rounded-xl p-4 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all group">
            <div>
              <div class="flex items-center justify-between border-b border-[var(--border)] pb-2 mb-3 font-mono text-[10px]">
                <span class="text-[var(--text-secondary)] uppercase">
                  SPEC {idx < 9 ? `۰${toPersianNum(idx + 1)}` : toPersianNum(idx + 1)} · {categoryLabels[doc.data.category] || doc.data.category}
                </span>
                {doc.data.metric && (
                  <span class="text-[var(--text-primary)] px-1.5 py-0.5 rounded bg-[var(--surface-sunken)] border border-[var(--border)]" dir="ltr">
                    {doc.data.metric}
                  </span>
                )}
              </div>

              <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors mb-2 leading-snug">
                <a href={`${baseUrl}fa/blog/${doc.id.replace(/^fa\//, '')}/`}>
                  {doc.data.title}
                </a>
              </h3>

              <p class="text-xs text-[var(--text-secondary)] leading-relaxed mb-4 line-clamp-2">
                {doc.data.description}
              </p>
            </div>

            <div class="pt-3 border-t border-[var(--border)] flex justify-between items-center text-[11px] font-mono">
              <span class="text-[var(--text-muted)]" dir="ltr">
                {doc.data.date.toLocaleDateString('fa-IR', { year: 'numeric', month: 'short' })}
              </span>
              <a
                href={`${baseUrl}fa/blog/${doc.id.replace(/^fa\//, '')}/`}
                class="text-[var(--text-primary)] hover:text-[var(--accent-primary)] flex items-center gap-1 font-medium"
              >
                مشاهده &larr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>
