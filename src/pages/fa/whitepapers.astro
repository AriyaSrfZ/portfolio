---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const whitepapers = (await getCollection('blog', ({ id }) => id.startsWith('fa/')))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryLabels: Record<string, string> = {
  'fintech': 'فین‌تک',
  'network-infrastructure': 'زیرساخت شبکه',
  'data-engineering': 'مهندسی داده',
  'system-architecture': 'معماری سیستم',
  'api-products': 'محصولات API',
};
---

<Layout
  title="مجموعه مقالات و مستندات مهندسی: آریا صراف‌زاده"
  description="تحلیل معماری سامانه‌های پردازش تراکنش، سوییچ‌های مخابراتی، و ایزوله‌سازی ریسک در زیرساخت‌های حیاتی."
  lang="fa"
  dir="rtl"
>
  <main class="max-w-[1400px] mx-auto px-6 pt-32 pb-24 font-['Vazirmatn',sans-serif]" dir="rtl">
    <div class="bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-10 mb-10 shadow-2xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase">مجموعه مستندات معماری · مشخصات فنی</span>
        <div class="h-px flex-1 bg-white/10"></div>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold uppercase text-[#f8fafc] mb-4 tracking-tight">
        مجموعه مقالات و مستندات مهندسی
      </h1>
      <p class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed max-w-3xl">
        تحلیل معماری سامانه‌های پردازش تراکنش، سوییچ‌های مخابراتی، و ایزوله‌سازی ریسک در زیرساخت‌های حیاتی.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {whitepapers.map((doc, idx) => (
        <article class="bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-7 flex flex-col justify-between shadow-xl ring-1 ring-white/5 group hover:border-cyan-500/40 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div>
            <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-4">
              <span class="text-[11px] font-bold text-[#e2c974] uppercase tracking-wider">
                سند ۰{idx + 1} · {categoryLabels[doc.data.category] ?? doc.data.category}
              </span>
              {doc.data.metric && (
                <span class="text-[10px] font-mono text-[#38bdf8] uppercase px-2 py-0.5 rounded bg-white/[0.04] border border-white/5" dir="ltr">
                  {doc.data.metric}
                </span>
              )}
            </div>

            <h2 class="text-lg font-bold text-[#f8fafc] uppercase group-hover:text-[#e2c974] transition mb-2">
              <a href={`${baseUrl}fa/blog/${doc.id.replace(/^fa\//, '')}/`}>
                {doc.data.title}
              </a>
            </h2>

            <p class="text-xs text-[#94a3b8] leading-relaxed mb-5">
              {doc.data.description}
            </p>

            <div class="flex flex-wrap gap-2 mb-5">
              {doc.data.technologies.map((t) => (
                <span class="text-[10px] px-2.5 py-1 rounded-md bg-white/[0.03] border border-white/10 text-[#38bdf8]">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-white/10 flex justify-between items-center text-xs">
            <span class="text-[11px] text-[#94a3b8] uppercase font-mono">
              {doc.data.date.toLocaleDateString('fa-IR', { year: 'numeric', month: 'short' })}
            </span>
            <a
              href={`${baseUrl}fa/blog/${doc.id.replace(/^fa\//, '')}/`}
              class="font-bold text-[#06b6d4] uppercase group-hover:underline flex items-center gap-1.5 transition-colors"
            >
              مشاهده مستندات فنی &larr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
