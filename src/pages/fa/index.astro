---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import BookingSection from '../../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="آریا صراف‌زاده | معماری سیستم‌های پرترافیک و راهبری محصول فنی" 
  description="معمار ارشد سامانه‌های توزیع‌شده و مدیر ارشد محصول فنی. طراحی سوییچ‌های پرداخت بانکی، هاب‌های ملی پیام‌رسانی و دفاتر کل فقط‌افزودنی."
  lang="fa"
  dir="rtl"
>
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-transparent via-white/50 to-transparent z-50 transition-all duration-100"></div>

  <Hero locale="fa" />

  <main class="max-w-[1500px] mx-auto px-6 py-10 font-['Vazirmatn',sans-serif]" id="blueprints" dir="rtl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Index -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-20 space-y-4">
        <div class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-4 shadow-2xl ring-1 ring-white/[0.03]">
          <div class="text-[11px] font-mono font-semibold text-[#ededed] uppercase tracking-wider mb-3 border-b border-white/[0.06] pb-2.5 flex justify-between items-center">
            <span>فهرست نقشه‌ها و سامانه‌ها</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-pulse"></span>
          </div>
          
          <nav class="space-y-1 text-xs">
            <a href="#payment-settlement" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              ۰۱ · دفتر کل دوطرفه و رزرو دومرحله‌ای
            </a>
            <a href="#fraud-forensics" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              ۰۲ · احراز هویت شاهکار و زون بانکی
            </a>
            <a href="#payment-switch" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              ۰۳ · سوییچ هوشمند پرداخت و روتینگ پویا
            </a>
            <a href="#reconciliation-engine" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              ۰۴ · مغایرت‌گیری خودکار و تسویه زودهنگام
            </a>
            <a href="#incident-dossiers" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              ۰۵ · تحلیل بحران‌های عملیاتی پروداکشن
            </a>
            <a href="#lifecycle" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              ۰۶ · چرخه حیات محصول فنی
            </a>
            <a href={`${baseUrl}fa/whitepapers/`} class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              ۰۷ · مستندات مهندسی و وایت‌پیپرها
            </a>
            <a href="#book" class="block px-2.5 py-1.5 rounded-lg text-[#94a3b8] hover:bg-white/[0.04] hover:text-[#ededed] transition-all">
              ۰۸ · جلسه بررسی معماری
            </a>
          </nav>
        </div>
      </aside>

      <!-- Main Blueprint Sections -->
      <div class="lg:col-span-9 space-y-8">
        
        <!-- SECTION 01: Double-Entry Ledger & Settlements -->
        <section id="payment-settlement" class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-7 shadow-2xl ring-1 ring-white/[0.03] transition-all duration-300 hover:border-white/15">
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-7 items-start">
            <!-- Right: Breakdown in RTL -->
            <div class="xl:col-span-7 space-y-3.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                <span class="text-[11px] font-mono uppercase tracking-wider text-[#94a3b8]">۰۱ · تسویه مالی و دفاتر کل</span>
                <div class="h-px flex-1 bg-white/[0.06]"></div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400" dir="ltr">DOSSIER 01</span>
              </div>

              <h2 class="text-xl sm:text-2xl font-bold text-[#ededed] tracking-tight">
                دفتر کل دوطرفه (<span dir="ltr">Double-Entry</span>) و موتور تخصیص دومرحله‌ای موجودی
              </h2>

              <div class="p-3.5 bg-[#090a0c]/80 border border-white/[0.07] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">اصل تخطی‌ناپذیر معماری (Invariant)</span>
                <p class="text-[#ededed] leading-relaxed text-[11.5px]">
                  منبع یگانه حقیقت مالی (<span dir="ltr">Single Source of Truth</span>). حذف قطعی تسویه مضاعف در پنجره بازپخش ۲۴ ساعته با ماشین حالت تخصیص دومرحله‌ای موجودی (<span dir="ltr">AVAILABLE &rarr; RESERVED</span>) و پایداری قطعی تراز ریاضی بدهکار و بستانکار (<span dir="ltr">&Sigma; Debits &minus; &Sigma; Credits = 0</span>).
                </p>
              </div>

              <div class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed space-y-2">
                <p>
                  جهش‌های مالی و شارژ کیف پول با کلید یکتای ایدامپوتنسي (<span dir="ltr">UUIDv4</span>) و قفل توزیع‌شده <span dir="ltr">Redis SETNX</span> با طول عمر ۲۴ ساعته کنترل می‌شوند. تخصیص موجودی از طریق ماشین حالت دومرحله‌ای، وجوه را پیش از ارسال به درگاه از وضعیت موجود (<span dir="ltr">AVAILABLE</span>) به رزروشده (<span dir="ltr">RESERVED</span>) منتقل می‌کند. پس از تایید نهایی، رکوردهای تسویه به‌صورت تغییرناپذیر (<span dir="ltr">Append-Only</span>) در دفتر کل دوطرفه <span dir="ltr">ScyllaDB</span> و <span dir="ltr">PostgreSQL</span> با تضمین <span dir="ltr">ACID</span> ثبت شده و از هرگونه شناوری مالی ثبت‌نشده جلوگیری می‌شود.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-[#d97706]">حالت خرابی و راهکار تاب‌آوری</span>
                <p class="text-[#94a3b8] leading-relaxed text-[11.5px]">
                  تایم‌اوت‌های جزئی شبکه یا قطعی کارگزار پیام هنگام به‌روزرسانی چندبخشی دفاتر کل بانکی. مهارشده با الگوی اوت‌باکس تراکنشی (<span dir="ltr">Transactional Outbox</span>) و بازیابی حالت توزیع‌شده مبتنی بر <span dir="ltr">Raft</span> جهت رد وضعیت‌های تاییدنشده گذرا.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">تصمیم محصولی و تریدآف مهندسی</span>
                <div class="text-[#cbd5e1] space-y-1 text-[11.5px] leading-relaxed">
                  <p><strong class="text-[#ededed]">چرا این تصمیم:</strong> مغایرت‌های مقطعی ناشی از هم‌روندی بالای کاربران حین شارژ کیف پول می‌توانست به جریمه‌های رگولاتوری بانکی بینجامد.</p>
                  <p><strong class="text-[#ededed]">تریدآف:</strong> اولویت دادن به قفل‌های سخت‌گیرانه دومرحله‌ای نسبت به ثبت آپتیمیستیک سریع داده.</p>
                  <p><strong class="text-[#ededed]">نتیجه کسب‌وکار:</strong> تراز ۱۰۰ درصدی دفاتر کل مالی در بیش از ۵۰ هزار تراکنش روزانه بدون حتی یک ریال پرداخت مضاعف.</p>
                </div>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-1" dir="ltr">
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[ACID]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[2PC RESERVATION]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[REDIS SETNX]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[SCYLLADB]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[ZERO DRIFT]</span>
              </div>

              <div class="pt-2 flex items-center justify-between text-xs border-t border-white/[0.06]">
                <span class="text-neutral-500 font-mono text-[10px]" dir="ltr">SPECIFICATION: DOSSIER 01</span>
                <a href={`${baseUrl}fa/blog/payment-gateway/`} class="font-mono text-xs font-medium text-[#ededed] hover:text-white inline-flex items-center gap-1 group">
                  <span>مطالعه سند کامل پرونده</span>
                  <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
                </a>
              </div>
            </div>

            <!-- Left in RTL: Flow Diagram & Parameters -->
            <div class="xl:col-span-5 space-y-3">
              <div class="bg-[#090a0c] border border-white/[0.08] rounded-xl p-3 sm:p-4 shadow-inner" dir="ltr">
                <div class="flex items-center justify-between text-[10px] font-mono text-neutral-500 pb-2 border-b border-white/[0.06] mb-3">
                  <span>TOPOLOGY SCHEMATIC</span>
                  <span class="text-emerald-500">2PC · VERIFIED</span>
                </div>
                <img 
                  src={`${baseUrl}diagrams/double-entry-ledger-schematic.svg?v=fintech-2026`} 
                  alt="Double-Entry Ledger and Two-Phase Reservation Topology Schematic"
                  class="w-full h-auto object-contain rounded filter contrast-105"
                  loading="lazy"
                />
              </div>

              <div class="grid grid-cols-2 gap-2 text-[10px] font-mono" dir="ltr">
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">REPLAY WINDOW</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">86,400s (24h)</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">MUTEX LOCK TTL</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">15,000ms</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">LEDGER STORE</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">ScyllaDB / Postgres</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">DRIFT AUDIT</div>
                  <div class="text-[#10b981] font-semibold mt-0.5">0.00 IRR (ZERO)</div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Divider -->
        <div class="flex items-center justify-center gap-4 my-1 opacity-60">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
          <span class="w-1.5 h-1.5 rounded-full bg-white/20"></span>
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
        </div>

        <!-- SECTION 02: Fraud Forensics & eKYC -->
        <section id="fraud-forensics" class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-7 shadow-2xl ring-1 ring-white/[0.03] transition-all duration-300 hover:border-white/15">
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-7 items-start">
            <!-- Right: Breakdown in RTL -->
            <div class="xl:col-span-7 space-y-3.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                <span class="text-[11px] font-mono uppercase tracking-wider text-[#94a3b8]">۰۲ · ارزیابی ریسک و احراز هویت</span>
                <div class="h-px flex-1 bg-white/[0.06]"></div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400" dir="ltr">DOSSIER 02</span>
              </div>

              <h2 class="text-xl sm:text-2xl font-bold text-[#ededed] tracking-tight">
                احراز هویت شاهکار، رمز پویای حریم و زون توکنایزیشن <span dir="ltr">PCI-DSS</span>
              </h2>

              <div class="p-3.5 bg-[#090a0c]/80 border border-white/[0.07] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">اصل تخطی‌ناپذیر معماری (Invariant)</span>
                <p class="text-[#ededed] leading-relaxed text-[11.5px]">
                  ذخیره‌سازی صفر داده‌های حساس <span dir="ltr">CVV2/PIN</span> پس از اخذ تاییدیه بانکی و تطبیق رمز پویای ۴مولفه‌ای حریم بانک مرکزی با هویت ملی و شماره کارت.
                </p>
              </div>

              <div class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed space-y-2">
                <p>
                  اطلاعات کارت مستقیماً وارد زون ایزوله بانکی شده و سامانه توکن‌ساز، شماره کارت خام را با توکن‌های امن جایگزین می‌کند؛ کدهای <span dir="ltr">CVV2</span> بلافاصله پس از تراکنش پاکسازی می‌شوند. احراز هویت شاهکار (تطبیق کدملی با شماره موبایل) و استعلام ثبت‌احوال با سامانه رمز پویای حریم تلفیق شده و بردارهای ریسک بلادرنگ زیر ۱۵ میلی‌ثانیه در خوشه‌های گراف <span dir="ltr">Neo4j</span> محاسبه می‌شوند.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-[#d97706]">حالت خرابی و راهکار تاب‌آوری</span>
                <p class="text-[#94a3b8] leading-relaxed text-[11.5px]">
                  حملات تعویض سیم‌کارت (<span dir="ltr">SIM-Swap</span>) و شبکه‌های فیشینگ رمز پویا. مهارشده با اعتبارسنجی رمزنگاری‌شده تاریخ صدور سیم‌کارت در سامانه شاهکار حین درخواست رمز پویا.
                </p>
              </div>

              <div class="p-3 bg-[#090a0c]/60 border border-white/[0.06] rounded-xl text-xs space-y-1">
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-neutral-300">تصمیم محصولی و تریدآف مهندسی</span>
                <div class="text-[#cbd5e1] space-y-1 text-[11.5px] leading-relaxed">
                  <p><strong class="text-[#ededed]">چرا این تصمیم:</strong> ذخیره آسان داده‌های پرداخت باعث سهولت کاربر می‌شد اما ریسک نشت داده و مسئولیت مالی جبران‌ناپذیر به همراه داشت.</p>
                  <p><strong class="text-[#ededed]">تریدآف:</strong> عدم ذخیره‌سازی داده‌های کارت خام و تبعیت بدون اغماض از الزامات شاپرک و استانداردهای ایزولاسیون.</p>
                  <p><strong class="text-[#ededed]">نتیجه کسب‌وکار:</strong> کاهش ۹۴ درصدی تراکنش‌های مشکوک و انتقال بار حقوقی تقلب به بانک‌های صادرکننده با پروتکل <span dir="ltr">3DS 2.0</span>.</p>
                </div>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-1" dir="ltr">
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[PCI-DSS]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[HARIM OTP]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[SHAHKAR eKYC]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[NEO4J FORENSICS]</span>
                <span class="px-2 py-0.5 bg-white/[0.03] border border-white/[0.07] rounded text-neutral-300 text-[10px] font-mono">[&lt;15MS RISK LOOP]</span>
              </div>

              <div class="pt-2 flex items-center justify-between text-xs border-t border-white/[0.06]">
                <span class="text-neutral-500 font-mono text-[10px]" dir="ltr">SPECIFICATION: DOSSIER 02</span>
                <a href={`${baseUrl}fa/blog/fraud-tracing/`} class="font-mono text-xs font-medium text-[#ededed] hover:text-white inline-flex items-center gap-1 group">
                  <span>مطالعه سند کامل پرونده</span>
                  <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
                </a>
              </div>
            </div>

            <!-- Left in RTL: Flow Diagram & Parameters -->
            <div class="xl:col-span-5 space-y-3">
              <div class="bg-[#090a0c] border border-white/[0.08] rounded-xl p-3 sm:p-4 shadow-inner" dir="ltr">
                <div class="flex items-center justify-between text-[10px] font-mono text-neutral-500 pb-2 border-b border-white/[0.06] mb-3">
                  <span>THREAT TOPOLOGY</span>
                  <span class="text-emerald-500">PCI-DSS · ISOLATED</span>
                </div>
                <img 
                  src={`${baseUrl}diagrams/fraud-tracing-architecture.svg?v=fintech-2026`} 
                  alt="eKYC, Harim Dynamic OTP and Forensic Graph Tracing Schematic"
                  class="w-full h-auto object-contain rounded filter contrast-105"
                  loading="lazy"
                />
              </div>

              <div class="grid grid-cols-2 gap-2 text-[10px] font-mono" dir="ltr">
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">RISK EVAL SLA</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">&lt;15ms (P99)</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">CVV2 RETENTION</div>
                  <div class="text-[#10b981] font-semibold mt-0.5">0.00s (EPHEMERAL)</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">IDENTITY ENGINE</div>
                  <div class="text-[#ededed] font-semibold mt-0.5">Shahkar / Sabt-Ahval</div>
                </div>
                <div class="p-2.5 bg-[#090a0c]/60 border border-white/[0.06] rounded-lg">
                  <div class="text-neutral-500 uppercase">FRAUD DRAIN DROP</div>
                  <div class="text-[#10b981] font-semibold mt-0.5">-94% VERIFIED</div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Divider -->
        <div class="flex items-center justify-center gap-4 my-1 opacity-60">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
          <span class="w-1.5 h-1.5 rounded-full bg-white/20"></span>
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
        </div>

        <!-- SECTION 03: Smart PSP Switch & Dynamic Weighted Routing -->
        <section id="payment-switch" class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-7 shadow-2xl ring-1 ring-white/[0.03] transition-all duration-300 hover:border-white/15">
          <span id="sms-gateway" class="sr-only"></span>
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-7 items-start">
            <!-- Right: Breakdown in RTL -->
