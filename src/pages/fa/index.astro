---
import Layout from '../../layouts/Layout.astro';
import LandingStage from '../../components/react/LandingStage';
import ArchitectureSidebar from '../../components/react/ArchitectureSidebar';
import BookingSection from '../../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="آریا صراف‌زاده | معماری سیستم‌های پرترافیک و راهبری محصول فنی" 
  description="معمار ارشد سامانه‌های توزیع‌شده و مدیر ارشد محصول فنی. طراحی سوییچ‌های پرداخت بانکی، هاب‌های ملی پیام‌رسانی و دفاتر کل فقط‌افزودنی."
  lang="fa"
  dir="rtl"
>
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-transparent via-white/50 to-transparent z-50 transition-all duration-100"></div>

  <main class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 pt-18 pb-16 font-['Vazirmatn',sans-serif]" id="blueprints" dir="rtl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Index & Minimized Bio (Persian RTL) -->
      <ArchitectureSidebar client:load locale="fa" />

      <!-- Main Stage Pages (Separated Full Posture Pages) -->
      <div class="lg:col-span-9 space-y-16">

        <!-- PAGE 01: EXECUTIVE LANDING OVERVIEW -->
        <LandingStage client:load locale="fa" />

        <!-- PAGE 02: DOSSIER 01 - Settlements & Ledgers -->
        <section id="payment-settlement" class="scroll-mt-20 min-h-[calc(100vh-5.5rem)] flex flex-col justify-between bg-[#0f1217]/90 border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl ring-1 ring-white/5 space-y-6 hover:border-white/20 transition-all">
      <!-- Header -->
      <div class="space-y-2">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2 font-mono text-xs text-neutral-300 uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>۰۱ · تسویه مالی و دفاتر کل توزیع‌شده</span>
          </div>
          <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded" dir="ltr">
            DOSSIER 01 · ACID
          </span>
        </div>
        <h2 class="text-xl md:text-2xl font-bold text-white tracking-tight">
          دفتر کل دوطرفه (<span dir="ltr">Double-Entry</span>) و موتور تخصیص دومرحله‌ای موجودی
        </h2>
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">ظرفیت اوج پردازش</span>
          <span class="text-white font-semibold text-sm" dir="ltr">50,000 TPS</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">طول عمر قفل ردیس</span>
          <span class="text-cyan-400 font-semibold text-sm" dir="ltr">15,000ms SETNX</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">پنجره بازپخش مجدد</span>
          <span class="text-white font-semibold text-sm">۲۴ ساعت (۸۶,۴۰۰s)</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">انحراف مالی در تراز</span>
          <span class="text-emerald-400 font-semibold text-sm">۰٫۰۰٪ (صفر مطلق)</span>
        </div>
      </div>

      <!-- Architecture Blueprint (Full-Width Interactive SVG Container) -->
      <div class="bg-[#13161c] border border-white/10 rounded-xl p-2 md:p-3 shadow-inner w-full" dir="ltr">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-300 mb-2 px-2 pb-2 border-b border-white/5">
          <span class="tracking-wider uppercase">ARCHITECTURE BLUEPRINT · TOPOLOGY SCHEMATIC</span>
          <span class="text-emerald-400 font-semibold">2PC VERIFIED</span>
        </div>
        <img 
          src={`${baseUrl}diagrams/double-entry-ledger-schematic.svg?v=fintech-v3`} 
          alt="Double-Entry Ledger and Two-Phase Reservation Topology Schematic"
          class="w-full h-auto block rounded"
          loading="eager"
        />
      </div>

      <!-- 2-Column Technical Spec (Balanced 50/50 Grid in RTL) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <!-- Right: Invariants & Mechanism -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>اصول تخطی‌ناپذیر معماری و منطق تسویه</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>منبع یگانه حقیقت مالی (SSOT):</strong> تضمین ریاضی پایدار <span dir="ltr">&Sigma; Debits &minus; &Sigma; Credits = 0</span> روی جداول وقایع تغییرناپذیر در <span dir="ltr">ScyllaDB</span> و <span dir="ltr">PostgreSQL</span>.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>ماشین حالت رزرو دومرحله‌ای:</strong> انتقال سرمایه از وضعیت <code class="text-amber-400 font-mono text-xs bg-white/5 px-1 py-0.5 rounded" dir="ltr">AVAILABLE</code> به <code class="text-cyan-400 font-mono text-xs bg-white/5 px-1 py-0.5 rounded" dir="ltr">RESERVED</code> پیش از فراخوانی وب‌هوک‌های بانکی بالادست.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>ایدامپوتنسي توزیع‌شده:</strong> قفل‌های موقت اتمیک <span dir="ltr">Redis SETNX</span> مبتنی بر <span dir="ltr">UUIDv4</span> با پنجره بازپخش ۲۴ ساعته جهت پیشگیری از کسر تکراری.</span>
            </li>
          </ul>
        </div>

        <!-- Left: Failure Modes & Recovery -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>حالات خرابی و بازیابی خودکار</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>تایم‌اوت‌های شبکه بانکی:</strong> مهارشده با الگوی <span dir="ltr">Transactional Outbox</span> و بازیابی وضعیت توزیع‌شده مبتنی بر <span dir="ltr">Raft</span> برای رد حالت‌های گذرا.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>رول‌بک خودکار تراز:</strong> آزادسازی آنی موجودی بلوکه‌شده به وضعیت قابل‌مصرف در صورت انقضای زمان تراکنش یا رسیدن پاسخ عدم تایید از شاپرک.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>دستاورد پروداکشن:</strong> تراز کامل ۱۰۰ درصدی در بیش از ۵۰ هزار تراکنش روزانه بدون حتی یک مورد واریز تکراری یا مغایرت پولی.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Product Decision Box -->
      <div class="bg-[#13161c]/80 border border-white/10 rounded-xl p-5 space-y-3">
        <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-[#38bdf8]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
          <span>تصمیم محصول · دوره دیجی‌پی (DigiPay Core Ledger)</span>
        </div>
        <div class="text-xs sm:text-sm text-neutral-300 space-y-2 leading-relaxed">
          <p><strong class="text-white">چرا این تصمیم و چرا در آن مقطع:</strong> ناهمخوانی دفاتر کل و مانده‌های شبح هنگام تراکنش‌های همزمان بالا، جایگاه شرکت نزد مراجع نظارتی و بانک مرکزی را به خطر می‌انداخت.</p>
          <p><strong class="text-white">موازنه‌ها و بده‌بستان‌ها (Trade-off):</strong> اولویت‌دادن به تخصیص دومرحله‌ای همگام موجودی و تراز قطعی دفاتر کل بر سرعت خام پردازش تراکنش‌ها.</p>
          <p><strong class="text-white">مخالفت ذی‌نفعان و نحوه حل اختلاف:</strong> تیم رشد و بازاریابی خواستار تراکنش‌های بدون رزرو زیر ۱۰ میلی‌ثانیه بود؛ من اثبات کردم جلوگیری از اضافه برداشت بدون پشتوانه برای حسابرسی بانک مرکزی اجتناب‌ناپذیر است.</p>
          <p><strong class="text-white">دست‌آورد و خروجی کسب‌وکاری:</strong> حفظ ۱۰۰ درصدی تراز ریاضی دفاتر کل در بیش از ۵۰ هزار تراکنش روزانه بدون حتی یک مورد واریز تکراری یا نشت مالی.</p>
        </div>
      </div>

      <!-- Footer Bar -->
      <div class="flex flex-wrap items-center justify-between pt-4 border-t border-white/5 gap-3 font-mono text-xs">
        <div class="flex flex-wrap gap-1.5" dir="ltr">
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[ACID]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[2PC RESERVATION]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[REDIS SETNX]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[SCYLLADB]</span>
        </div>
        <a href={`${baseUrl}fa/blog/payment-gateway/`} class="text-white hover:text-cyan-400 font-semibold inline-flex items-center gap-1 group transition-colors">
          <span>مطالعه کامل مشخصات وایت‌پیپر</span>
          <span class="group-hover:-translate-x-1 transition-transform">&larr;</span>
        </a>
      </div>

      <!-- Rolling Stepper Bar (Persian RTL) -->
      <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
        <a href="#overview" class="text-neutral-400 hover:text-white flex items-center gap-1.5 transition-colors">
          <span>↑</span>
          <span>صفحه قبل: نمایه اجرایی</span>
        </a>
        <span class="text-[10px] text-neutral-500 uppercase font-mono">صفحه ۰۲ از ۰۸ · پرونده ۰۱</span>
        <a href="#payment-switch" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center gap-1.5 transition-all">
          <span>صفحه بعد: سوییچ پرداخت</span>
          <span>↓</span>
        </a>
      </div>
    </section>


    <!-- DOSSIER 02: Smart PSP Switch & Dynamic Weighted Routing -->
    <section id="payment-switch" class="scroll-mt-20 min-h-[calc(100vh-5.5rem)] flex flex-col justify-between bg-[#0f1217]/90 border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl ring-1 ring-white/5 space-y-6 hover:border-white/20 transition-all">
      <span id="sms-gateway" class="sr-only"></span>
      <!-- Header -->
      <div class="space-y-2">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2 font-mono text-xs text-neutral-300 uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>۰۲ · سوییچ پرداخت و پروتکل‌های مخابراتی</span>
          </div>
          <span class="text-xs font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-2.5 py-0.5 rounded" dir="ltr">
            DOSSIER 02 · ISO 8583
          </span>
        </div>
        <h2 class="text-xl md:text-2xl font-bold text-white tracking-tight">
          سوییچ هوشمند پرداخت و موتور روتینگ پویای چنددرگاهی (<span dir="ltr">ISO 8583</span>)
        </h2>
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">سرعت تغییر مسیر</span>
          <span class="text-cyan-400 font-semibold text-sm" dir="ltr">&lt;30ms Failover</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">پروتکل سوییچ</span>
          <span class="text-white font-semibold text-sm" dir="ltr">ISO 8583 MTI 0200</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">دسترسی‌پذیری سوییچ</span>
          <span class="text-emerald-400 font-semibold text-sm" dir="ltr">99.99% Uptime</span>
        </div>
        <div class="bg-[#13161c] border border-white/10 rounded-lg p-3">
          <span class="text-neutral-400 block text-[10px] uppercase">رشد نرخ تبدیل</span>
          <span class="text-emerald-400 font-semibold text-sm" dir="ltr">+14% Gain</span>
        </div>
      </div>

      <!-- Architecture Blueprint (Full-Width Interactive SVG Container) -->
      <div class="bg-[#13161c] border border-white/10 rounded-xl p-2 md:p-3 shadow-inner w-full" dir="ltr">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-300 mb-2 px-2 pb-2 border-b border-white/5">
          <span class="tracking-wider uppercase">MULTI-PSP HEAD-TO-HEAD (H2H) ROUTING PIPELINE</span>
          <span class="text-cyan-400 font-semibold">DYNAMIC WEIGHTED SLAS</span>
        </div>
        <img 
          src={`${baseUrl}diagrams/payment-switch-iso8583-pipeline.svg?v=fintech-v3`} 
          alt="Smart PSP Switch and ISO 8583 Pipeline Topology Schematic"
          class="w-full h-auto block rounded"
          loading="eager"
        />
      </div>

      <!-- 2-Column Technical Spec (Balanced 50/50 Grid in RTL) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <!-- Right: Invariants & Mechanism -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>معماری روتینگ و اتصال چنددرگاهی</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>سوییچ Head-to-Head (H2H):</strong> پردازش مستقیم تلگرام‌های مالی <span dir="ltr">ISO 8583</span> با استخراج بلادرنگ کدهای <span dir="ltr">STAN</span> و <span dir="ltr">RRN</span> و هدرهای احراز هویت.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>هدایت هوشمند چنددرگاهی:</strong> توزیع ترافیک میان شرکت‌های پرداخت ملی (سامان، پارسیان، به‌پرداخت، پاسارگاد) از طریق آداپتورهای هاب فناوران.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>اوزان پویا بر پایه سلامت:</strong> ارزیابی لحظه‌ای تاخیر <span dir="ltr">P99</span>، نرخ موفقیت، و کارمزدهای تجاری پذیرندگان پیش از ارسال درخواست پرداخت.</span>
            </li>
          </ul>
        </div>

        <!-- Left: Failure Modes & Recovery -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>فیوزهای قطع مدار و مهار افت کیفیت</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>سقوط سوکت درگاه:</strong> با افزایش خطاهای ارتباطی، فیوز مدار در کمتر از ۳۰ میلی‌ثانیه درگاه ناسالم را از چرخه پردازش خارج می‌کند.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>عدم ریزش سبد خرید:</strong> درخواست‌های جاری بدون نیاز به ورود مجدد کاربر بلافاصله به درگاه‌های پشتیبان هدایت می‌شوند.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>کنترل جریان مخابراتی SMPP:</strong> کنترل نرخ ارسال با پنجره لغزان (۱۶ تا ۶۴ PDU) جهت تضمین رسیدن پیامک رمز پویا در کمتر از ۲ ثانیه.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Product Decision Box -->
      <div class="bg-[#13161c]/80 border border-white/10 rounded-xl p-5 space-y-3">
        <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-[#38bdf8]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
          <span>تصمیم محصول · سوییچ چنددرگاهی آگنوستیک</span>
        </div>
        <div class="text-xs sm:text-sm text-neutral-300 space-y-2 leading-relaxed">
          <p><strong class="text-white">چرا این تصمیم و چرا در آن مقطع:</strong> وابستگی به یک <span dir="ltr">PSP</span> انحصاری در زمان اختلالات شاپرک و تسویه بانکی باعث ریزش شدید خریدهای کاربران می‌شد.</p>
          <p><strong class="text-white">موازنه‌ها و بده‌بستان‌ها (Trade-off):</strong> توسعه سوییچ چنددرگاهی آگنوستیک با تخصیص پویای اوزان به جای تکیه بر قرارداد با یک شرکت <span dir="ltr">PSP</span> منفرد.</p>
          <p><strong class="text-white">مخالفت ذی‌نفعان و نحوه حل اختلاف:</strong> مدیران حساب درگاه‌های سنتی با تنوع‌بخشی به مسیرها مخالفت داشتند؛ من نشان دادم روتینگ پویا نرخ تبدیل پرداخت را ۱۴ درصد افزایش داده است.</p>
          <p><strong class="text-white">دست‌آورد و خروجی کسب‌وکاری:</strong> دست‌یابی به آپ‌تایم ۹۹٫۹۹ درصدی درگاه، تاخیر رفت‌وبرگشت زیر ۲۵۰ میلی‌ثانیه و بازگشت خودکار ۳۰ میلی‌ثانیه‌ای در قطعی‌های شبکه شاپرک.</p>
        </div>
      </div>

      <!-- Footer Bar -->
      <div class="flex flex-wrap items-center justify-between pt-4 border-t border-white/5 gap-3 font-mono text-xs">
        <div class="flex flex-wrap gap-1.5" dir="ltr">
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[ISO 8583]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[FARAVARAN HUB]</span>
