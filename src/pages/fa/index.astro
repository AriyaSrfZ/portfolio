---
import Layout from '../../layouts/Layout.astro';
import OperationsConsole from '../../components/react/OperationsConsole';

const title = "آریا صراف‌زاده | کنسول عملیات و معماری سیستم‌های توزیع‌شده";
const description = "کنسول عملیات و معماری سیستم‌های پرترافیک، سوییچ‌های پرداخت بانکی، هاب‌های پیام‌رسانی و دفاتر کل توزیع‌شده.";
---

<Layout 
  title={title}
  description={description}
  lang="fa"
  dir="rtl"
  viewportLocked={true}
>
  <OperationsConsole client:load locale="fa" />
</Layout>
