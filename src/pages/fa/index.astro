---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import BookingSection from '../../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="آریا صراف‌زاده | معماری سیستم‌های پرترافیک و راهبری محصول فنی" 
  description="معمار ارشد سامانه‌های توزیع‌شده و مدیر ارشد محصول فنی. طراحی سوییچ‌های پرداخت بانکی، هاب‌های ملی پیام‌رسانی در مقیاس مگفا و فرستار، و خطوط پردازش کلان‌داده سازمانی."
  lang="fa"
  dir="rtl"
>
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-[#06b6d4] via-[#e2c974] to-[#38bdf8] z-50 transition-all duration-100"></div>

  <Hero locale="fa" />

  <main class="max-w-[1600px] mx-auto px-6 py-12 font-['Vazirmatn',sans-serif]" id="blueprints" dir="rtl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Index -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 space-y-4">
        <div class="bg-[#111827]/70 backdrop-blur-xl border border-white/10 rounded-2xl p-5 shadow-2xl ring-1 ring-white/5">
          <div class="text-xs font-bold text-[#e2c974] tracking-wider uppercase mb-3 border-b border-white/10 pb-2.5 flex justify-between items-center">
            <span>فهرست نقشه‌ها و سامانه‌ها</span>
            <span class="w-2 h-2 rounded-full bg-[#38bdf8] shadow-[0_0_8px_rgba(201,212,168,0.6)] animate-signal"></span>
          </div>
          
          <nav class="space-y-1 text-xs">
            <a href="#payment-settlement" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۱ · سوییچ پرداخت و دفاتر کل مالی
            </a>
            <a href="#fraud-forensics" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۲ · مهار بلادرنگ تقلب و گراف ارتباطات
            </a>
            <a href="#sms-gateway" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۳ · زیرساخت مقیاس‌پذیر پیام‌رسانی (SMPP)
            </a>
            <a href="#data-pipeline" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۴ · خط داده و موتور تحلیلی ۱۰۰M رکوردی
            </a>
            <a href="#incident-dossiers" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۵ · پرونده‌های بحران‌های زنده در پروداکشن
            </a>
            <a href="#lifecycle" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۶ · چرخه حیات محصول فنی
            </a>
            <a href={`${baseUrl}fa/whitepapers/`} class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۷ · مستندات معماری و وایت‌پیپرها
            </a>
            <a href="#book" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۸ · جلسه بررسی معماری
            </a>
          </nav>
        </div>
      </aside>

      <!-- Main Blueprint Sections -->
      <div class="lg:col-span-9 space-y-10">
        
        <!-- SECTION 01: Payment Settlement -->
        <section id="payment-settlement" class="bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase">۰۱ · سوییچ پرداخت و دفاتر کل مالی</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">موتور تسویه رویدادمحور و سوییچ تراکنش‌های هم‌روند</h2>
          
          <!-- Invariant Box: Refined Badge -->
          <div class="mt-4 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">اصل تخطی‌ناپذیر معماری (Invariant)</span>
            </div>
            <p class="text-[#f8fafc] leading-relaxed">حالت درخواست &ne; واقعیت تسویه. حذف قطعی تسویه مضاعف و تضمین مغایرت مالی صفر در پنجره‌های بازپخش ۸۶٬۴۰۰ ثانیه‌ای.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              لبه ورودی با پروتکل TLS 1.3 قفل توزیع‌شده اتمی Redis با دستور <code class="text-[#e2c974] bg-white/[0.04] px-1.5 py-0.5 rounded font-mono">SETNX</code> و انقضای ۸۶٬۴۰۰ ثانیه را ثبت می‌کند. داده‌ها مستقیماً به ساختار بیت‌مپ باینری ISO 8583 جهت اتصال به سوییچ‌های شاپرک و شبکه‌های شتاب تبدیل می‌شوند. مانده‌حساب‌ها صرفاً از طریق بازپخش ترتیبی رویدادها در کلاستر دفتر کل فقط‌افزودنی ScyllaDB مجهز به استاندارد ACID محاسبه می‌گردند.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge -->
          <div class="mt-3 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974]"></span>
              <span class="text-[#e2c974] font-bold uppercase tracking-wider">حالت خرابی و راهکار تاب‌آوری</span>
            </div>
            <p class="text-[#94a3b8] leading-relaxed">
              قطعی ارتباط درگاه با سوییچ بالادست و هجوم درخواست‌های بازپردازش (Retry Storm). مهار شارژ مضاعف با تفکیک لایه پذیرش از لایه تسویه و ثبت خودکار سند معکوس و اصلاحیه (۰۴۲۰) به صورت ردیف جدید در دفتر کل دوبل بدون دستکاری داده‌های پیشین.
            </p>
          </div>

          <!-- Product Decision: Refined Badge (FA) -->
          <div class="mt-3 p-4 bg-[#0b1120]/70 border border-white/10 border-dashed rounded-xl text-xs space-y-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
                <span class="text-[#38bdf8] font-bold uppercase tracking-wider">تصمیم محصول</span>
              </div>
              <span class="text-[10px] text-[#94a3b8] tracking-wider px-2 py-0.5 rounded bg-white/[0.04] border border-white/5">پیش‌نویس — در انتظار محتوای واقعی</span>
            </div>
            <div class="text-[#94a3b8] space-y-1.5 leading-relaxed">
              <p><strong class="text-[#f8fafc]">چرا این تصمیم و چرا در آن مقطع:</strong> [TODO: what forced this — an incident, a growth threshold, a specific complaint or failure]</p>
              <p><strong class="text-[#f8fafc]">موازنه‌ها و بده‌بستان‌ها (Trade-off):</strong> [TODO: the option you picked and the one you rejected, one sentence each]</p>
              <p><strong class="text-[#f8fafc]">مخالفت ذی‌نفعان و نحوه حل اختلاف:</strong> [TODO: a real disagreement between stakeholders/teams, and how you resolved it]</p>
              <p><strong class="text-[#f8fafc]">دست‌آورد و خروجی کسب‌وکاری:</strong> [TODO: an outcome in business terms — not ms/TPS/%, but cost, revenue, retention, risk avoided, or a regulator/exec satisfied]</p>
            </div>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-5">
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">SLA زیر ۵۰ میلی‌ثانیه</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">قفل اتمی Redis O(1)</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">بیت‌مپ ISO 8583</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">دفترکل دوبل ScyllaDB</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#0b1120]/80 border border-white/10 rounded-xl p-3 sm:p-5 my-4 overflow-hidden" dir="ltr">
            <img 
              src={`${baseUrl}diagrams/payment-switch-architecture.svg?v=fintech-2026`} 
              alt="نقشه شماتیک سوییچ و تسویه حساب مالی"
              class="w-full h-auto object-contain rounded-lg"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex flex-wrap justify-between items-center gap-2 text-xs">
            <span class="text-[#94a3b8]">مشخصات فنی و تحلیل پروتکل در سند ۰۱ تدوین شده است.</span>
            <a href={`${baseUrl}fa/blog/payment-gateway/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold transition-all duration-300 hover:border-[#06b6d4] hover:bg-[#06b6d4]/10 hover:-translate-x-0.5 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-[#06b6d4]">
              مشاهده سند فنی ۰۱ &larr;
            </a>
          </div>
        </section>

        <!-- SECTION 02: Fraud Forensics -->
        <section id="fraud-forensics" class="bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase">۰۲ · مهار بلادرنگ تقلب و گراف ارتباطات</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">کشف تقلب در لحظه و ردیابی گراف قضایی</h2>
          
          <!-- Invariant Box: Refined Badge -->
          <div class="mt-4 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">اصل تخطی‌ناپذیر معماری (Invariant)</span>
            </div>
            <p class="text-[#f8fafc] leading-relaxed">زمان پاسخ حلقه ارزیابی ریسک کمتر از ۱۵ میلی‌ثانیه؛ کلیه زنجیره‌های ردگیری تراکنش باید در مراجع نظارتی و بانکی قابل استناد و بازتولید باشد.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              لبه ورودی با استخراج انتروپی بوم (Canvas)، شتاب دستگاه و ریتم کلیدزنی، بردارهای چندبعدی ریسک [۰٫۰۰ تا ۱٫۰۰] را در کمتر از ۱۵ میلی‌ثانیه تولید می‌کند. تراکنش‌های زیر ۰٫۳۰ بدون اصطکاک عبور می‌کنند؛ ۰٫۳۰ تا ۰٫۷۵ اعتبارسنجی بیومتریک و پیامکی 3DS 2.0 را فعال می‌سازد (انتقال مسئولیت مالی به بانک صادرکننده)؛ امتیازهای بالای ۰٫۷۵ در کلاستر گراف Neo4j قرنطینه و تحلیل می‌شوند.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge -->
          <div class="mt-3 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974]"></span>
              <span class="text-[#e2c974] font-bold uppercase tracking-wider">حالت خرابی و راهکار تاب‌آوری</span>
            </div>
            <p class="text-[#94a3b8] leading-relaxed">
              حملات تصاحب توزیع‌شده حساب و سوءاستفاده هماهنگ از کدهای تخفیف. عبور از قواعد ایستا با ردیابی بازگشتی جریان وجوه در کلاستر گراف میان بیش از ۴۰ میکروسرویس مسدود می‌شود.
            </p>
          </div>

          <!-- Product Decision: Refined Badge (FA) -->
          <div class="mt-3 p-4 bg-[#0b1120]/70 border border-white/10 border-dashed rounded-xl text-xs space-y-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
                <span class="text-[#38bdf8] font-bold uppercase tracking-wider">تصمیم محصول</span>
              </div>
              <span class="text-[10px] text-[#94a3b8] tracking-wider px-2 py-0.5 rounded bg-white/[0.04] border border-white/5">پیش‌نویس — در انتظار محتوای واقعی</span>
            </div>
            <div class="text-[#94a3b8] space-y-1.5 leading-relaxed">
              <p><strong class="text-[#f8fafc]">چرا این تصمیم و چرا در آن مقطع:</strong> [TODO: what forced this — an incident, a growth threshold, a specific complaint or failure]</p>
              <p><strong class="text-[#f8fafc]">موازنه‌ها و بده‌بستان‌ها (Trade-off):</strong> [TODO: the option you picked and the one you rejected, one sentence each]</p>
              <p><strong class="text-[#f8fafc]">مخالفت ذی‌نفعان و نحوه حل اختلاف:</strong> [TODO: a real disagreement between stakeholders/teams, and how you resolved it]</p>
              <p><strong class="text-[#f8fafc]">دست‌آورد و خروجی کسب‌وکاری:</strong> [TODO: an outcome in business terms — not ms/TPS/%, but cost, revenue, retention, risk avoided, or a regulator/exec satisfied]</p>
            </div>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-5">
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">حلقه ریسک زیر ۱۵ms</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">انتقال مسئولیت با 3DS 2.0</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">مثبت کاذب زیر ۰٫۵٪</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">گراف قضایی Neo4j</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#0b1120]/80 border border-white/10 rounded-xl p-3 sm:p-5 my-4 overflow-hidden" dir="ltr">
            <img 
              src={`${baseUrl}diagrams/fraud-tracing-architecture.svg?v=fintech-2026`} 
              alt="نقشه شماتیک سامانه کشف تقلب و ردیابی گراف"
              class="w-full h-auto object-contain rounded-lg"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex flex-wrap justify-between items-center gap-2 text-xs">
            <span class="text-[#94a3b8]">منطق دقیق کاهش ریسک و پرونده‌های قضایی در سند ۰۲ تدوین شده است.</span>
            <a href={`${baseUrl}fa/blog/fraud-tracing/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold transition-all duration-300 hover:border-[#06b6d4] hover:bg-[#06b6d4]/10 hover:-translate-x-0.5 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-[#06b6d4]">
              مشاهده سند فنی ۰۲ &larr;
            </a>
          </div>
        </section>

        <!-- SECTION 03: Telecom SMS Gateway -->
        <section id="sms-gateway" class="bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase">۰۳ · زیرساخت مقیاس‌پذیر پیام‌رسانی (SMPP)</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">زیرساخت مسیریابی و تجمیع پیامک ملی در مقیاس مگفا و فرستار</h2>
          
          <!-- Invariant Box: Refined Badge -->
          <div class="mt-4 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">اصل تخطی‌ناپذیر معماری (Invariant)</span>
            </div>
            <p class="text-[#f8fafc] leading-relaxed">تحویل بلادرنگ رمزهای یکبارمصرف بانکی (OTP) با تاخیر زیر ۵ ثانیه حتی در اوج ترافیک کمپین‌های تبلیغاتی میلیونی؛ بیش از ۱ میلیارد پیامک سالانه.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              مدیریت نشست‌های موازی SMPP 3.4 با اتصال به گیت‌وی اپراتورها (همراه اول، ایرانسل و رایتل) روی سرشماره‌های ۱۰۰۰، ۲۰۰۰، ۳۰۰۰ و ۹۰۰۰. مجهز به کنترل پویای پنجره لغزان (Sliding Window از ۱۶ تا ۶۴ PDU)، تعادل بار هوشمند بر اساس ظرفیت پاسخ‌دهی SMSC، و استعلام پیش‌دستانه HLR و شاهکار جهت غربالگری خطوط مسدود (*800#) پیش از اشغال پهنای باند و کسر هزینه.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge -->
          <div class="mt-3 p-4 bg-[#0b1120]/70 border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974]"></span>
              <span class="text-[#e2c974] font-bold uppercase tracking-wider">حالت خرابی و راهکار تاب‌آوری</span>
            </div>
            <p class="text-[#94a3b8] leading-relaxed">
              اشباع لوله‌های اپراتور زیر بار محدودیت ۷۰ نویسه‌ای یونیکد UCS-2 فارسی و تاخیر در دریافت DLR. برطرف‌شده با جداسازی دقیق صف‌های اولویت‌دار خدماتی/بانکی از کمپین‌های انبوه بازاریابی و تنظیم خودکار نرخ ارسال (Adaptive Backpressure).
            </p>
          </div>

          <!-- Product Decision: Refined Badge (FA) -->
