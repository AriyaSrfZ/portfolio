---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import BookingSection from '../../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="آریا صراف‌زاده | معماری سیستم‌های پرترافیک و راهبری محصول فنی" 
  description="معمار ارشد سامانه‌های توزیع‌شده و مدیر ارشد محصول فنی. طراحی سوییچ‌های پرداخت بانکی، هاب‌های ملی پیام‌رسانی و دفاتر کل فقط‌افزودنی."
  lang="fa"
  dir="rtl"
>
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-transparent via-white/50 to-transparent z-50 transition-all duration-100"></div>

  <Hero locale="fa" />

  <main class="max-w-5xl mx-auto px-6 py-12 space-y-12 font-['Vazirmatn',sans-serif]" id="blueprints" dir="rtl">

    <!-- DOSSIER 01: Double-Entry Ledger & Two-Phase Balance Engine -->
    <section id="payment-settlement" class="bg-[#0f1217]/90 border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl ring-1 ring-white/5 space-y-6">
      <!-- Header -->
      <div class="space-y-2">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2 font-mono text-xs text-neutral-400 uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>۰۱ · تسویه مالی و دفاتر کل توزیع‌شده</span>
          </div>
          <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded" dir="ltr">
            DOSSIER 01 · ACID
          </span>
        </div>
        <h2 class="text-xl md:text-2xl font-bold text-white tracking-tight">
          دفتر کل دوطرفه (<span dir="ltr">Double-Entry</span>) و موتور تخصیص دومرحله‌ای موجودی
        </h2>
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">ظرفیت اوج پردازش</span>
          <span class="text-white font-semibold" dir="ltr">50,000 TPS</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">طول عمر قفل ردیس</span>
          <span class="text-cyan-400 font-semibold" dir="ltr">15,000ms SETNX</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">پنجره بازپخش مجدد</span>
          <span class="text-white font-semibold">۲۴ ساعت (۸۶,۴۰۰s)</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">انحراف مالی در تراز</span>
          <span class="text-emerald-400 font-semibold">۰٫۰۰٪ (صفر مطلق)</span>
        </div>
      </div>

      <!-- Architecture Blueprint (Full-Width Interactive SVG Container) -->
      <div class="bg-[#13161c] border border-white/10 rounded-xl p-4 md:p-6 shadow-inner" dir="ltr">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-3 pb-2 border-b border-white/5">
          <span class="tracking-wider uppercase">ARCHITECTURE BLUEPRINT · TOPOLOGY SCHEMATIC</span>
          <span class="text-emerald-400">2PC VERIFIED</span>
        </div>
        <img 
          src={`${baseUrl}diagrams/double-entry-ledger-schematic.svg?v=fintech-2026`} 
          alt="Double-Entry Ledger and Two-Phase Reservation Topology Schematic"
          class="w-full h-auto object-contain rounded filter contrast-105"
          loading="lazy"
        />
      </div>

      <!-- 2-Column Technical Spec (Balanced 50/50 Grid in RTL) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <!-- Right: Invariants & Mechanism -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>اصول تخطی‌ناپذیر معماری و منطق تسویه</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>منبع یگانه حقیقت مالی (SSOT):</strong> تضمین ریاضی پایدار <span dir="ltr">&Sigma; Debits &minus; &Sigma; Credits = 0</span> روی جداول وقایع تغییرناپذیر در <span dir="ltr">ScyllaDB</span> و <span dir="ltr">PostgreSQL</span>.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>ماشین حالت رزرو دومرحله‌ای:</strong> انتقال سرمایه از وضعیت <code class="text-amber-400 font-mono text-xs bg-white/5 px-1 py-0.5 rounded" dir="ltr">AVAILABLE</code> به <code class="text-cyan-400 font-mono text-xs bg-white/5 px-1 py-0.5 rounded" dir="ltr">RESERVED</code> پیش از فراخوانی وب‌هوک‌های بانکی بالادست.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>ایدامپوتنسي توزیع‌شده:</strong> قفل‌های موقت اتمیک <span dir="ltr">Redis SETNX</span> مبتنی بر <span dir="ltr">UUIDv4</span> با پنجره بازپخش ۲۴ ساعته جهت پیشگیری از کسر تکراری.</span>
            </li>
          </ul>
        </div>

        <!-- Left: Failure Modes & Recovery -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>حالات خرابی و بازیابی خودکار</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>تایم‌اوت‌های شبکه بانکی:</strong> مهارشده با الگوی <span dir="ltr">Transactional Outbox</span> و بازیابی وضعیت توزیع‌شده مبتنی بر <span dir="ltr">Raft</span> برای رد حالت‌های گذرا.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>رول‌بک خودکار تراز:</strong> آزادسازی آنی موجودی بلوکه‌شده به وضعیت قابل‌مصرف در صورت انقضای زمان تراکنش یا رسیدن پاسخ عدم تایید از شاپرک.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>دستاورد پروداکشن:</strong> تراز کامل ۱۰۰ درصدی در بیش از ۵۰ هزار تراکنش روزانه بدون حتی یک مورد واریز تکراری یا مغایرت پولی.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Footer Bar -->
      <div class="flex flex-wrap items-center justify-between pt-4 border-t border-white/5 gap-3 font-mono text-xs">
        <div class="flex flex-wrap gap-1.5" dir="ltr">
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[ACID]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[2PC RESERVATION]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[REDIS SETNX]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[SCYLLADB]</span>
        </div>
        <a href={`${baseUrl}fa/blog/payment-gateway/`} class="text-white hover:text-cyan-400 font-semibold inline-flex items-center gap-1 group transition-colors">
          <span>مطالعه کامل وایت‌پیپر و مستندات فنی</span>
          <span class="group-hover:-translate-x-1 transition-transform">&larr;</span>
        </a>
      </div>
    </section>


    <!-- DOSSIER 02: Smart PSP Switch & Dynamic Weighted Routing -->
    <section id="payment-switch" class="bg-[#0f1217]/90 border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl ring-1 ring-white/5 space-y-6">
      <span id="sms-gateway" class="sr-only"></span>
      <!-- Header -->
      <div class="space-y-2">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2 font-mono text-xs text-neutral-400 uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>۰۲ · سوییچ پرداخت و پروتکل‌های مخابراتی</span>
          </div>
          <span class="text-xs font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-2.5 py-0.5 rounded" dir="ltr">
            DOSSIER 02 · ISO 8583
          </span>
        </div>
        <h2 class="text-xl md:text-2xl font-bold text-white tracking-tight">
          سوییچ هوشمند پرداخت و موتور روتینگ پویای چنددرگاهی (<span dir="ltr">ISO 8583</span>)
        </h2>
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">سرعت تغییر مسیر</span>
          <span class="text-cyan-400 font-semibold" dir="ltr">&lt;30ms Failover</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">پروتکل سوییچ</span>
          <span class="text-white font-semibold" dir="ltr">ISO 8583 MTI 0200</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">دسترسی‌پذیری سوییچ</span>
          <span class="text-emerald-400 font-semibold" dir="ltr">99.99% Uptime</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">رشد نرخ تبدیل</span>
          <span class="text-emerald-400 font-semibold" dir="ltr">+14% Conversion</span>
        </div>
      </div>

      <!-- Architecture Blueprint (Full-Width Interactive SVG Container) -->
      <div class="bg-[#13161c] border border-white/10 rounded-xl p-4 md:p-6 shadow-inner" dir="ltr">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-3 pb-2 border-b border-white/5">
          <span class="tracking-wider uppercase">MULTI-PSP HEAD-TO-HEAD (H2H) ROUTING PIPELINE</span>
          <span class="text-cyan-400">DYNAMIC WEIGHTED SLAS</span>
        </div>
        <img 
          src={`${baseUrl}diagrams/payment-switch-iso8583-pipeline.svg?v=fintech-2026`} 
          alt="Smart PSP Switch and ISO 8583 Pipeline Topology Schematic"
          class="w-full h-auto object-contain rounded filter contrast-105"
          loading="lazy"
        />
      </div>

      <!-- 2-Column Technical Spec (Balanced 50/50 Grid in RTL) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <!-- Right: Invariants & Mechanism -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>معماری روتینگ و اتصال چنددرگاهی</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>سوییچ Head-to-Head (H2H):</strong> پردازش مستقیم تلگرام‌های مالی <span dir="ltr">ISO 8583</span> با استخراج بلادرنگ کدهای <span dir="ltr">STAN</span> و <span dir="ltr">RRN</span> و هدرهای احراز هویت.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>هدایت هوشمند چنددرگاهی:</strong> توزیع ترافیک میان شرکت‌های پرداخت ملی (سامان، پارسیان، به‌پرداخت، پاسارگاد) از طریق آداپتورهای هاب فناوران.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>اوزان پویا بر پایه سلامت:</strong> ارزیابی لحظه‌ای تاخیر <span dir="ltr">P99</span>، نرخ موفقیت، و کارمزدهای تجاری پذیرندگان پیش از ارسال درخواست پرداخت.</span>
            </li>
          </ul>
        </div>

        <!-- Left: Failure Modes & Recovery -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>فیوزهای قطع مدار و مهار افت کیفیت</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>سقوط سوکت درگاه:</strong> با افزایش خطاهای ارتباطی، فیوز مدار در کمتر از ۳۰ میلی‌ثانیه درگاه ناسالم را از چرخه پردازش خارج می‌کند.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>عدم ریزش سبد خرید:</strong> درخواست‌های جاری بدون نیاز به ورود مجدد کاربر بلافاصله به درگاه‌های پشتیبان هدایت می‌شوند.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-mono mt-0.5">•</span>
              <span><strong>کنترل جریان مخابراتی SMPP:</strong> کنترل نرخ ارسال با پنجره لغزان (۱۶ تا ۶۴ PDU) جهت تضمین رسیدن پیامک رمز پویا در کمتر از ۲ ثانیه.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Footer Bar -->
      <div class="flex flex-wrap items-center justify-between pt-4 border-t border-white/5 gap-3 font-mono text-xs">
        <div class="flex flex-wrap gap-1.5" dir="ltr">
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[ISO 8583]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[FARAVARAN HUB]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[MULTI-PSP ROUTING]</span>
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-neutral-300">[CIRCUIT BREAKER]</span>
        </div>
        <a href={`${baseUrl}fa/blog/sms-infrastructure/`} class="text-white hover:text-cyan-400 font-semibold inline-flex items-center gap-1 group transition-colors">
          <span>مطالعه کامل وایت‌پیپر سوییچ و مخابرات</span>
          <span class="group-hover:-translate-x-1 transition-transform">&larr;</span>
        </a>
      </div>
    </section>


    <!-- DOSSIER 03: eKYC, Central Bank Harim OTP & PCI-DSS Token Vault -->
    <section id="fraud-forensics" class="bg-[#0f1217]/90 border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl ring-1 ring-white/5 space-y-6">
      <!-- Header -->
      <div class="space-y-2">
        <div class="flex items-center justify-between border-b border-white/5 pb-3">
          <div class="flex items-center gap-2 font-mono text-xs text-neutral-400 uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>۰۳ · مدیریت ریسک، احراز هویت و مهار تقلب</span>
          </div>
          <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded" dir="ltr">
            DOSSIER 03 · PCI-DSS
          </span>
        </div>
        <h2 class="text-xl md:text-2xl font-bold text-white tracking-tight">
          احراز هویت شاهکار، رمز پویای حریم و زون توکنایزیشن <span dir="ltr">PCI-DSS</span>
        </h2>
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">مهلت ارزیابی ریسک</span>
          <span class="text-emerald-400 font-semibold" dir="ltr">&lt;15ms (P99)</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">ذخیره داده CVV2</span>
          <span class="text-white font-semibold">۰٫۰۰ ثانیه (عدم ذخیره)</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">مهار تخلیه مالی</span>
          <span class="text-emerald-400 font-semibold">۹۴- درصد کاهش تقلب</span>
        </div>
        <div class="bg-[#13161c] border border-white/5 rounded-lg p-2.5">
          <span class="text-neutral-500 block text-[10px] uppercase">نرخ عبور 3DS 2.0</span>
          <span class="text-cyan-400 font-semibold">بیش از ۹۲٪ بدون چالش</span>
        </div>
      </div>

      <!-- Architecture Blueprint (Full-Width Interactive SVG Container) -->
      <div class="bg-[#13161c] border border-white/10 rounded-xl p-4 md:p-6 shadow-inner" dir="ltr">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-3 pb-2 border-b border-white/5">
          <span class="tracking-wider uppercase">PERIMETER ISOLATION &amp; EKYC VERIFICATION SCHEMATIC</span>
          <span class="text-emerald-400">PCI-DSS COMPLIANT</span>
        </div>
        <img 
          src={`${baseUrl}diagrams/fraud-tracing-architecture.svg?v=fintech-2026`} 
          alt="eKYC, Harim Dynamic OTP and Forensic Graph Tracing Schematic"
          class="w-full h-auto object-contain rounded filter contrast-105"
          loading="lazy"
        />
      </div>

      <!-- 2-Column Technical Spec (Balanced 50/50 Grid in RTL) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <!-- Right: Invariants & Mechanism -->
        <div class="bg-[#13161c]/70 border border-white/5 rounded-xl p-4 md:p-5 space-y-3 text-sm">
          <div class="flex items-center gap-2 font-mono text-xs font-semibold uppercase text-neutral-200">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>اصول امنیتی زون بانکی و شاهکار</span>
          </div>
          <ul class="space-y-2 text-neutral-300 text-xs sm:text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>توکن‌سازی با ذخیره صفر:</strong> شماره کارت خام وارد زون ایزوله <span dir="ltr">PCI-DSS</span> شده و کدهای <span dir="ltr">CVV2</span> بلافاصله پس از تراکنش پاکسازی می‌شوند.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
              <span><strong>یکپارچگی شاهکار و ثبت‌احوال:</strong> تطبیق برخط کدملی با مالک سیم‌کارت و مقایسه زمان صدور سیم‌کارت با درخواست رمز پویای حریم بانک مرکزی.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 font-mono mt-0.5">•</span>
