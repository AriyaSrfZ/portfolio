---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import BookingSection from '../../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="آریا صراف‌زاده | معماری سیستم‌های پرترافیک و راهبری محصول فنی" 
  description="معمار ارشد سامانه‌های توزیع‌شده و مدیر ارشد محصول فنی. طراحی سوییچ‌های پرداخت بانکی، هاب‌های ملی پیام‌رسانی در مقیاس مگفا و فرستار، و خطوط پردازش کلان‌داده سازمانی."
  lang="fa"
  dir="rtl"
>
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-[#06b6d4] via-[#e2c974] to-[#38bdf8] z-50 transition-all duration-100"></div>

  <Hero locale="fa" />

  <main class="max-w-[1600px] mx-auto px-6 py-12 font-['Vazirmatn',sans-serif]" id="blueprints" dir="rtl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Index -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 space-y-4">
        <div class="bg-[#111827]/70 backdrop-blur-xl border border-white/10 rounded-2xl p-5 shadow-2xl ring-1 ring-white/5">
          <div class="text-xs font-bold text-[#e2c974] tracking-wider uppercase mb-3 border-b border-white/10 pb-2.5 flex justify-between items-center">
            <span>فهرست نقشه‌ها و سامانه‌ها</span>
            <span class="w-2 h-2 rounded-full bg-[#38bdf8] shadow-[0_0_8px_rgba(201,212,168,0.6)] animate-signal"></span>
          </div>
          
          <nav class="space-y-1 text-xs">
            <a href="#payment-settlement" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۱ · دفتر کل دوطرفه و تسویه
            </a>
            <a href="#fraud-forensics" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۲ · احراز هویت شاهکار و زون بانکی
            </a>
            <a href="#payment-switch" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۳ · سوییچ هوشمند پرداخت (PSP Switch)
            </a>
            <a href="#reconciliation-engine" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۴ · مغایرت‌گیری و تسویه زودهنگام
            </a>
            <a href="#incident-dossiers" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۵ · پرونده‌های بحران‌های زنده در پروداکشن
            </a>
            <a href="#lifecycle" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۶ · چرخه حیات محصول فنی
            </a>
            <a href={`${baseUrl}fa/whitepapers/`} class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۷ · مستندات معماری و وایت‌پیپرها
            </a>
            <a href="#book" class="block px-3 py-2 rounded-lg text-[#94a3b8] hover:bg-white/[0.06] hover:text-[#f8fafc] transition-all duration-200">
              ۰۸ · جلسه بررسی معماری
            </a>
          </nav>
        </div>
      </aside>

      <!-- Main Blueprint Sections -->
      <div class="lg:col-span-9 space-y-10">
        
        <!-- SECTION 01: Double-Entry Ledger & Settlements -->
        <section id="payment-settlement" class="bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase">۰۱ · تسویه مالی و دفاتر کل</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">دفتر کل دوطرفه (Double-Entry) و موتور تخصیص دومرحله‌ای موجودی</h2>
          
          <!-- Invariant Box: Refined Badge -->
          <div class="mt-4 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">اصل تخطی‌ناپذیر معماری (Invariant)</span>
            </div>
            <p class="text-[#f8fafc] leading-relaxed">منبع یگانه حقیقت مالی (Single Source of Truth). حذف قطعی تسویه مضاعف در پنجره بازپخش ۲۴ ساعته با ماشین حالت تخصیص دومرحله‌ای موجودی (<span dir="ltr">AVAILABLE &rarr; RESERVED</span>) و پایداری قطعی تراز ریاضی بدهکار و بستانکار (<span dir="ltr">&Sigma; Debits &minus; &Sigma; Credits = 0</span>).</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              جهش‌های مالی و شارژ کیف پول با کلید یکتای ایدامپوتنسي (<span dir="ltr">UUIDv4</span>) و قفل توزیع‌شده <span dir="ltr">Redis SETNX</span> با طول عمر ۲۴ ساعته کنترل می‌شوند. تخصیص موجودی از طریق ماشین حالت دومرحله‌ای، وجوه را پیش از ارسال به درگاه از وضعیت موجود (<span dir="ltr">AVAILABLE</span>) به رزروشده (<span dir="ltr">RESERVED</span>) منتقل می‌کند. پس از تایید نهایی، رکوردهای تسویه به‌صورت تغییرناپذیر (<span dir="ltr">Append-Only</span>) در دفتر کل دوطرفه <span dir="ltr">ScyllaDB</span> و <span dir="ltr">PostgreSQL</span> با تضمین <span dir="ltr">ACID</span> ثبت شده و از هرگونه شناوری مالی ثبت‌نشده جلوگیری می‌شود.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974]"></span>
              <span class="text-[#e2c974] font-bold uppercase tracking-wider">حالت خرابی و راهکار تاب‌آوری</span>
            </div>
            <p class="text-[#94a3b8] leading-relaxed">
              تایم‌اوت‌های جزئی شبکه یا قطعی کارگزار پیام هنگام به‌روزرسانی چندبخشی دفاتر کل بانکی. مهارشده با الگوی اوت‌باکس تراکنشی (<span dir="ltr">Transactional Outbox</span>) و بازیابی حالت توزیع‌شده مبتنی بر <span dir="ltr">Raft</span> جهت رد وضعیت‌های تاییدنشده گذرا.
            </p>
          </div>

          <!-- Product Decision: Refined Badge (FA) -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
              <span class="text-[#38bdf8] font-bold uppercase tracking-wider">تصمیم محصول · دوره دیجی‌پی (DigiPay Core Ledger)</span>
            </div>
            <div class="text-[#cbd5e1] space-y-1.5 leading-relaxed">
              <p><strong class="text-[#f8fafc]">چرا این تصمیم و چرا در آن مقطع:</strong> ناهمخوانی دفاتر کل و مانده‌های شبح هنگام تراکنش‌های همزمان بالا، جایگاه شرکت نزد مراجع نظارتی و بانک مرکزی را به خطر می‌انداخت.</p>
              <p><strong class="text-[#f8fafc]">موازنه‌ها و بده‌بستان‌ها (Trade-off):</strong> اولویت‌دادن به تخصیص دومرحله‌ای همگام موجودی و تراز قطعی دفاتر کل بر سرعت خام پردازش تراکنش‌ها.</p>
              <p><strong class="text-[#f8fafc]">مخالفت ذی‌نفعان و نحوه حل اختلاف:</strong> تیم رشد و بازاریابی خواستار تراکنش‌های بدون رزرو زیر ۱۰ میلی‌ثانیه بود؛ من اثبات کردم جلوگیری از اضافه برداشت بدون پشتوانه برای حسابرسی بانک مرکزی اجتناب‌ناپذیر است.</p>
              <p><strong class="text-[#f8fafc]">دست‌آورد و خروجی کسب‌وکاری:</strong> حفظ ۱۰۰ درصدی تراز ریاضی دفاتر کل در بیش از ۵۰ هزار تراکنش روزانه بدون حتی یک مورد واریز تکراری یا نشت مالی.</p>
            </div>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-5">
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">دفتر کل دوطرفه</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">تخصیص دومرحله‌ای موجودی</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">انطباق ACID</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">ایدامپوتنسي Redis SETNX</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">مخزن داده ScyllaDB</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl p-3 sm:p-5 my-4 overflow-hidden" dir="ltr">
            <img 
              src={`${baseUrl}diagrams/double-entry-ledger-schematic.svg?v=fintech-2026`} 
              alt="نقشه شماتیک دفتر کل دوطرفه و تخصیص دومرحله‌ای موجودی"
              class="w-full h-auto object-contain rounded-lg"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex flex-wrap justify-between items-center gap-2 text-xs">
            <span class="text-[#94a3b8]">مشخصات فنی و تحلیل پروتکل در سند ۰۱ تدوین شده است.</span>
            <a href={`${baseUrl}fa/blog/payment-gateway/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold transition-all duration-300 active:scale-[0.98] hover:-translate-y-1 hover:shadow-2xl hover:border-[#06b6d4]/40 hover:bg-[#06b6d4]/10 focus-visible:outline-2 focus-visible:outline-[#06b6d4]">
              مشاهده سند فنی ۰۱ &larr;
            </a>
          </div>
        </section>

        
        <div class="flex items-center justify-center gap-4 my-2">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
          <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]/40"></span>
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
        </div>


        <!-- SECTION 02: Fraud Forensics & eKYC -->
        <section id="fraud-forensics" class="bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase">۰۲ · مهار تهدیدات و احراز هویت</span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#f8fafc] tracking-tight">احراز هویت شاهکار، رمز پویای هریم و زون ایزوله بانکی (PCI-DSS)</h2>
          
          <!-- Invariant Box: Refined Badge -->
          <div class="mt-4 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]"></span>
              <span class="text-[#06b6d4] font-bold uppercase tracking-wider">اصل تخطی‌ناپذیر معماری (Invariant)</span>
            </div>
            <p class="text-[#f8fafc] leading-relaxed">عدم ذخیره‌سازی داده‌های حساس <span dir="ltr">CVV2</span> پس از احراز تراکنش (انطباق کامل با استاندارد <span dir="ltr">PCI-DSS</span> شاپرک)؛ اعتبارسنجی رمز پویای ۴ پارامتری سامانه هریم بانک مرکزی متصل به کد ملی و شماره کارت.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#94a3b8] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              اطلاعات کارت مستقیماً در زون ایزوله بانکی (<span dir="ltr">PCI-DSS DMZ</span>) وارد شده و در والت توکن‌سازی (<span dir="ltr">Token Vault</span>) به توکن‌های امن غیرقابل‌ردگیری تبدیل می‌شود؛ کدهای <span dir="ltr">CVV2</span> بلافاصله پس از تراکنش پاکسازی می‌گردند. اتصال برخط با سامانه شاهکار (تطبیق کدملی با شماره موبایل) و ثبت‌احوال با زیرساخت رمز پویای ۴ پارامتری هریم بانک مرکزی یکپارچه شده است. موتور ارزیابی ریسک با پردازش بلادرنگ داده‌های رفتاری، بردار ریسک [۰٫۰۰ تا ۱٫۰۰] را در کمتر از ۱۵ میلی‌ثانیه در کلاستر گرافی <span dir="ltr">Neo4j</span> تحلیل کرده و با پروتکل <span dir="ltr">3DS 2.0</span> مسئولیت مالی را به بانک صادرکننده منتقل می‌کند.
            </p>
          </div>

          <!-- Failure Mode: Refined Badge -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e2c974]"></span>
              <span class="text-[#e2c974] font-bold uppercase tracking-wider">حالت خرابی و راهکار تاب‌آوری</span>
            </div>
            <p class="text-[#94a3b8] leading-relaxed">
              حملات توزیع‌شده تصاحب حساب، تعویض غیرمجاز سیم‌کارت (<span dir="ltr">SIM Swap</span>) و شبکه‌های فیشینگ رمز پویا. مهارشده با تطبیق رمزی زمان صدور سیم‌کارت در شاهکار با درخواست صدور رمز پویای هریم.
            </p>
          </div>

          <!-- Product Decision: Refined Badge (FA) -->
          <div class="mt-3 p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
              <span class="text-[#38bdf8] font-bold uppercase tracking-wider">تصمیم محصول · انطباق زون بانکی (PCI-DSS)</span>
            </div>
            <div class="text-[#cbd5e1] space-y-1.5 leading-relaxed">
              <p><strong class="text-[#f8fafc]">چرا این تصمیم و چرا در آن مقطع:</strong> قواعد ایستا خطای مثبت کاذب بالایی داشتند و کلاهبرداران با سوءاستفاده از تاخیر تعویض سیم‌کارت، رمزهای سنتی را دور می‌زدند.</p>
              <p><strong class="text-[#f8fafc]">موازنه‌ها و بده‌بستان‌ها (Trade-off):</strong> امتناع از کش‌کردن کدهای <span dir="ltr">CVV2</span> به بهانه راحتی خرید، و اعمال توکن‌سازی سخت‌گیرانه در زون ایزوله بانکی.</p>
              <p><strong class="text-[#f8fafc]">مخالفت ذی‌نفعان و نحوه حل اختلاف:</strong> تیم تجاری خواستار ذخیره‌سازی <span dir="ltr">CVV2</span> برای خرید تک‌کلیکی بود؛ من اثبات کردم ریسک جرایم نظارتی و نقض امنیتی کارت‌ها بسیار فراتر از اصطکاک پرداخت است.</p>
              <p><strong class="text-[#f8fafc]">دست‌آورد و خروجی کسب‌وکاری:</strong> کاهش ۹۴ درصدی نشت مالی و انتقال موفق مسئولیت حقوقی به بانک‌های صادرکننده با پروتکل <span dir="ltr">3DS 2.0</span>.</p>
            </div>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-5">
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">زون ایزوله بانکی (PCI-DSS)</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">رمز پویای ۴ پارامتری هریم</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">احراز هویت شاهکار</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">توکن‌سازی امن کارت</span>
            <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-medium hover:bg-white/[0.07] transition-colors">تحلیل گرافی Neo4j</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl p-3 sm:p-5 my-4 overflow-hidden" dir="ltr">
            <img 
              src={`${baseUrl}diagrams/fraud-tracing-architecture.svg?v=fintech-2026`} 
              alt="نقشه شماتیک احراز هویت شاهکار، رمز پویای هریم و زون بانکی"
              class="w-full h-auto object-contain rounded-lg"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex flex-wrap justify-between items-center gap-2 text-xs">
            <span class="text-[#94a3b8]">منطق دقیق کاهش ریسک و پرونده‌های قضایی در سند ۰۲ تدوین شده است.</span>
            <a href={`${baseUrl}fa/blog/fraud-tracing/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold transition-all duration-300 active:scale-[0.98] hover:-translate-y-1 hover:shadow-2xl hover:border-[#06b6d4]/40 hover:bg-[#06b6d4]/10 focus-visible:outline-2 focus-visible:outline-[#06b6d4]">
              مشاهده سند فنی ۰۲ &larr;
            </a>
          </div>
        </section>

        
        <div class="flex items-center justify-center gap-4 my-2">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
          <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4]/40"></span>
          <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
        </div>


        <!-- SECTION 03: Smart PSP Switch & Dynamic Weighted Routing -->
        <section id="payment-switch" class="bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
