---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import BookingSection from '../../components/BookingSection.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="آریا صراف‌زاده | معماری سامانه‌های سازمانی و سوییچ‌های پرحجم" 
  description="معمار سامانه‌های زیرساخت و ارتباطات و مدیر ارشد محصول فنی. سوییچ‌های پرداخت، هاب‌های مسیریابی پیامک ملی، و جداسازی تقلب در مقیاس عملیاتی."
  lang="fa"
  dir="rtl"
>
  <div id="progress-bar" class="fixed top-0 left-0 h-[2px] bg-[#c4562e] z-50 transition-all duration-75"></div>

  <Hero locale="fa" />

  <main class="max-w-[1600px] mx-auto px-6 py-10 font-['IBM_Plex_Mono',monospace]" id="blueprints" dir="rtl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Index (Strict 01 to 07 sequence) -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-20 space-y-4">
        <div class="relative bg-[#1c1916] border border-[#5c6650] p-4 shadow-xl rugged-hatch rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="text-[11px] font-bold text-[#c9a15a] tracking-widest uppercase mb-3 border-b border-[#5c6650] pb-2 flex justify-between items-center">
            <span>فهرست سامانه‌ها</span>
            <span class="w-1.5 h-1.5 bg-[#c9d4a8] animate-signal"></span>
          </div>
          
          <nav class="space-y-1.5 text-xs">
            <a href="#payment-settlement" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-r border-transparent hover:border-[#c4562e]">
              ۰۱ // تسویه و دفاتر کل
            </a>
            <a href="#fraud-forensics" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-r border-transparent hover:border-[#c4562e]">
              ۰۲ // تقلب و گراف قضایی
            </a>
            <a href="#sms-gateway" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-r border-transparent hover:border-[#c4562e]">
              ۰۳ // هاب پیامک ملی
            </a>
            <a href="#data-pipeline" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-r border-transparent hover:border-[#c4562e]">
              ۰۴ // پایگاه داده Smart DB
            </a>
            <a href="#incident-dossiers" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-r border-transparent hover:border-[#c4562e]">
              پرونده‌ها // حل بحران‌های زنده
            </a>
            <a href="#lifecycle" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-r border-transparent hover:border-[#c4562e]">
              ۰۵ // چرخه حیات محصول
            </a>
            <a href={`${baseUrl}whitepapers/`} class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-r border-transparent hover:border-[#c4562e]">
              ۰۶ // اسناد مشخصات فنی
            </a>
            <a href="#book" class="block px-3 py-1.5 text-[#a8a196] hover:bg-[#141210] hover:text-[#e8e2d5] transition border-r border-transparent hover:border-[#c4562e]">
              ۰۷ // هماهنگی جلسه ارزیابی
            </a>
          </nav>
        </div>
      </aside>

      <!-- Main Blueprint Sections -->
      <div class="lg:col-span-9 space-y-10">
        
        <!-- SECTION 01: Payment Settlement -->
        <section id="payment-settlement" class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-8 rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">۰۱ // مسیریابی تراکنش و دفاتر کل</span>
            <div class="h-px flex-1 bg-[#5c6650]"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#e8e2d5]">موتور تسویه پرداخت رویدادمحور و اصول دفتر کل</h2>
          
          <!-- Invariant Box -->
          <div class="mt-4 p-3 bg-[#141210] border-r-2 border-[#c4562e] text-xs space-y-1">
            <span class="text-[#c4562e] font-bold uppercase tracking-wider block">اصل تخطی‌ناپذیر معماری (Invariant)</span>
            <p class="text-[#e8e2d5] font-mono">حالت درخواست &ne; واقعیت تسویه. حذف کامل تسویه مضاعف در پنجره‌های بازپخش ۸۶٬۴۰۰ ثانیه‌ای.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#a8a196] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              لبه ورودی با پروتکل TLS 1.3 قفل توزیع‌شده اتمی Redis با دستور <code class="text-[#c9a15a]">SETNX</code> و انقضای ۸۶٬۴۰۰ ثانیه را ثبت می‌کند. داده‌ها به ساختار بیت‌مپ باینری ISO 8583 جهت اتصال مستقیم به سوییچ‌های بانکی تبدیل می‌شوند. محاسبه موجودی تنها از طریق بازپخش ترتیبی رویدادها در کلاستر دفتر کل فقط‌افزودنی ScyllaDB مجهز به استاندارد ACID صورت می‌پذیرد.
            </p>
          </div>

          <!-- Failure Mode -->
          <div class="mt-3 p-3 bg-[#141210] border-r-2 border-[#c9a15a] text-xs space-y-1">
            <span class="text-[#c9a15a] font-bold uppercase tracking-wider block">حالت خرابی و راهکار تاب‌آوری</span>
            <p class="text-[#a8a196] leading-relaxed">
              قطعی ارتباط شبکه بین درگاه و سوییچ تسویه بالادست. پیشگیری از شارژ یا تسویه مضاعف از طریق جداسازی بازپخش؛ ثبت خودکار سند برگشت (۰۴۲۰) به عنوان یک ردیف جدید در دفتر کل بدون بازنویسی وضعیت‌های پیشین.
            </p>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-4">
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">SLA زیر ۵۰ میلی‌ثانیه</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">قفل اتمی Redis O(1)</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">بیت‌مپ ISO 8583</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">دفترکل دوبل ScyllaDB</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210] border border-[#5c6650] p-2 sm:p-4 my-4 overflow-hidden rounded-none" dir="ltr">
            <img 
              src={`${baseUrl}diagrams/placeholder-1.svg`} 
              alt="نقشه شماتیک سوییچ و تسویه حساب مالی"
              class="w-full h-auto object-contain rounded-none"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex justify-between items-center text-xs">
            <span class="text-[#a8a196]">مشخصات فنی و معماری پروتکل در پرونده ۰۱ تدوین شده است.</span>
            <a href={`${baseUrl}whitepapers/payment-gateway.html`} class="text-[#c4562e] font-bold hover:underline">
              مشاهده سند فنی ۰۱ &larr;
            </a>
          </div>
        </section>

        <!-- SECTION 02: Fraud Forensics -->
        <section id="fraud-forensics" class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-8 rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">۰۲ // ردیابی تهدید و پایش ریسک</span>
            <div class="h-px flex-1 bg-[#5c6650]"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#e8e2d5]">کشف تقلب در لحظه و ردیابی گراف قضایی</h2>
          
          <!-- Invariant Box -->
          <div class="mt-4 p-3 bg-[#141210] border-r-2 border-[#c4562e] text-xs space-y-1">
            <span class="text-[#c4562e] font-bold uppercase tracking-wider block">اصل تخطی‌ناپذیر معماری (Invariant)</span>
            <p class="text-[#e8e2d5] font-mono">زمان پاسخ حلقه ارزیابی ریسک کمتر از ۱۵ میلی‌ثانیه؛ شواهد باید در مراجع قضایی قابل استناد باشد.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#a8a196] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              لبه ورودی با استخراج انتروپی بوم (Canvas)، شتاب دستگاه و ریتم کلیدزنی، بردارهای چندبعدی ریسک [۰٫۰۰ تا ۱٫۰۰] را در کمتر از ۱۵ میلی‌ثانیه تولید می‌کند. تراکنش‌های زیر ۰٫۳۰ بدون اصطکاک عبور می‌کنند؛ ۰٫۳۰ تا ۰٫۷۵ اعتبارسنجی بیومتریک 3DS 2.0 را فعال می‌سازد (انتقال مسئولیت مالی به بانک صادرکننده)؛ امتیازهای بالای ۰٫۷۵ در کلاستر گراف Neo4j قرنطینه و تحلیل می‌شوند.
            </p>
          </div>

          <!-- Failure Mode -->
          <div class="mt-3 p-3 bg-[#141210] border-r-2 border-[#c9a15a] text-xs space-y-1">
            <span class="text-[#c9a15a] font-bold uppercase tracking-wider block">حالت خرابی و راهکار تاب‌آوری</span>
            <p class="text-[#a8a196] leading-relaxed">
              حملات تصاحب توزیع‌شده حساب و سوءاستفاده هماهنگ از کدهای تخفیف. عبور از قواعد ایستا با ردیابی بازگشتی جریان وجوه در کلاستر گراف میان بیش از ۴۰ میکروسرویس مسدود می‌شود.
            </p>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-4">
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">حلقه ریسک زیر ۱۵ms</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">انتقال مسئولیت با 3DS 2.0</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">مثبت کاذب زیر ۰٫۵٪</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">گراف قضایی Neo4j</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210] border border-[#5c6650] p-2 sm:p-4 my-4 overflow-hidden rounded-none" dir="ltr">
            <img 
              src={`${baseUrl}diagrams/placeholder-2.svg`} 
              alt="نقشه شماتیک سامانه کشف تقلب و ردیابی گراف"
              class="w-full h-auto object-contain rounded-none"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex justify-between items-center text-xs">
            <span class="text-[#a8a196]">منطق دقیق کاهش ریسک و پرونده‌های قضایی در سند ۰۲ تدوین شده است.</span>
            <a href={`${baseUrl}whitepapers/fraud-tracing.html`} class="text-[#c4562e] font-bold hover:underline">
              مشاهده سند فنی ۰۲ &larr;
            </a>
          </div>
        </section>

        <!-- SECTION 03: Telecom SMS Gateway -->
        <section id="sms-gateway" class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-8 rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">۰۳ // سوییچ‌های مخابراتی و صفوف</span>
            <div class="h-px flex-1 bg-[#5c6650]"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#e8e2d5]">زیرساخت مسیریابی و تجمیع پیامک ملی</h2>
          
          <!-- Invariant Box -->
          <div class="mt-4 p-3 bg-[#141210] border-r-2 border-[#c4562e] text-xs space-y-1">
            <span class="text-[#c4562e] font-bold uppercase tracking-wider block">اصل تخطی‌ناپذیر معماری (Invariant)</span>
            <p class="text-[#e8e2d5] font-mono">عدم تاخیر در تحویل پیامک‌های اعتبارسنجی بانکی (OTP) در اوج ترافیک کمپین‌های تبلیغاتی میلیونی. بیش از ۱B پیامک در سال.</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#a8a196] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
              نشست‌های پایدار SMPP 3.4 با اپراتورها روی باندهای پیش‌شماره (۱۰۰۰ تا ۹۰۰۰) متوازن می‌شوند. کنترل جریان پنجره لغزان پویا (۱۶ تا ۶۴ PDU) همراه با استعلام بلادرنگ HLR برای پالایش شماره‌های خاموش و خطوط مسدود (*800#) پیش از ورود به صف ارسال.
            </p>
          </div>

          <!-- Failure Mode -->
          <div class="mt-3 p-3 bg-[#141210] border-r-2 border-[#c9a15a] text-xs space-y-1">
            <span class="text-[#c9a15a] font-bold uppercase tracking-wider block">حالت خرابی و راهکار تاب‌آوری</span>
            <p class="text-[#a8a196] leading-relaxed">
              اشباع لوله‌های اپراتور زیر بار محدودیت ۷۰ نویسه‌ای یونیکد UCS-2 فارسی. برطرف‌شده با جداسازی دقیق صف‌های اولویت‌دار بانکی از کمپین‌های انبوه بازاریابی.
            </p>
          </div>

          <!-- Tactical Tags -->
          <div class="flex flex-wrap gap-2 my-4">
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">ظرفیت ۵۰K+ TPS</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">سوکت‌های SMPP 3.4</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">قطعه‌بندی UCS-2</span>
            <span class="px-2.5 py-1 bg-[#3d4632] border border-[#5c6650] text-[#c9d4a8] text-[11px] font-bold uppercase">پشتیبانی *800# DND</span>
          </div>

          <!-- Linked SVG Diagram -->
          <div class="bg-[#141210] border border-[#5c6650] p-2 sm:p-4 my-4 overflow-hidden rounded-none" dir="ltr">
            <img 
              src={`${baseUrl}diagrams/placeholder-3.svg`} 
              alt="نقشه شماتیک هاب مسیریابی پیامک ملی"
              class="w-full h-auto object-contain rounded-none"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex justify-between items-center text-xs">
            <span class="text-[#a8a196]">مشخصات تجمیع‌کننده‌ها و مسیریابی مخابراتی در سند ۰۳ تدوین شده است.</span>
            <a href={`${baseUrl}whitepapers/sms-infrastructure.html`} class="text-[#c4562e] font-bold hover:underline">
              مشاهده سند فنی ۰۳ &larr;
            </a>
          </div>
        </section>

        <!-- SECTION 04: Data Pipeline -->
        <section id="data-pipeline" class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-8 rounded-none">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">۰۴ // تحلیل کلان‌داده و پالایش</span>
            <div class="h-px flex-1 bg-[#5c6650]"></div>
          </div>
          <h2 class="text-2xl font-bold text-[#e8e2d5]">تجمیع ۱۰۰ میلیون رکورد و پایگاه داده Smart DB v1</h2>
          
          <!-- Invariant Box -->
          <div class="mt-4 p-3 bg-[#141210] border-r-2 border-[#c4562e] text-xs space-y-1">
            <span class="text-[#c4562e] font-bold uppercase tracking-wider block">اصل تخطی‌ناپذیر معماری (Invariant)</span>
            <p class="text-[#e8e2d5] font-mono">پیش‌بینی رفتار و ترجیحات کاربران با دقت ۷۰٪ پیش از بارگذاری داده‌های احراز هویت (KYC).</p>
          </div>

          <!-- Mechanism -->
          <div class="text-[#a8a196] text-xs sm:text-sm mt-3 space-y-2 leading-relaxed">
            <p>
