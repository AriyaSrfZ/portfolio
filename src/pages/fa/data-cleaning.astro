---
import Layout from '../../layouts/Layout.astro';
import { copy } from '../../lib/content';

const fa = copy.fa.dataCleaning;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title={`${fa.title} — آریا صراف‌زاده`} description={fa.lead} lang="fa" dir="rtl">
  <article class="max-w-4xl mx-auto px-6 pt-32 pb-24 font-sans" dir="rtl">
    <div class="flex justify-between items-center mb-4">
      <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#06b6d4]">{fa.kicker}</p>
      <a href={`${baseUrl}data-cleaning/`} class="px-3 py-1.5 text-xs rounded-lg border border-white/10 bg-white/[0.03] text-[#e2c974] hover:border-[#e2c974] hover:text-[#f8fafc] uppercase font-bold transition">
        English Version
      </a>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-[#f8fafc] tracking-tight mt-2">{fa.title}</h1>
    <p class="mt-4 text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.lead}</p>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{fa.s1Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.s1Body1}</p>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.s1Body2}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{fa.s2Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.s2Lead}</p>
      <div class="space-y-3">
        {(fa.s2Items ?? []).map((item) => (
          <div class="bg-[#111827]/70 backdrop-blur-xl border border-white/10 rounded-xl p-5 hover:border-white/20 transition-colors">
            <h3 class="text-sm font-bold uppercase text-[#e2c974]">{item?.title ?? ''}</h3>
            <p class="text-xs leading-relaxed text-[#94a3b8] mt-2">{item?.body ?? ''}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{fa.s3Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.s3Body}</p>
      <ol class="list-decimal pr-5 space-y-2 text-xs sm:text-sm text-[#94a3b8]">
        {(fa.s3Steps ?? []).map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p class="text-[11px] text-[#64748b] mt-2">{fa.fig1Caption}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{fa.s4Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.s4Body}</p>
      {(fa.s4Items ?? []).map((item) => (
        <div class="bg-[#111827]/70 backdrop-blur-xl border border-white/10 rounded-xl p-5 hover:border-white/20 transition-colors">
          <h3 class="text-sm font-bold uppercase text-[#e2c974]">{item?.title ?? ''}</h3>
          <p class="text-xs leading-relaxed text-[#94a3b8] mt-2">{item?.body ?? ''}</p>
        </div>
      ))}
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{fa.s5Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.s5Body}</p>
      {(fa.s5Items ?? []).map((item) => (
        <div class="bg-[#111827]/70 backdrop-blur-xl border border-white/10 rounded-xl p-5 hover:border-white/20 transition-colors">
          <h3 class="text-sm font-bold uppercase text-[#e2c974]">{item?.title ?? ''}</h3>
          <p class="text-xs leading-relaxed text-[#94a3b8] mt-2">{item?.body ?? ''}</p>
        </div>
      ))}
      <p class="text-[11px] text-[#64748b] mt-2">{fa.fig2Caption}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{fa.s6Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.s6Body}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{fa.s7Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.s7Body}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{fa.s8Title}</h2>
      <p class="text-xs sm:text-sm leading-relaxed text-[#94a3b8]">{fa.s8Body}</p>
      <p class="text-[11px] text-[#64748b] mt-2">{fa.fig3Caption}</p>
    </section>

    <section class="mt-12 space-y-4">
      <h2 class="text-xl font-bold text-[#f8fafc] tracking-tight">{fa.s9Title}</h2>
      <ul class="space-y-2 text-xs sm:text-sm text-[#94a3b8] list-disc pr-5">
        {(fa.s9Items ?? []).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="text-xs sm:text-sm leading-relaxed text-[#e2c974] mt-3 font-semibold">{fa.s9Note}</p>
    </section>
  </article>
</Layout>
