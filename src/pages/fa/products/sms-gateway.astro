---
import Layout from '../../../layouts/Layout.astro';
import TelecomCatalogExplorer from '../../../components/react/TelecomCatalogExplorer';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const stats = [
  { value: '۱,۰۸۰,۰۰۰+', label: 'ارسال روزانه پیامک', sub: 'ترافیک بانکی، OTP و خدماتی' },
  { value: '۲۲', label: 'درگاه فیزیکی کاریر', sub: 'مگفا، آسیاتک، فناپ، آسانک، آرین‌تل' },
  { value: '۴۵۴', label: 'ماژول عملیاتی', sub: 'کالبدشکافی و کاتالوگ‌شده در سامانه' },
  { value: '۱۴', label: 'جدول موازی مگفا ۳۰۰۰', sub: 'شاردینگ فیزیکی در MySQL' },
  { value: '۱۰', label: 'پکیج رسمی SDK', sub: 'Go, Python, Node, Java, .NET, PHP' },
  { value: 'زیر ۱۲۰ms', label: 'تاخیر P99 درگاه لبه', sub: 'کش زیر ۵ میلی‌ثانیه ردیس MNP' },
];

const networkFleet = [
  { name: 'DB-Master (نود اصلی)', ip: '192.168.1.101', role: 'پایگاه داده اصلی MySQL، میزبان جداول شاردشده پیامک، تراکنش‌های مالی و کاربران', os: 'Linux 5.15 / MySQL 8.0' },
  { name: 'Feresta-DB-Slave (رپلیکا)', ip: '192.168.1.64', role: 'نود پشتیبان و رپلیکا، دریافت تغییرات از طریق Binary Logs با ۲۴۰ گیگ فضای دیسک آزاد', os: 'Linux 5.15 / MySQL Replica' },
  { name: 'fersta-nginx-gateway', ip: '192.168.1.150', role: 'لودبالانسرهای HAProxy و Nginx، مدیریت پایان SSL، ریت‌لیمیتینگ و روتینگ پورت‌های ۴۰۰۰-۴۰۰۵', os: 'Nginx + HAProxy 2.6' },
  { name: 'smart-db (نود پایش)', ip: '192.168.1.136', role: 'سامانه پایش زیرساخت، سرور زبیکس ۶.۴.۶، پرومتئوس و جمع‌آوری متریک‌های کاریر', os: 'Zabbix Server 6.4.6' },
];

const allCarrierGateways = [
  { id: '۱', name: '3000 - مسیر اصلی', op: 'مگفا (Magfa Main)', status: 'فعال', table: 'sms_send_3000', endpoint: 'dargahha_edit&id=1' },
  { id: '۲', name: '3000 - مسیر فرعی اول (30001)', op: 'مگفا فرعی ۱', status: 'فعال', table: 'sms_send_30001', endpoint: 'dargahha_edit&id=2' },
  { id: '۳', name: '3000 - ESB اصلی (30000)', op: 'مگفا وب‌سرویس ESB', status: 'فعال', table: 'sms_send_30000', endpoint: 'dargahha_edit&id=3' },
  { id: '۴', name: '3000 - ESB فرعی یک (300010)', op: 'مگفا وب‌سرویس ESB 1', status: 'فعال', table: 'sms_send_300010', endpoint: 'dargahha_edit&id=4' },
  { id: '۵', name: '3000 - مسیر فرعی دوم (30002)', op: 'مگفا فرعی ۲', status: 'فعال', table: 'sms_send_30002', endpoint: 'dargahha_edit&id=5' },
  { id: '۶', name: '3000 - ESB فرعی دو (300020)', op: 'مگفا وب‌سرویس ESB 2', status: 'فعال', table: 'sms_send_300020', endpoint: 'dargahha_edit&id=6' },
  { id: '۷', name: '9000 - مسیر اصلی', op: 'آسیاتک / سماسو', status: 'فعال', table: 'sms_send_9000', endpoint: 'dargahha_edit&id=7' },
  { id: '۸', name: '50002 مسیر اصلی', op: 'راهکار سرزمین هوشمند', status: 'فعال', table: 'sms_send_50002', endpoint: 'dargahha_edit&id=8' },
  { id: '۹', name: 'مگفا - همراه اول (3000)', op: 'مگفا فیلتر MCI', status: 'فعال', table: 'sms_send_3000', endpoint: 'dargahha_edit&id=9' },
  { id: '۱۰', name: 'مگفا - ایرانسل (3000)', op: 'مگفا فیلتر MTN', status: 'فعال', table: 'sms_send_3000', endpoint: 'dargahha_edit&id=10' },
  { id: '۱۱', name: 'آسانک اصلی (982100)', op: 'آسانک (تلفن ثابت ۰۲۱)', status: 'فعال', table: 'sms_send_982100', endpoint: 'dargahha_edit&id=11' },
  { id: '۱۲', name: 'آرینتل - بالک خدماتی', op: 'آرینتل (999800)', status: 'فعال', table: 'sms_send_999800', endpoint: 'dargahha_edit&id=12' },
  { id: '۱۳', name: '3000 - مسیر فرعی سوم (30003)', op: 'مگفا فرعی ۳', status: 'فعال', table: 'sms_send_30003', endpoint: 'dargahha_edit&id=13' },
  { id: '۱۴', name: '3000 - مسیر فرعی چهارم (30004)', op: 'مگفا فرعی ۴', status: 'فعال', table: 'sms_send_30004', endpoint: 'dargahha_edit&id=14' },
  { id: '۱۵', name: '3000 - مسیر فرعی پنجم (30005)', op: 'مگفا فرعی ۵', status: 'فعال', table: 'sms_send_30005', endpoint: 'dargahha_edit&id=15' },
  { id: '۱۶', name: '3000 - مسیر فرعی ششم (30006)', op: 'مگفا فرعی ۶', status: 'فعال', table: 'sms_send_30006', endpoint: 'dargahha_edit&id=16' },
  { id: '۱۷', name: '3000 - مسیر فرعی هفتم (30007)', op: 'مگفا فرعی ۷', status: 'فعال', table: 'sms_send_30007', endpoint: 'dargahha_edit&id=17' },
  { id: '۱۸', name: '3000 - مسیر فرعی هشتم (30008)', op: 'مگفا فرعی ۸', status: 'فعال', table: 'sms_send_30008', endpoint: 'dargahha_edit&id=18' },
  { id: '۱۹', name: '3000 - مسیر فرعی نهم (30009)', op: 'مگفا فرعی ۹', status: 'فعال', table: 'sms_send_30009', endpoint: 'dargahha_edit&id=19' },
  { id: '۲۰', name: '30003 ESB (300030)', op: 'مگفا وب‌سرویس ESB 3', status: 'غیرفعال', table: 'sms_send_300030', endpoint: 'dargahha_edit&id=20' },
  { id: '۲۱', name: 'فناپ - خدماتی (9992101)', op: 'فناپ تلکام', status: 'فعال', table: 'sms_send_9992101', endpoint: 'dargahha_edit&id=21' },
  { id: '۲۲', name: 'otp صوتی (9876)', op: 'تماس صوتی اعتبارسنجی', status: 'فعال', table: 'sms_send_9876', endpoint: 'dargahha_edit&id=22' },
];

const forensicTools = [
  { title: 'کشف پیام‌های معلق طولانی', param: 'detect_long_pending', desc: 'رهگیری رکوردهایی که ساعت‌ها در وضعیت معلق مانده و پاسخی از کاریر دریافت نکرده‌اند (اثبات اختلال کاریر).' },
  { title: 'پندینگ‌های جاری لحظه‌ای', param: 'detect_long_pending_current', desc: 'نمایش برخط قدیمی‌ترین پیامک‌های شمارش‌نشده جهت ارزیابی زنده سلامت ورکرها و ترودپوت صفوف.' },
  { title: 'خطاهای مستقیم کاریر در آرشیو', param: 'sms_provider_error_in_archive', desc: 'استخراج کدهای خطای اپراتور در آرشیو جهت تفکیک قطعی سمت مگفا در برابر زیرساخت داخلی.' },
  { title: 'مغایرت شمارش پیامک‌ها', param: 'sms_send_count_discrepancy', desc: 'تطبیق بلادرنگ تعداد پیام‌های ورودی به وب‌سرویس با بسته‌های تحویل داده‌شده به کاریر و تسویه‌حساب مالی.' },
  { title: 'مدیریت ردیس ترابرد (MNP)', param: 'tarabord_redis_manager', desc: 'کش سریع نگاشت پیش‌شماره‌های ترابردشده میان سه اپراتور اصلی در کمتر از ۵ میلی‌ثانیه جهت کاهش هزینه شارژ کاریر.' },
  { title: 'مانیتورینگ صف‌های رابیت‌ام‌کیو', param: 'monitoring_rabbitmq', desc: 'پایش بلادرنگ عمق صف‌های rabbitmq-delivery و rabbitmq-esb جهت ممانعت از انباشت بار در ساعات اوج.' },
  { title: 'سازنده ویژوال کانفیگ Kannel', param: 'kannel_config_builder', desc: 'پیکربندی خودکار اتصالات SMPP v3.4، پنجره‌های ارسال لغزان (Sliding Window) و باکس‌های پیامکی.' },
  { title: 'مدیریت و لغو کوئری‌های قفل‌کننده', param: 'query_list', desc: 'مشاهده لیست کوئری‌های فعال MySQL و متوقف‌سازی اضطراری دستورات سنگین گزارش‌گیری غیرمجاز.' },
];

const actionPlan = [
  { step: '۱', title: 'تصویب پنجره تغییرات رسمی (Maintenance Window)', owner: 'مدیریت فنی', deadline: 'فوری (۲۴ ساعت)', impact: 'انتقال هرگونه سینک رپلیکا و عملیات سنگین به ساعات ۰۲:۰۰ الی ۰۶:۰۰ بامداد جهت حذف تداخل با ترافیک روزانه' },
  { step: '۲', title: 'اصلاح پارامتر هسته کرنل (vm.swappiness = 1)', owner: 'تیم زیرساخت', deadline: '۴۸ ساعت', impact: 'کاهش گرایش کرنل لینوکس به سوآپینگ بیهوده در شرایطی که ۲۲ گیگابایت رم آزاد فیزیکی وجود دارد' },
  { step: '۳', title: 'تنظیم انقضای لاگ‌ها (binlog_expire_logs_seconds = 259200)', owner: 'ادمین دیتابیس', deadline: '۴۸ ساعت', impact: 'محدودسازی لاگ‌های باینری به ۳ روز جهت ممانعت از انباشت ۳۸۶ گیگابایت لاگ و حذف پیک خواندن دیسک' },
  { step: '۴', title: 'تفکیک ترافیک خواندن روی سرور اسلیو (192.168.1.64)', owner: 'تیم توسعه و دواپس', deadline: '۱ هفته', impact: 'هدایت کوئری‌های گزارش‌گیری و مغایرت‌گیری سنگین به نود اسلیو با ۲۴۰ گیگ فضای خالی دیسک' },
  { step: '۵', title: 'تعریف هشدار زبیکس برای تردهای فعال بالای ۵۰', owner: 'تیم پایش سیستم', deadline: '۳ روز', impact: 'ارسال هشدار آنی در پیام‌رسان پیش از رسیدن تردهای دیتابیس به نقطه اشباع ۱۴۷ و قفل شدن صفوف' },
];
---

<Layout 
  title="سامانه جامع ملی درگاه و روتینگ پیامک سازمانی (Tellir / Feresta) — آریا صراف‌زاده"
  description="پرونده جامع مهندسی پلتفرم پیامک سازمانی پرشیا فاوا: ۱.۰۸ میلیون پیامک روزانه، ۲۲ درگاه کاریر، ۱۴ جدول موازی شاردینگ مگفا، کاتالوگ تعاملی ۴۵۴ ماژول، تلمتری ۷ لایه زبیکس و کالبدشکافی تحلیلی حادثه ۱۷ آبان."
  lang="fa"
  dir="rtl"
>
  <article class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-28 font-sans text-right" dir="rtl">
    
    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-secondary)] font-mono">
        <a href={`${baseUrl}fa/`} class="hover:text-[var(--accent-primary)] transition">خانه</a>
        <span>/</span>
        <a href={`${baseUrl}fa/products/`} class="hover:text-[var(--accent-primary)] transition">محصولات مهندسی</a>
        <span>/</span>
        <span class="text-[var(--text-primary)] font-semibold">پلتفرم سوئیچ و روتینگ پیامک سازمانی</span>
      </nav>
      <div class="flex items-center gap-2">
        <a 
          href={`${baseUrl}products/sms-gateway/`} 
          class="px-3 py-1 text-xs rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--accent-warm)] hover:border-[var(--accent-warm)] transition font-bold"
        >
          English Version
        </a>
      </div>
    </div>

    <!-- Hero Header -->
    <header class="border-b border-[var(--border)] pb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-500 text-xs font-mono font-bold mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        سامانه پروداکشن عملیاتی · شناسنامه مهندسی معکوس و تلمتری زنده
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--text-primary)] tracking-tight leading-tight">
        پلتفرم ملی درگاه و روتینگ پیامک سازمانی (Tellir / Feresta)
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[var(--text-secondary)] max-w-5xl leading-relaxed">
        معماری، کالبدشکافی و توسعه‌یافته برای شرکت <strong>پرشیا فاوا گسترش</strong> جهت مدیریت، پردازش و هدایت <strong>بیش از ۱,۰۸۰,۰۰۰ پیامک روزانه بانکی، احراز هویت و تراکنشی</strong> از طریق ۲۲ درگاه کاریر، ۱۴ جدول موازی دیتابیس MySQL، کلاسترهای Kannel SMPP v3.4 و صفوف پیشرفته RabbitMQ. شامل کاوشگر تحت وب ۴۵۴ ماژول، تلمتری ۷ لایه زبیکس، همبستگی Z-Factor در گرافانا و پرونده جامع فارنزیک حوادث.
      </p>

      <!-- Sticky Quick-Jump Navigation Tabs -->
      <nav class="mt-8 flex flex-wrap gap-2 pt-4 border-t border-[var(--border)] text-xs font-bold font-mono">
        <a href="#topology" class="px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-card)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition">
          ۰۱ · معماری و ناوگان
        </a>
        <a href="#gateways" class="px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-card)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition">
          ۰۲ · ۲۲ درگاه و مگفا
        </a>
        <a href="#zabbix" class="px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-card)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition">
          ۰۳ · ۷ داشبورد زبیکس
        </a>
        <a href="#grafana" class="px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-card)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition">
          ۰۴ · گرافانا و Z-Factor
        </a>
        <a href="#postmortem" class="px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-card)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition">
          ۰۵ · کالبدشکافی حادثه
        </a>
        <a href="#godmode" class="px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-card)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition">
          ۰۶ · گاد-مود و عیب‌یابی
        </a>
        <a href="#catalog" class="px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-card)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition">
          ۰۷ · کاوشگر ۴۵۴ ماژول
        </a>
        <a href="#sdks" class="px-3 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-card)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition">
          ۰۸ · پکیج ۱۰ SDK و پنل‌ها
        </a>
      </nav>
    </header>

    <!-- Key Metrics Grid -->
    <section class="mt-10">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
        {stats.map((s) => (
          <div class="p-4 rounded-2xl border border-[var(--border)] bg-[var(--surface-card)] text-center hover:border-[var(--accent-primary)] transition-colors shadow-sm">
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[var(--accent-primary)] tracking-tight">{s.value}</div>
            <div class="text-xs font-bold text-[var(--text-primary)] mt-1">{s.label}</div>
            <div class="text-[10px] text-[var(--text-secondary)] mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 1: ARCHITECTURE & FLEET TOPOLOGY -->
    <section id="topology" class="mt-16 pt-6 space-y-6">
      <div class="border-b border-[var(--border)] pb-3 flex justify-between items-end">
        <div>
          <span class="text-xs font-mono font-bold text-[var(--accent-warm)] uppercase tracking-wider">بخش ۰۱</span>
          <h2 class="text-2xl font-bold text-[var(--text-primary)] tracking-tight mt-1">
            معماری سیستم، ناوگان شبکه و لایه‌های پردازش ترافیک
          </h2>
          <p class="text-sm text-[var(--text-secondary)] mt-1">
            تفکیک ترافیک پرسرعت بانکی و خدماتی از ارسال‌های انبوه تبلیغاتی با معماری سه‌لایه لبه، پیام و پایگاه داده.
          </p>
        </div>
      </div>

      <!-- Fleet Architecture Description Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--surface-card)]">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-[var(--text-primary)]">۱. لایه لبه و دریافت وب‌سرویس</h3>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[var(--surface-sunken)] text-[var(--accent-primary)]">HAProxy / Nginx</span>
          </div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            لودبالانسرهای HAProxy روی نود <code>192.168.1.150</code> وظیفه خاتمه SSL، فیلترینگ IPهای غیرمجاز و توزیع بار میان پورت‌های ۴۰۰۰ تا ۴۰۰۵ وب‌سرویس را بر عهده دارند. ترافیک‌های حساس OTP مستقیماً در صف اولویت‌دار لایه پیام قرار می‌گیرند.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--surface-card)]">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-[var(--text-primary)]">۲. صفوف توزیع‌شده و Kannel</h3>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[var(--surface-sunken)] text-[var(--accent-warm)]">RabbitMQ & SMPP</span>
          </div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            صفوف <code>rabbitmq-delivery</code> و <code>rabbitmq-esb</code> نوسانات ترافیک را مهار می‌کنند. باکس‌های Kannel با پروتکل SMPP v3.4 و پنجره‌های لغزان (Sliding Window) پکت‌های پیام را با ترودپوت بیش از ۳۵۰ پیامک در ثانیه به کاریر تزریق می‌نمایند.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--surface-card)]">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-[var(--text-primary)]">۳. لایه پایداری داده و حافظه</h3>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[var(--surface-sunken)] text-emerald-500">MySQL & Redis MNP</span>
          </div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            دیتابیس اصلی روی نود <code>192.168.1.101</code> پیام‌ها را در ۱۴ جدول موازی ذخیره می‌کند. کلاستر ردیس با ذخیره‌سازی داده‌های ترابرد شماره‌ها (MNP) و بلک‌لیست مخابراتی، استعلام مسیر صحیح را در کمتر از ۵ میلی‌ثانیه پاسخ می‌دهد.
          </p>
        </div>
      </div>

