---
import Layout from '../../layouts/Layout.astro';
import { stats } from '../../data/stats';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const caseStudies = [
  {
    id: '۰۱',
    category: 'تسویه مالی و دفاتر کل',
    title: 'دفتر کل دوطرفه (Double-Entry) و تخصیص دومرحله‌ای موجودی',
    summary: 'منبع یگانه حقیقت مالی با تضمین انطباق ACID، ماشین حالت تخصیص دومرحله‌ای موجودی (AVAILABLE به RESERVED) و تراز ریاضی بدهکار و بستانکار.',
    problem: 'ناهمخوانی دفاتر کل و مانده‌های شبح هنگام تراکنش‌های همزمان بالا، جایگاه شرکت نزد مراجع نظارتی و بانک مرکزی را به خطر می‌انداخت.',
    decision: 'اعمال تخصیص دومرحله‌ای همگام موجودی، قفل‌های توزیع‌شده Redis SETNX و ثبت تغییرناپذیر تراکنش‌ها در دفتر کل دوطرفه ScyllaDB.',
    tradeoff: 'اولویت‌دادن به تخصیص دومرحله‌ای همگام موجودی و تراز قطعی دفاتر کل بر سرعت خام پردازش تراکنش‌ها.',
    outcome: `حفظ ۱۰۰ درصدی تراز ریاضی دفاتر کل در بیش از ${stats.reconciliationTrialEvents.workFa} بدون حتی یک مورد واریز تکراری یا نشت مالی.`,
    link: `${baseUrl}fa/blog/payment-gateway/`,
    badge: stats.financialDriftPercent.badgeCleanFa,
    tags: ['دفتر کل دوطرفه', 'تخصیص دومرحله‌ای موجودی', 'انطباق ACID', 'ایدامپوتنسي Redis SETNX', 'مخزن داده ScyllaDB']
  },
  {
    id: '۰۲',
    category: 'مهار ریسک و احراز هویت',
    title: 'احراز هویت شاهکار، رمز پویای حریم و زون ایزوله بانکی (PCI-DSS)',
    summary: `موتور ارزیابی ناهنجاری‌های مالی در ${stats.fraudRiskLoopSla.textFa}، زون ایزوله توکن‌سازی CVV2 بدون ذخیره‌سازی و رمز پویای ۴ پارامتری سامانه حریم بانک مرکزی.`,
    problem: 'قواعد ایستا خطای مثبت کاذب بالایی داشتند و کلاهبرداران با سوءاستفاده از تاخیر تعویض سیم‌کارت، رمزهای سنتی را دور می‌زدند.',
    decision: 'استقرار زون ایزوله بانکی (PCI-DSS) جهت توکن‌سازی کارت‌ها، اتصال به احراز هویت شاهکار و انتقال مسئولیت با پروتکل 3DS 2.0.',
    tradeoff: 'امتناع از کش‌کردن کدهای CVV2 به بهانه راحتی خرید، و اعمال توکن‌سازی سخت‌گیرانه در زون ایزوله بانکی.',
    outcome: `کاهش ${stats.fraudDrainReduction.raw} درصدی نشت مالی و حفظ نرخ عبور بدون چالش بالای ${stats.frictionless3dsPassRate.raw} درصد در 3DS 2.0.`,
    link: `${baseUrl}fa/blog/fraud-tracing/`,
    badge: stats.fraudRiskLoopSla.workBadgeFa,
    tags: ['زون ایزوله بانکی (PCI-DSS)', 'رمز پویای ۴ پارامتری حریم', 'احراز هویت شاهکار', 'توکن‌سازی امن کارت', 'تحلیل گرافی Neo4j']
  },
  {
    id: '۰۳',
    category: 'سوییچ پرداخت و روتینگ',
    title: 'سوییچ هوشمند پرداخت (Smart PSP Switch) و مسیریابی چنددرگاهی',
    summary: `سوییچ اختصاصی Head-to-Head با بسته‌بندی پیام‌های ISO 8583 و تغییر مسیر خودکار ${stats.switchFailoverSla.textFa} میان ۴ شرکت PSP ملی (سپ، پک، به‌پرداخت، پاسارگاد).`,
    problem: 'وابستگی به یک PSP انحصاری در زمان اختلالات شاپرک و تسویه بانکی باعث ریزش شدید خریدهای کاربران می‌شد.',
    decision: 'معماری Switch-PSP با روتینگ پویای وزنی بر پایه نرخ موفقیت، تاخیر P99، تعرفه کارمزد و آداپتورهای هاب فناوران.',
    tradeoff: 'توسعه سوییچ چنددرگاهی آگنوستیک با تخصیص پویای اوزان به جای تکیه بر قرارداد با یک شرکت PSP منفرد.',
    outcome: `دست‌یابی به آپ‌تایم ${stats.switchGatewayUptime.raw} درصدی درگاه، تاخیر رفت‌وبرگشت زیر ۲۵۰ میلی‌ثانیه و بازگشت خودکار ${stats.switchFailoverSla.raw} میلی‌ثانیه‌ای در قطعی‌های شبکه شاپرک.`,
    link: `${baseUrl}fa/blog/sms-infrastructure/`,
    badge: stats.switchFailoverSla.workBadgeFa,
    tags: ['سوییچ هوشمند پرداخت', 'روتینگ پویای تراکنش', 'اتصال به هاب فناوران', 'پروتکل ISO 8583 شاپرک', 'تغییر مسیر خودکار ۳۰ms']
  },
  {
    id: '۰۴',
    category: 'مغایرت‌گیری و تسویه',
    title: 'مغایرت‌گیری چندمرحله‌ای رویدادمحور و تسویه ۲۴ ساعته پذیرندگان',
    summary: `مغایرت‌گیری سه‌طرفه شبانه ${stats.reconBatchEngine.raw} میان دفاتر کل و اسناد تسویه بانکی، سامانه خودترمیم Refund-MNG و تسویه پیش از موعد پذیرندگان.`,
    problem: `مغایرت‌گیری دستی اکسل تسویه حساب پذیرندگان را تا ${stats.legacyManualPayoutDelay.fa} به تاخیر می‌انداخت و جریان نقدینگی فروشندگان را قفل می‌کرد.`,
    decision: 'توسعه پایپ‌لاین ناهمزمان مغایرت‌گیری روی مش رویداد RabbitMQ، دریافت خودکار فایل‌های SFTP بانکی و فعال‌سازی تسویه پیش از موعد پذیرندگان (Merchant Credit).',
    tradeoff: 'مهاجرت از مغایرت‌گیری دستی و همگام به ماشین حالت ناهمزمان چندمرحله‌ای متصل به پایپ‌لاین‌های خودکار SFTP بانکی.',
    outcome: `راه‌اندازی تسویه زودهنگام ${stats.merchantPayoutWindow.raw} ساعته پذیرندگان با کسر هوشمند کارمزد شناور و حذف ۱۰۰ درصدی هزینه‌های مغایرت‌گیری دستی.`,
    link: `${baseUrl}fa/data-cleaning/`,
    badge: `تسویه پیش از موعد ${stats.merchantPayoutWindow.raw}h`,
    tags: ['مغایرت‌گیری Spring Batch', 'سرویس خودترمیمی Refund-MNG', 'مش رویداد RabbitMQ', 'تسویه پیش از موعد پذیرندگان', 'پایپ‌لاین پایا و ساتنا']
  },
];
---

<Layout
  title="نمونه‌های موردی و پروژه‌های معماری: آریا صراف‌زاده"
  description="معماری سیستم‌های پرترافیک و حیاتی در شرایط واقعی رگولاتوری، عملیاتی و مقیاس کشوری."
  lang="fa"
  dir="rtl"
>
  <main class="max-w-[1400px] mx-auto px-6 pt-24 pb-20 font-['Vazirmatn',sans-serif]" dir="rtl">
    
    <!-- Hero / Header Banner -->
    <div class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-8 mb-8 shadow-2xl ring-1 ring-white/[0.03]">
      <div class="flex items-center gap-2 mb-2 font-mono text-[11px] text-[#94a3b8] uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
        <span>پروژه‌های اجرایی · پرونده‌های معماری پروداکشن</span>
        <div class="h-px flex-1 bg-white/[0.06]"></div>
        <span class="text-[10px] text-neutral-500 font-mono" dir="ltr">4 CASE STUDIES</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold uppercase text-[#ededed] mb-3 tracking-tight">
        معماری سیستم‌ها و نمونه‌های موردی
      </h1>
      <p class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed max-w-3xl">
        معماری و توسعه زیرساخت‌های پرترافیک و مأموریت‌محور تحت الزامات سخت‌گیرانه رگولاتوری، محدودیت‌های عملیاتی و همروندی در مقیاس کشوری.
      </p>
    </div>

    <!-- 4 Case Study Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {caseStudies.map((study) => (
        <article class="bg-[#111317]/90 border border-white/[0.07] rounded-xl p-6 flex flex-col justify-between hover:border-white/20 transition-all duration-200 group">
          <div>
            <!-- Top Tag & Badge -->
            <div class="flex items-center justify-between border-b border-white/[0.06] pb-2.5 mb-4">
              <span class="text-[10px] font-bold text-neutral-300 uppercase tracking-wider font-mono">
                پروژه {study.id} · {study.category}
              </span>
              <span class="text-[10px] font-mono text-[#10b981] uppercase px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06]" dir="ltr">
                {study.badge}
              </span>
            </div>

            <!-- Title & One-Line Summary -->
            <h2 class="text-lg font-bold text-[#ededed] uppercase tracking-tight mb-2 group-hover:text-white transition-colors">
              <a href={study.link}>
                {study.title}
              </a>
            </h2>
            <p class="text-xs text-[#94a3b8] leading-relaxed mb-4">
              {study.summary}
            </p>

            <!-- Technical Detail Box -->
            <div class="bg-[#090a0c]/80 border border-white/[0.06] rounded-lg p-3.5 space-y-2 mb-4 text-xs">
              <div>
                <span class="text-[10px] font-mono font-semibold text-neutral-400 uppercase tracking-wider">چالش سیستم:</span>
                <p class="text-[#94a3b8] text-[11px] mt-0.5 leading-relaxed">{study.problem}</p>
              </div>
              <div class="border-t border-white/[0.05] pt-1.5">
                <span class="text-[10px] font-mono font-semibold text-neutral-300 uppercase tracking-wider">تصمیم معماری:</span>
                <p class="text-[#ededed] text-[11px] mt-0.5 leading-relaxed">{study.decision}</p>
              </div>
              <div class="border-t border-white/[0.05] pt-1.5">
                <span class="text-[10px] font-mono font-semibold text-neutral-400 uppercase tracking-wider">تریدآف مهندسی:</span>
                <p class="text-[#94a3b8] text-[11px] mt-0.5 leading-relaxed">{study.tradeoff}</p>
              </div>
              <div class="border-t border-white/[0.05] pt-1.5">
                <span class="text-[10px] font-mono font-semibold text-[#10b981] uppercase tracking-wider">نتیجه عملیاتی:</span>
                <p class="text-[#10b981] text-[11px] mt-0.5 leading-relaxed">{study.outcome}</p>
              </div>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {study.tags.map((tag) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400">
                  [{tag}]
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Action Link -->
          <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono">
            <span class="text-[10px] text-neutral-500 uppercase" dir="ltr">CASE DOSSIER</span>
            <a
              href={study.link}
              class="font-semibold text-[#ededed] hover:text-white uppercase inline-flex items-center gap-1 group-hover:-translate-x-0.5 transition-transform"
            >
              <span>مشاهده سند کامل پرونده</span>
              <span>&larr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
