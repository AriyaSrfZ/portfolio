---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.data.lang === 'en' || post.id.startsWith('en/'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryLabels: Record<string, string> = {
  'fintech': 'Fintech & Payments',
  'network-infrastructure': 'Telecom & Network',
  'system-architecture': 'System Architecture',
  'data-engineering': 'Data Engineering',
  'product-management': 'Product Strategy',
  'api-products': 'API Platforms',
};

const categories = ['all', 'fintech', 'network-infrastructure', 'system-architecture', 'data-engineering', 'product-management'];
---

<Layout
  title="Engineering Blog & Technical Field Notes — Ariya Sarrafzadeh"
  description="Production post-mortems, distributed ledger implementations, telecom aggregation mechanics, and systems product strategy."
>
  <main class="max-w-[1400px] mx-auto px-6 pt-32 pb-24 font-sans">
    <!-- Header -->
    <div class="bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-10 mb-10 shadow-2xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase">SYSTEMS RESEARCH · ARCHITECTURE DISPATCHES · TECHNICAL FIELD NOTES</span>
        <div class="h-px flex-1 bg-white/10"></div>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold uppercase text-[#f8fafc] mb-4 tracking-tight">
        Engineering Blog & Articles
      </h1>
      <p class="text-[#94a3b8] text-sm sm:text-base leading-relaxed max-w-3xl">
        Deep dives into high-throughput ISO 8583 payment switching, ACID double-entry ledgers, SMPP telecom routing, fraud perimeter defense, and engineering leadership at national scale.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-2 mt-6 pt-6 border-t border-white/10">
        <button
          type="button"
          class="cat-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all duration-200 bg-[#06b6d4]/20 border border-[#06b6d4]/40 text-[#38bdf8]"
          data-category="all"
        >
          All Dossiers ({posts.length})
        </button>
        {categories.filter(c => c !== 'all').map((cat) => {
          const count = posts.filter(p => p.data.category === cat).length;
          if (count === 0) return null;
          return (
            <button
              type="button"
              class="cat-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all duration-200 bg-white/[0.03] border border-white/10 text-[#94a3b8] hover:text-[#f8fafc] hover:border-white/20"
              data-category={cat}
            >
              {categoryLabels[cat] || cat} ({count})
            </button>
          );
        })}
      </div>
    </div>

    <!-- Articles Grid -->
    <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((doc, idx) => (
        <article
          class="article-card bg-[#111827]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-7 flex flex-col justify-between shadow-xl ring-1 ring-white/5 group hover:border-cyan-500/40 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl"
          data-cat={doc.data.category}
        >
          <div>
            <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-4">
              <span class="text-[11px] font-bold text-[#e2c974] uppercase tracking-wider">
                Doc {idx < 9 ? `0${idx + 1}` : idx + 1} · {categoryLabels[doc.data.category] || doc.data.category}
              </span>
              {doc.data.metric && (
                <span class="text-[10px] font-mono text-[#38bdf8] uppercase px-2 py-0.5 rounded bg-white/[0.04] border border-white/5">
                  {doc.data.metric}
                </span>
              )}
            </div>

            <h2 class="text-lg font-bold text-[#f8fafc] uppercase group-hover:text-[#e2c974] transition mb-2.5 leading-snug">
              <a href={`${baseUrl}blog/${doc.id.replace(/^en\//, '')}/`}>
                {doc.data.title}
              </a>
            </h2>

            <p class="text-xs text-[#94a3b8] leading-relaxed mb-5 line-clamp-3">
              {doc.data.description}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-5">
              {doc.data.technologies.slice(0, 4).map((t) => (
                <span class="text-[10px] px-2 py-0.5 rounded-md bg-white/[0.03] border border-white/10 text-[#38bdf8]">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-white/10 flex justify-between items-center text-xs">
            <span class="text-[11px] text-[#94a3b8] uppercase font-mono">
              {doc.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
            </span>
            <a
              href={`${baseUrl}blog/${doc.id.replace(/^en\//, '')}/`}
              class="font-bold text-[#06b6d4] uppercase group-hover:underline flex items-center gap-1.5 transition-colors"
            >
              Read Dossier &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.cat-filter-btn');
      const cards = document.querySelectorAll('.article-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedCat = btn.getAttribute('data-category');

          filterBtns.forEach(b => {
            b.classList.remove('bg-[#06b6d4]/20', 'border-[#06b6d4]/40', 'text-[#38bdf8]');
            b.classList.add('bg-white/[0.03]', 'border-white/10', 'text-[#94a3b8]');
          });
          btn.classList.add('bg-[#06b6d4]/20', 'border-[#06b6d4]/40', 'text-[#38bdf8]');
          btn.classList.remove('bg-white/[0.03]', 'border-white/10', 'text-[#94a3b8]');

          cards.forEach(card => {
            const cardCat = card.getAttribute('data-cat');
            if (selectedCat === 'all' || cardCat === selectedCat) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</Layout>
