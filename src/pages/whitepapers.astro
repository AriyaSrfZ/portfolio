---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allPosts = await getCollection('blog');
const whitepapers = allPosts
  .filter((post) => (post.data.lang === 'en' || post.id.startsWith('en/')) && post.data.technologies.includes('Whitepaper'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Engineering Whitepaper Suite — Ariya Sarrafzadeh" description="High-throughput switches, telecom aggregator mechanics, perimeter fraud defense, and distributed ledgers.">
  <main class="max-w-[1400px] mx-auto px-6 pt-28 pb-20 font-['IBM_Plex_Mono',monospace]">
    <div class="relative bg-[#1c1916] border border-[#5c6650] p-6 sm:p-10 mb-10 shadow-2xl rounded-none">
      <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
      <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
      <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
      <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs text-[#c4562e] tracking-wider font-semibold uppercase">SPEC.SUITE // TECHNICAL INTELLIGENCE</span>
        <div class="h-px flex-1 bg-[#5c6650]"></div>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold uppercase text-[#e8e2d5] mb-4">
        Engineering Whitepaper Suite
      </h1>
      <p class="text-[#a8a196] text-xs sm:text-sm leading-relaxed max-w-3xl">
        Rigorous engineering reference specifications analyzing financial transaction routing, national telecom switching, fraud perimeter isolation, and cryptographic state transitions.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {whitepapers.map((doc, idx) => (
        <article class="relative bg-[#1c1916] border border-[#5c6650] p-6 flex flex-col justify-between rounded-none group hover:border-[#c4562e] transition">
          <span class="absolute -top-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -top-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -left-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>
          <span class="absolute -bottom-[3px] -right-[3px] w-[6px] h-[6px] bg-[#141210] border border-[#5c6650] pointer-events-none"></span>

          <div>
            <div class="flex items-center justify-between border-b border-[#5c6650]/40 pb-2 mb-3">
              <span class="text-[10px] font-bold text-[#c9a15a] uppercase tracking-widest">
                SPEC 0{idx + 1} // {doc.data.category}
              </span>
              {doc.data.metric && (
                <span class="text-[9px] font-mono text-[#c9d4a8] uppercase">
                  {doc.data.metric}
                </span>
              )}
            </div>

            <h2 class="text-base sm:text-lg font-bold text-[#e8e2d5] uppercase group-hover:text-[#c9a15a] transition mb-2">
              <a href={`${baseUrl}blog/${doc.id.replace(/^en\//, '')}/`}>
                {doc.data.title}
              </a>
            </h2>

            <p class="text-xs text-[#a8a196] leading-relaxed mb-4">
              {doc.data.description}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              {doc.data.technologies.map((t) => (
                <span class="text-[10px] px-2 py-0.5 bg-[#141210] border border-[#5c6650]/60 text-[#a8a196]">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-[#5c6650]/40 flex justify-between items-center">
            <span class="text-[10px] text-[#5c6650] uppercase font-mono">
              {doc.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
            </span>
            <a
              href={`${baseUrl}blog/${doc.id.replace(/^en\//, '')}/`}
              class="text-xs font-bold text-[#c4562e] uppercase group-hover:underline flex items-center gap-1"
            >
              Read Specification &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
