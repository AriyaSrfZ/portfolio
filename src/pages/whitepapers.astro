---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { stats } from '../data/stats';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allPosts = await getCollection('blog');
const whitepapers = allPosts
  .filter((post) => post.data.lang === 'en' || post.id.startsWith('en/'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 4 Core Architectural Dossiers
const primaryDossiers = [
  {
    num: "01",
    tag: "LEDGERS & ACID",
    title: "Payment Gateway Architecture: High-Throughput Switches & Distributed Ledgers",
    slug: "payment-gateway",
    metric: stats.ledgerPeakTps.en,
    spec: "Two-Phase Balance Reservation (AVAILABLE ➔ RESERVED), ScyllaDB + Postgres ACID Ledgers, and Redis SETNX mutex locks with zero financial drift.",
    chips: ["ISO 8583", "2PC RESERVATION", "REDIS SETNX", "SCYLLADB", "ACID"],
  },
  {
    num: "02",
    tag: "PSP ROUTING & SWITCH",
    title: "National Telecom SMS Switching & Aggregator Infrastructure",
    slug: "sms-infrastructure",
    metric: stats.telecomHubAnnualVolume.badgeEn,
    spec: `Carrier-level SMPP 3.4 sliding-window throttling (${stats.incident02SlidingWindow.en}), multi-tier queue isolation for banking OTPs, and ${stats.switchFailoverSla.textEn} automated gateway failovers.`,
    chips: ["SMPP 3.4", "ISO 8583", "SLIDING WINDOW", "QUEUE ISOLATION", stats.switchFailoverSla.en.toUpperCase()],
  },
  {
    num: "03",
    tag: "SECURITY & EKYC",
    title: "Forensic Fraud Mitigation: Edge Telemetry, 3DS 2.0 & Risk Graphs",
    slug: "fraud-tracing",
    metric: stats.fraudRiskLoopSla.shortEn,
    spec: "Central Bank 4-parameter Harim dynamic OTP, national Shahkar & Sabt-Ahval identity verification, and zero-storage CVV2/PIN token vault topology.",
    chips: ["PCI-DSS", "HARIM OTP", "SHAHKAR eKYC", "NEO4J", "3DS 2.0"],
  },
  {
    num: "04",
    tag: "EVENT-DRIVEN CLEARING",
    title: "Migrating a Monolithic Payments Flow to Event-Driven Architecture",
    slug: "event-driven-migration",
    metric: stats.incidentFinancialDrift.badgeEn.toUpperCase(),
    spec: "RabbitMQ activity.end_state event mesh, Spring Batch nightly multi-pass reconciliation workers, and automated Paya/Satna clearing payouts.",
    chips: ["RABBITMQ", "SPRING BATCH", "REFUND-MNG", "PAYA / SATNA", "EARLY PAYOUT"],
  },
];
---

<Layout 
  title="Engineering Whitepaper Suite — Ariya Sarrafzadeh" 
  description="Production dossiers on ISO 8583 payment switches, double-entry ledgers, telecom aggregation, and automated reconciliation."
>
  <main class="max-w-[1400px] mx-auto px-6 pt-24 pb-20 font-sans">
    
    <!-- Header -->
    <div class="bg-[var(--surface-card)] backdrop-blur-xl border border-[var(--border)] rounded-2xl p-6 sm:p-8 mb-8 shadow-2xl">
      <div class="flex items-center gap-2 mb-2 font-mono text-[11px] text-[var(--text-secondary)] uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-warm)]"></span>
        <span>PRODUCTION SPECIFICATIONS · TECHNICAL INTELLIGENCE</span>
        <div class="h-px flex-1 bg-[var(--border)]"></div>
        <span class="text-[10px] text-[var(--text-muted)] font-mono">14 DOSSIERS</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold uppercase text-[var(--text-primary)] mb-3 tracking-tight">
        Engineering Whitepaper Suite
      </h1>
      <p class="text-[var(--text-secondary)] text-xs sm:text-sm leading-relaxed max-w-3xl">
        Rigorous engineering reference specifications analyzing financial transaction routing, national telecom switching, fraud perimeter isolation, and cryptographic state transitions.
      </p>
    </div>

    <!-- 4 Core Featured Blueprint Dossiers -->
    <div class="mb-10 space-y-3">
      <div class="text-[11px] font-mono text-[var(--text-secondary)] uppercase tracking-wider flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)]"></span>
        <span>CORE ARCHITECTURAL DOSSIERS (MISSION-CRITICAL)</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {primaryDossiers.map((item) => (
          <article class="bg-[var(--surface-card)] border border-[var(--border)] rounded-xl p-5 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all duration-200 group">
            <div>
              <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-[var(--border)] font-mono text-[10px]">
                <span class="text-[var(--text-primary)] font-semibold tracking-wider">
                  SPEC {item.num} · {item.tag}
                </span>
                <span class="text-[var(--accent-primary)] px-2 py-0.5 rounded bg-[var(--surface-sunken)] border border-[var(--border)]">
                  {item.metric}
                </span>
              </div>

              <h2 class="text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors mb-2 leading-snug">
                <a href={`${baseUrl}blog/${item.slug}/`}>
                  {item.title}
                </a>
              </h2>

              <p class="text-xs text-[var(--text-secondary)] leading-relaxed mb-4">
                {item.spec}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-4">
                {item.chips.map((chip) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[var(--surface-sunken)] border border-[var(--border)] text-[var(--text-secondary)]">
                    [{chip}]
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-3 border-t border-[var(--border)] flex justify-between items-center text-xs font-mono">
              <span class="text-[10px] text-[var(--text-muted)] uppercase">ACID VERIFIED</span>
              <a
                href={`${baseUrl}blog/${item.slug}/`}
                class="font-semibold text-[var(--text-primary)] hover:text-[var(--accent-primary)] flex items-center gap-1 group-hover:translate-x-0.5 transition-all"
              >
                Inspect Specification &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Complete Specification Library -->
    <div class="space-y-3">
      <div class="text-[11px] font-mono text-[var(--text-secondary)] uppercase tracking-wider flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-warm)]"></span>
        <span>ALL FIELD NOTES &amp; ARCHITECTURAL SPECIFICATIONS ({whitepapers.length})</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {whitepapers.map((doc, idx) => (
          <article class="bg-[var(--surface-card)] border border-[var(--border)] rounded-xl p-4 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all group">
            <div>
              <div class="flex items-center justify-between border-b border-[var(--border)] pb-2 mb-3 font-mono text-[10px]">
                <span class="text-[var(--text-secondary)] uppercase">
                  SPEC {idx < 9 ? `0${idx + 1}` : idx + 1} · {doc.data.category}
                </span>
                {doc.data.metric && (
                  <span class="text-[var(--text-primary)] px-1.5 py-0.5 rounded bg-[var(--surface-sunken)] border border-[var(--border)]">
                    {doc.data.metric}
                  </span>
                )}
              </div>

              <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors mb-2 leading-snug">
                <a href={`${baseUrl}blog/${doc.id.replace(/^en\//, '')}/`}>
                  {doc.data.title}
                </a>
              </h3>

              <p class="text-xs text-[var(--text-secondary)] leading-relaxed mb-4 line-clamp-2">
                {doc.data.description}
              </p>
            </div>

            <div class="pt-3 border-t border-[var(--border)] flex justify-between items-center text-[11px] font-mono">
              <span class="text-[var(--text-muted)]">
                {doc.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
              </span>
              <a
                href={`${baseUrl}blog/${doc.id.replace(/^en\//, '')}/`}
                class="text-[var(--text-primary)] hover:text-[var(--accent-primary)] flex items-center gap-1 font-medium"
              >
                Read &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>
