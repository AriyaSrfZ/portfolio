---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const caseStudies = [
  {
    id: '01',
    category: 'Settlements & Ledgers',
    title: 'The Double-Entry Ledger & Two-Phase Balance Reservation',
    summary: 'Single source of financial truth with ACID compliance, two-phase balance reservation (AVAILABLE to RESERVED), and mathematical debit/credit balancing.',
    problem: 'Inconsistent ledger states and ghost balances during high-concurrency wallet checkouts threatened regulatory standing.',
    decision: 'Enforced strict synchronous two-phase balance reservation and atomic Redis SETNX mutex locks recording into an immutable Double-Entry ACID Ledger in ScyllaDB.',
    tradeoff: 'Enforced strict synchronous two-phase balance reservation over raw optimistic write throughput.',
    outcome: 'Maintained 100% mathematical ledger parity across 50,000+ daily transactions with zero duplicate payouts.',
    link: `${baseUrl}blog/payment-gateway/`,
    badge: 'Zero Financial Drift',
    tags: ['Double-Entry Ledger', 'Two-Phase Reservation', 'ACID Compliance', 'Redis SETNX Idempotency', 'ScyllaDB Fact Store']
  },
  {
    id: '02',
    category: 'Risk & eKYC',
    title: 'eKYC, Central Bank Harim OTP & PCI-DSS Token Vault',
    summary: 'Sub-15ms risk engine evaluating transactional anomalies, zero-storage CVV2 vault isolation, and Central Bank 4-parameter Harim dynamic OTP.',
    problem: 'Static rules caused high false positives and fraudsters exploited SIM-swap delays to bypass legacy OTPs.',
    decision: 'Deployed isolated PCI-DSS Token Vault for sensitive card tokens, integrated national eKYC (Shahkar/Sabt-Ahval), and 3DS 2.0 biometric liability shifting.',
    tradeoff: 'Refused to cache CVV2 credentials for one-click checkout convenience, enforcing strict zero-storage PCI-DSS tokenization.',
    outcome: 'Slashed illicit drain by 94 percent and maintained a frictionless pass rate above 92 percent in 3DS 2.0.',
    link: `${baseUrl}blog/fraud-tracing/`,
    badge: 'Sub-15ms SLA',
    tags: ['Zero-Storage CVV2 Vault', 'Harim Dynamic OTP', 'Shahkar National eKYC', 'PCI-DSS Compliance', 'Neo4j Graph Forensics']
  },
  {
    id: '03',
    category: 'Payment Switch',
    title: 'Smart PSP Switch & Dynamic Weighted Routing',
    summary: 'Enterprise Head-to-Head (H2H) switch unpacking ISO 8583 MTI 0200/0210 financial telegrams with sub-30ms automated failover across SEP, PEC, BPM, and PEP.',
    problem: 'Single-PSP vendor lock-in created massive checkout drop-offs during bank maintenance windows and national clearing congestion.',
    decision: 'Engineered Switch-PSP with dynamic weighted routing based on real-time success rates, fee tiers, and rolling P99 latency, integrating Faravaran Hub adapters.',
    tradeoff: 'Built an agnostic multi-PSP switch topology with dynamic weight allocation rather than relying on a single PSP relationship.',
    outcome: 'Achieved 99.99% gateway availability, sub-250ms roundtrip checkout latency, and 30ms automated failover during upstream provider outages.',
    link: `${baseUrl}blog/sms-infrastructure/`,
    badge: 'Sub-30ms Failover',
    tags: ['Smart PSP Switch', 'Dynamic Weighted Routing', 'Faravaran Hub Integration', 'ISO 8583 H2H Pipeline', 'Sub-30ms Failover SLA']
  },
  {
    id: '04',
    category: 'Reconciliation & Payouts',
    title: 'Event-Driven Multi-Pass Reconciliation & Early Merchant Settlement',
    summary: 'Nightly Spring Batch 3-way reconciliation engine cross-referencing internal ledgers against bank clearing files, with auto-healing Refund-MNG and 24h payout batching.',
    problem: 'Manual reconciliation delayed merchant payouts to 48h+, causing severe cash-flow friction for enterprise merchants.',
    decision: 'Built an asynchronous multi-pass reconciliation engine over RabbitMQ activity queues, integrated automated bank SFTP pipelines, and launched 24h early merchant settlements.',
    tradeoff: 'Shifted from synchronous reconciliation to an asynchronous multi-pass state machine backed by automated bank SFTP pipelines.',
    outcome: 'Launched 24h early merchant settlement with automated daily floating fee collection, eliminating 100% of manual reconciliation overhead.',
    link: `${baseUrl}data-cleaning/`,
    badge: '24h Early Settlement',
    tags: ['Spring Batch Reconciler', 'Auto-Healing Refund-MNG', 'RabbitMQ Event Mesh', 'Paya/Satna Bank-Proxy', 'Early Merchant Settlement']
  },
];
---

<Layout
  title="Case Studies & Engineering Initiatives — Ariya Sarrafzadeh"
  description="High-throughput, mission-critical infrastructure under real regulatory, operational, and scale constraints."
>
  <main class="max-w-[1400px] mx-auto px-6 pt-32 pb-24 font-sans">
    
    <!-- Hero / Header Banner -->
    <div class="bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-10 mb-10 shadow-2xl ring-1 ring-white/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs text-[#06b6d4] tracking-wider font-semibold uppercase font-mono">SELECTED WORK · ENGINEERING CASE STUDIES</span>
        <div class="h-px flex-1 bg-white/10"></div>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold uppercase text-[#f8fafc] mb-4 tracking-tight">
        Systems Architecture &amp; Case Studies
      </h1>
      <p class="text-[#94a3b8] text-sm sm:text-base leading-relaxed max-w-3xl">
        High-throughput, mission-critical infrastructure engineered under strict regulatory compliance, tight operational tolerances, and national-scale concurrency constraints.
      </p>
    </div>

    <!-- 4 Case Study Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {caseStudies.map((study) => (
        <article class="bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-8 flex flex-col justify-between shadow-xl ring-1 ring-white/5 group hover:border-[#06b6d4]/40 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl">
          <div>
            <!-- Top Tag & Badge -->
            <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-5">
              <span class="text-[11px] font-bold text-[#e2c974] uppercase tracking-wider font-mono">
                Initiative {study.id} · {study.category}
              </span>
              <span class="text-[10px] font-mono text-[#38bdf8] uppercase px-2.5 py-0.5 rounded bg-white/[0.04] border border-white/5">
                {study.badge}
              </span>
            </div>

            <!-- Title & One-Line Summary -->
            <h2 class="text-xl font-bold text-[#f8fafc] uppercase tracking-tight mb-3 group-hover:text-[#e2c974] transition-colors">
              <a href={study.link}>
                {study.title}
              </a>
            </h2>

            <p class="text-xs sm:text-sm text-[#cbd5e1] leading-relaxed mb-6">
              {study.summary}
            </p>

            <!-- Structured Quadrant: Problem, Decision, Tradeoff, Outcome -->
            <div class="p-4 bg-[#141210]/60 backdrop-blur-md border border-white/10 rounded-xl text-xs space-y-3 mb-6">
              <div class="flex items-center justify-between pb-1 border-b border-white/5">
                <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#38bdf8]">Core Engineering Breakdown</span>
                <span class="text-[10px] text-[#06b6d4] font-mono uppercase px-2 py-0.5 rounded bg-[#06b6d4]/10 border border-[#06b6d4]/20">Production Verified</span>
              </div>
              
              <div class="space-y-2 text-[#94a3b8] leading-relaxed">
                <div>
                  <strong class="text-[#f8fafc] font-medium block text-[11px] uppercase tracking-wide text-white/90">The problem:</strong>
                  <span class="text-[#cbd5e1]">{study.problem}</span>
                </div>
                <div>
                  <strong class="text-[#f8fafc] font-medium block text-[11px] uppercase tracking-wide text-white/90">The decision:</strong>
                  <span class="text-[#cbd5e1]">{study.decision}</span>
                </div>
                <div>
                  <strong class="text-[#f8fafc] font-medium block text-[11px] uppercase tracking-wide text-white/90">The tradeoff:</strong>
                  <span class="text-[#cbd5e1]">{study.tradeoff}</span>
                </div>
                <div>
                  <strong class="text-[#f8fafc] font-medium block text-[11px] uppercase tracking-wide text-white/90">The outcome:</strong>
                  <span class="text-[#cbd5e1]">{study.outcome}</span>
                </div>
              </div>
            </div>

            <!-- Tactical Tags -->
            <div class="flex flex-wrap gap-2 mb-6">
              {study.tags.map(tag => (
                <span class="px-3 py-1 bg-white/[0.03] border border-white/10 rounded-lg text-[#38bdf8] text-[11px] font-mono font-medium hover:bg-white/[0.07] transition-colors">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Action -->
          <div class="pt-4 border-t border-white/10 flex justify-between items-center text-xs">
            <span class="text-[11px] text-[#94a3b8] font-mono uppercase">Full Technical Dossier</span>
            <a
              href={study.link}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.03] border border-white/10 text-[#06b6d4] font-bold uppercase transition-all duration-300 active:scale-[0.98] hover:-translate-y-1 hover:shadow-2xl hover:border-[#06b6d4]/40 hover:bg-[#06b6d4]/10 focus-visible:outline-2 focus-visible:outline-[#06b6d4]"
            >
              Read technical dossier &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Whitepapers Note Banner -->
    <div class="mt-12 p-6 bg-[#141210]/40 backdrop-blur-md border border-white/10 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-start gap-3">
        <span class="w-2 h-2 rounded-full bg-[#06b6d4] mt-1.5 shrink-0"></span>
        <p class="text-xs sm:text-sm text-[#94a3b8] leading-relaxed">
          For architectural deep-dives with sequence diagrams, network topologies, and schema definitions, explore the
          <a href={`${baseUrl}whitepapers/`} class="text-[#38bdf8] font-semibold underline decoration-dotted underline-offset-4 hover:text-[#06b6d4] transition-colors ml-1">
            Whitepapers &amp; Engineering Specifications index
          </a>.
        </p>
      </div>
      <a
        href={`${baseUrl}whitepapers/`}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white/[0.04] border border-white/10 text-xs font-mono font-medium text-[#f8fafc] transition-all duration-300 active:scale-[0.98] hover:-translate-y-1 hover:shadow-2xl hover:border-[#06b6d4]/40 hover:bg-white/[0.08] shrink-0 self-start sm:self-auto"
      >
        <span>View All Whitepapers</span>
        <span>&rarr;</span>
      </a>
    </div>

  </main>
</Layout>
