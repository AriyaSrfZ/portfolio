---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const caseStudies = [
  {
    id: '01',
    category: 'Settlements & Ledgers',
    title: 'The Double-Entry Ledger & Two-Phase Balance Reservation',
    summary: 'Single source of financial truth with ACID compliance, two-phase balance reservation (AVAILABLE to RESERVED), and mathematical debit/credit balancing.',
    problem: 'Inconsistent ledger states and ghost balances during high-concurrency wallet checkouts threatened regulatory standing.',
    decision: 'Enforced strict synchronous two-phase balance reservation and atomic Redis SETNX mutex locks recording into an immutable Double-Entry ACID Ledger in ScyllaDB.',
    tradeoff: 'Enforced strict synchronous two-phase balance reservation over raw optimistic write throughput.',
    outcome: 'Maintained 100% mathematical ledger parity across 50,000+ daily transactions with zero duplicate payouts.',
    link: `${baseUrl}blog/payment-gateway/`,
    badge: 'Zero Financial Drift',
    tags: ['Double-Entry Ledger', 'Two-Phase Reservation', 'ACID Compliance', 'Redis SETNX Idempotency', 'ScyllaDB Fact Store']
  },
  {
    id: '02',
    category: 'Risk & eKYC',
    title: 'eKYC, Central Bank Harim OTP & PCI-DSS Token Vault',
    summary: 'Sub-15ms risk engine evaluating transactional anomalies, zero-storage CVV2 vault isolation, and Central Bank 4-parameter Harim dynamic OTP.',
    problem: 'Static rules caused high false positives and fraudsters exploited SIM-swap delays to bypass legacy OTPs.',
    decision: 'Deployed isolated PCI-DSS Token Vault for sensitive card tokens, integrated national eKYC (Shahkar/Sabt-Ahval), and 3DS 2.0 biometric liability shifting.',
    tradeoff: 'Refused to cache CVV2 credentials for one-click checkout convenience, enforcing strict zero-storage PCI-DSS tokenization.',
    outcome: 'Slashed illicit drain by 94 percent and maintained a frictionless pass rate above 92 percent in 3DS 2.0.',
    link: `${baseUrl}blog/fraud-tracing/`,
    badge: 'Sub-15ms SLA',
    tags: ['Zero-Storage CVV2 Vault', 'Harim Dynamic OTP', 'Shahkar National eKYC', 'PCI-DSS Compliance', 'Neo4j Graph Forensics']
  },
  {
    id: '03',
    category: 'Payment Switch',
    title: 'Smart PSP Switch & Dynamic Weighted Routing',
    summary: 'Enterprise Head-to-Head (H2H) switch unpacking ISO 8583 MTI 0200/0210 financial telegrams with sub-30ms automated failover across SEP, PEC, BPM, and PEP.',
    problem: 'Single-PSP vendor lock-in created massive checkout drop-offs during bank maintenance windows and national clearing congestion.',
    decision: 'Engineered Switch-PSP with dynamic weighted routing based on real-time success rates, fee tiers, and rolling P99 latency, integrating Faravaran Hub adapters.',
    tradeoff: 'Built an agnostic multi-PSP switch topology with dynamic weight allocation rather than relying on a single PSP relationship.',
    outcome: 'Achieved 99.99% gateway availability, sub-250ms roundtrip checkout latency, and 30ms automated failover during upstream provider outages.',
    link: `${baseUrl}blog/sms-infrastructure/`,
    badge: 'Sub-30ms Failover',
    tags: ['Smart PSP Switch', 'Dynamic Weighted Routing', 'Faravaran Hub Integration', 'ISO 8583 H2H Pipeline', 'Sub-30ms Failover SLA']
  },
  {
    id: '04',
    category: 'Reconciliation & Payouts',
    title: 'Event-Driven Multi-Pass Reconciliation & Early Merchant Settlement',
    summary: 'Nightly Spring Batch 3-way reconciliation engine cross-referencing internal ledgers against bank clearing files, with auto-healing Refund-MNG and 24h payout batching.',
    problem: 'Manual reconciliation delayed merchant payouts to 48h+, causing severe cash-flow friction for enterprise merchants.',
    decision: 'Built an asynchronous multi-pass reconciliation engine over RabbitMQ activity queues, integrated automated bank SFTP pipelines, and launched 24h early merchant settlements.',
    tradeoff: 'Shifted from synchronous reconciliation to an asynchronous multi-pass state machine backed by automated bank SFTP pipelines.',
    outcome: 'Launched 24h early merchant settlement with automated daily floating fee collection, eliminating 100% of manual reconciliation overhead.',
    link: `${baseUrl}data-cleaning/`,
    badge: '24h Early Settlement',
    tags: ['Spring Batch Reconciler', 'Auto-Healing Refund-MNG', 'RabbitMQ Event Mesh', 'Paya/Satna Bank-Proxy', 'Early Merchant Settlement']
  },
];
---

<Layout
  title="Case Studies & Engineering Initiatives — Ariya Sarrafzadeh"
  description="High-throughput, mission-critical infrastructure under real regulatory, operational, and scale constraints."
>
  <main class="max-w-[1400px] mx-auto px-6 pt-24 pb-20 font-sans">
    
    <!-- Hero / Header Banner -->
    <div class="bg-[#111317]/85 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sm:p-8 mb-8 shadow-2xl ring-1 ring-white/[0.03]">
      <div class="flex items-center gap-2 mb-2 font-mono text-[11px] text-[#94a3b8] uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
        <span>PRODUCTION INITIATIVES · ARCHITECTURAL DOSSIERS</span>
        <div class="h-px flex-1 bg-white/[0.06]"></div>
        <span class="text-[10px] text-neutral-500 font-mono">4 CASE STUDIES</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold uppercase text-[#ededed] mb-3 tracking-tight">
        Systems Architecture &amp; Case Studies
      </h1>
      <p class="text-[#94a3b8] text-xs sm:text-sm leading-relaxed max-w-3xl">
        High-throughput, mission-critical infrastructure engineered under strict regulatory compliance, tight operational tolerances, and national-scale concurrency constraints.
      </p>
    </div>

    <!-- 4 Case Study Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {caseStudies.map((study) => (
        <article class="bg-[#111317]/90 border border-white/[0.07] rounded-xl p-6 flex flex-col justify-between hover:border-white/20 transition-all duration-200 group">
          <div>
            <!-- Top Tag & Badge -->
            <div class="flex items-center justify-between border-b border-white/[0.06] pb-2.5 mb-4">
              <span class="text-[10px] font-bold text-neutral-300 uppercase tracking-wider font-mono">
                Initiative {study.id} · {study.category}
              </span>
              <span class="text-[10px] font-mono text-[#10b981] uppercase px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06]">
                {study.badge}
              </span>
            </div>

            <!-- Title & One-Line Summary -->
            <h2 class="text-lg font-bold text-[#ededed] uppercase tracking-tight mb-2 group-hover:text-white transition-colors">
              <a href={study.link}>
                {study.title}
              </a>
            </h2>
            <p class="text-xs text-[#94a3b8] leading-relaxed mb-4">
              {study.summary}
            </p>

            <!-- Technical Detail Box -->
            <div class="bg-[#090a0c]/80 border border-white/[0.06] rounded-lg p-3.5 space-y-2 mb-4 text-xs">
              <div>
                <span class="text-[10px] font-mono font-semibold text-neutral-400 uppercase tracking-wider">The Problem:</span>
                <p class="text-[#94a3b8] text-[11px] mt-0.5 leading-relaxed">{study.problem}</p>
              </div>
              <div class="border-t border-white/[0.05] pt-1.5">
                <span class="text-[10px] font-mono font-semibold text-neutral-300 uppercase tracking-wider">The Decision:</span>
                <p class="text-[#ededed] text-[11px] mt-0.5 leading-relaxed">{study.decision}</p>
              </div>
              <div class="border-t border-white/[0.05] pt-1.5">
                <span class="text-[10px] font-mono font-semibold text-neutral-400 uppercase tracking-wider">Tradeoff:</span>
                <p class="text-[#94a3b8] text-[11px] mt-0.5 leading-relaxed">{study.tradeoff}</p>
              </div>
              <div class="border-t border-white/[0.05] pt-1.5">
                <span class="text-[10px] font-mono font-semibold text-[#10b981] uppercase tracking-wider">Business Outcome:</span>
                <p class="text-[#10b981] text-[11px] mt-0.5 leading-relaxed">{study.outcome}</p>
              </div>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {study.tags.map((tag) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-400">
                  [{tag}]
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Action Link -->
          <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono">
            <span class="text-[10px] text-neutral-500 uppercase">CASE DOSSIER</span>
            <a
              href={study.link}
              class="font-semibold text-[#ededed] hover:text-white uppercase inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            >
              <span>Inspect Architecture Dossier</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
